<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — BizFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --sidebar-w: 248px;
      --topbar-h: 56px;

      /* Orange accent */
      --primary:        #f97316;
      --primary-dark:   #ea580c;
      --primary-light:  #fb923c;
      --primary-dim:    rgba(249,115,22,0.08);
      --primary-border: rgba(249,115,22,0.2);

      /* Semantic */
      --success:      #16a34a;
      --success-dim:  rgba(22,163,74,0.08);
      --danger:       #dc2626;
      --danger-dim:   rgba(220,38,38,0.08);
      --warning:      #d97706;
      --warning-dim:  rgba(217,119,6,0.08);
      --info:         #2563eb;
      --info-dim:     rgba(37,99,235,0.08);

      /* Light surface */
      --bg:        #f4f4f5;
      --surface:   #ffffff;
      --surface-2: #fafafa;
      --surface-3: #f4f4f5;

      /* Text (zinc scale) */
      --text:   #09090b;
      --text-2: #27272a;
      --text-3: #52525b;
      --text-4: #a1a1aa;

      /* Borders */
      --border:   #e4e4e7;
      --border-2: #f4f4f5;

      /* Shadows — lighter for white background */
      --shadow-xs: 0 1px 2px rgba(0,0,0,0.05);
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow:    0 4px 6px rgba(0,0,0,0.05), 0 2px 4px rgba(0,0,0,0.04);
      --shadow-md: 0 10px 15px rgba(0,0,0,0.07), 0 4px 6px rgba(0,0,0,0.04);
      --shadow-primary: 0 4px 14px rgba(249,115,22,0.28);

      /* Radii — Shadcn default 8px */
      --radius-xs:   4px;
      --radius-sm:   8px;
      --radius:      10px;
      --radius-lg:   12px;
      --radius-xl:   16px;
      --radius-full: 9999px;

      /* Sidebar dark palette */
      --sb-bg:      #18181b;
      --sb-surface: #27272a;
      --sb-border:  #3f3f46;
      --sb-text:    #a1a1aa;
      --sb-text-2:  #e4e4e7;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-weight: 400;
      font-size: 14.5px;
      line-height: 1.6;
      background: var(--bg);
      display: flex;
      min-height: 100vh;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    /* ══════════════════════════════════════
       SIDEBAR  — dark panel
    ══════════════════════════════════════ */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--sb-bg);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 0; top: 0; bottom: 0;
      z-index: 200;
      border-right: 1px solid var(--sb-border);
      transition: transform 0.26s cubic-bezier(0.4,0,0.2,1);
    }

    .sidebar-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(2px);
      z-index: 190;
      opacity: 0;
      transition: opacity 0.26s ease;
    }
    .sidebar-overlay.active { opacity: 1; }

    /* Logo */
    .sidebar-logo {
      padding: 0 16px;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--sb-border);
      flex-shrink: 0;
    }
    .logo-mark {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--primary-dark), var(--primary-light));
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 16px; font-weight: 800;
      color: #fff;
      flex-shrink: 0;
    }
    .logo-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 16px; font-weight: 700;
      color: #f4f4f5;
      letter-spacing: -0.3px;
      flex: 1;
    }
    .logo-text span { color: var(--primary); }

    .sidebar-close {
      display: none;
      width: 30px; height: 30px;
      background: var(--sb-surface);
      border: 1px solid var(--sb-border);
      border-radius: 6px;
      color: var(--sb-text);
      cursor: pointer;
      align-items: center; justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
      transition: all 0.15s;
    }
    .sidebar-close:hover { color: #f87171; border-color: rgba(239,68,68,0.4); }

    /* Nav */
    .sidebar-nav { flex: 1; padding: 8px; overflow-y: auto; }
    .nav-section { margin-bottom: 2px; }
    .nav-section-label {
      font-size: 10px; font-weight: 600;
      letter-spacing: 1px; text-transform: uppercase;
      color: #52525b;
      padding: 14px 10px 5px;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .nav-item {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 13.5px; font-weight: 500;
      color: var(--sb-text);
      transition: all 0.15s;
      margin-bottom: 1px;
    }
    .nav-item:hover { background: var(--sb-surface); color: var(--sb-text-2); }
    .nav-item.active {
      background: rgba(249,115,22,0.15);
      color: var(--primary-light);
      font-weight: 600;
    }
    .nav-icon { font-size: 14px; width: 18px; text-align: center; flex-shrink: 0; }

    /* Footer */
    .sidebar-footer {
      padding: 12px;
      border-top: 1px solid var(--sb-border);
      flex-shrink: 0;
    }
    .user-card { display: flex; align-items: center; gap: 9px; padding: 8px; border-radius: var(--radius-sm); }
    .user-card:hover { background: var(--sb-surface); }
    .user-avatar {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: #fff;
      flex-shrink: 0;
    }
    .user-info { flex: 1; min-width: 0; }
    .user-name { font-size: 13px; font-weight: 600; color: var(--sb-text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .user-role { font-size: 11px; color: #52525b; margin-top: 1px; }
    .btn-logout {
      width: 28px; height: 28px;
      background: none; border: 1px solid var(--sb-border);
      border-radius: 50%; color: var(--sb-text);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      font-size: 13px; text-decoration: none; transition: all 0.15s; flex-shrink: 0;
    }
    .btn-logout:hover { border-color: #f87171; color: #f87171; background: rgba(220,38,38,0.08); }

    /* ══════════════════════════════════════
       MAIN CONTENT
    ══════════════════════════════════════ */
    .main-content {
      margin-left: var(--sidebar-w);
      flex: 1; display: flex; flex-direction: column;
      min-height: 100vh; min-width: 0;
    }

    /* ── Topbar ── */
    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
      height: var(--topbar-h);
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100; gap: 12px;
    }
    .topbar-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .hamburger {
      display: none;
      width: 36px; height: 36px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text-3);
      cursor: pointer; align-items: center; justify-content: center;
      font-size: 17px; flex-shrink: 0; transition: all 0.15s;
    }
    .hamburger:hover { border-color: var(--primary-border); color: var(--primary); }
    .topbar-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; font-weight: 600;
      color: var(--text-2);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .topbar-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .topbar-date {
      font-size: 12px; color: var(--text-4);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      padding: 4px 12px; white-space: nowrap;
    }

    .page-body { padding: 24px; flex: 1; }

    /* ══════════════════════════════════════
       BUTTONS  — Shadcn style
    ══════════════════════════════════════ */
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 13.5px; font-weight: 500;
      cursor: pointer; transition: all 0.15s;
      border: 1px solid transparent;
      text-decoration: none; white-space: nowrap;
      line-height: 1.4; letter-spacing: 0;
    }
    .btn-primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary-dark);
    }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-secondary {
      background: var(--surface);
      color: var(--text-2);
      border-color: var(--border);
      box-shadow: var(--shadow-xs);
    }
    .btn-secondary:hover { background: var(--surface-2); border-color: #d4d4d8; }
    .btn-danger { background: var(--danger-dim); color: var(--danger); border-color: rgba(220,38,38,0.2); }
    .btn-danger:hover { background: var(--danger); color: #fff; border-color: var(--danger); }
    .btn-success { background: var(--success-dim); color: var(--success); border-color: rgba(22,163,74,0.2); }
    .btn-success:hover { background: var(--success); color: #fff; border-color: var(--success); }
    .btn-warning { background: var(--warning-dim); color: var(--warning); border-color: rgba(217,119,6,0.2); }
    .btn-accent { background: #000; color: #fff; border-color: #000; }
    .btn-accent:hover { background: #27272a; }
    .btn-sm  { padding: 5px 12px; font-size: 12.5px; }
    .btn-xs  { padding: 3px 9px;  font-size: 11.5px; }
    .btn:active { opacity: 0.85; transform: translateY(1px); }

    /* ══════════════════════════════════════
       CARDS  — white with border
    ══════════════════════════════════════ */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }
    .card-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }
    .card-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 13.5px; font-weight: 700; color: var(--text);
    }
    .card-body { padding: 18px; }

    /* ══════════════════════════════════════
       TABLE
    ══════════════════════════════════════ */
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius-lg); }
    .data-table { width: 100%; border-collapse: collapse; min-width: 500px; }
    .data-table th {
      padding: 10px 14px;
      font-size: 11px; font-weight: 600;
      color: var(--text-4);
      text-transform: uppercase; letter-spacing: 0.6px;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
      text-align: left; white-space: nowrap;
    }
    .data-table td {
      padding: 12px 14px;
      font-size: 13.5px; color: var(--text-2);
      border-bottom: 1px solid var(--border-2);
    }
    .data-table tbody tr:hover { background: #fafafa; }
    .data-table tbody tr:last-child td { border-bottom: none; }

    /* ══════════════════════════════════════
       BADGES
    ══════════════════════════════════════ */
    .badge {
      display: inline-flex; align-items: center;
      padding: 2px 9px;
      border-radius: var(--radius-full);
      font-size: 11.5px; font-weight: 600;
      border: 1px solid transparent;
    }
    .badge-primary { background: var(--primary-dim); color: var(--primary-dark); border-color: var(--primary-border); }
    .badge-success { background: var(--success-dim); color: var(--success); border-color: rgba(22,163,74,0.2); }
    .badge-danger  { background: var(--danger-dim);  color: var(--danger);  border-color: rgba(220,38,38,0.2); }
    .badge-warning { background: var(--warning-dim); color: var(--warning); border-color: rgba(217,119,6,0.2); }
    .badge-info    { background: var(--info-dim);    color: var(--info);    border-color: rgba(37,99,235,0.2); }
    .badge-gray    { background: var(--surface-2);   color: var(--text-3);  border-color: var(--border); }
    .badge-accent  { background: #000; color: #fff; }

    /* ══════════════════════════════════════
       FORMS
    ══════════════════════════════════════ */
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
    .form-control {
      width: 100%; padding: 9px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; color: var(--text);
      background: var(--surface);
      outline: none; transition: all 0.15s; line-height: 1.4;
    }
    .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 2px var(--primary-dim); }
    .form-control::placeholder { color: var(--text-4); }
    .form-hint { font-size: 12px; color: var(--text-4); margin-top: 4px; }
    .form-row   { display: grid; gap: 14px; }
    .form-row-2 { grid-template-columns: 1fr 1fr; }
    .form-row-3 { grid-template-columns: 1fr 1fr 1fr; }
    select.form-control option { background: #fff; color: var(--text); }
    input[type="date"].form-control::-webkit-calendar-picker-indicator { opacity: 0.5; cursor: pointer; }

    /* ══════════════════════════════════════
       MODAL  — Shadcn Dialog style
    ══════════════════════════════════════ */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: none; align-items: center; justify-content: center;
      padding: 20px;
      opacity: 0; transition: opacity 0.2s;
    }
    .modal-overlay.active { display: flex; opacity: 1; }
    .modal-box {
      background: var(--surface);
      border: 1px solid var(--border);
      width: 100%; max-width: 520px;
      border-radius: var(--radius-xl);
      box-shadow: 0 20px 48px rgba(0,0,0,0.14);
      transform: translateY(8px) scale(0.98);
      transition: transform 0.22s cubic-bezier(0.4,0,0.2,1);
      max-height: 88vh; overflow-y: auto;
    }
    .modal-box-lg { max-width: 680px; }
    .modal-overlay.active .modal-box { transform: translateY(0) scale(1); }
    .modal-header {
      padding: 16px 20px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; background: var(--surface); z-index: 1;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
    .modal-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; font-weight: 700; color: var(--text); }
    .modal-close {
      width: 30px; height: 30px; border: none;
      background: var(--surface-2); border-radius: 50%;
      color: var(--text-3); cursor: pointer; font-size: 17px;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s; line-height: 1;
    }
    .modal-close:hover { background: var(--danger-dim); color: var(--danger); }
    .modal-body { padding: 20px; }
    .modal-footer { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }

    /* ══════════════════════════════════════
       ALERTS
    ══════════════════════════════════════ */
    .alert {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 12px 14px; border-radius: var(--radius-sm);
      font-size: 13.5px; margin-bottom: 18px; line-height: 1.5;
      border: 1px solid transparent;
    }
    .alert-success { background: var(--success-dim); border-color: rgba(22,163,74,0.2); color: var(--success); }
    .alert-error   { background: var(--danger-dim);  border-color: rgba(220,38,38,0.2); color: var(--danger); }

    /* ══════════════════════════════════════
       PAGE HEADER
    ══════════════════════════════════════ */
    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 20px; gap: 16px;
    }
    .page-header h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 20px; font-weight: 800; color: var(--text); letter-spacing: -0.4px;
    }
    .page-header p { font-size: 13px; color: var(--text-4); margin-top: 2px; }
    .page-header-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

    /* ══════════════════════════════════════
       STAT CARDS
    ══════════════════════════════════════ */
    .stats-grid { display: grid; gap: 12px; margin-bottom: 20px; }
    .stats-4 { grid-template-columns: repeat(4, 1fr); }
    .stats-3 { grid-template-columns: repeat(3, 1fr); }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px 18px;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .stat-card:hover { border-color: var(--primary-border); box-shadow: 0 4px 12px rgba(249,115,22,0.08); }
    .stat-icon {
      width: 38px; height: 38px; border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; margin-bottom: 12px;
    }
    .stat-label { font-size: 11px; font-weight: 600; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px; }
    .stat-value {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 24px; font-weight: 800; color: var(--text);
      line-height: 1; letter-spacing: -0.5px;
    }
    .stat-sub { font-size: 11.5px; color: var(--text-4); margin-top: 5px; }

    /* ══════════════════════════════════════
       EMPTY STATE
    ══════════════════════════════════════ */
    .empty-state { text-align: center; padding: 48px 20px; color: var(--text-4); }
    .empty-icon  { font-size: 38px; margin-bottom: 12px; }
    .empty-title { font-size: 14px; font-weight: 600; color: var(--text-3); margin-bottom: 5px; }
    .empty-desc  { font-size: 13px; }

    /* ══════════════════════════════════════
       TABS
    ══════════════════════════════════════ */
    .tab-bar {
      display: flex; gap: 2px;
      background: var(--surface-2); border: 1px solid var(--border);
      border-radius: var(--radius-sm); padding: 3px;
      width: fit-content; margin-bottom: 18px;
      overflow-x: auto; max-width: 100%;
    }
    .tab-btn {
      padding: 6px 16px;
      border-radius: var(--radius-xs);
      border: none; background: none;
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 13px; font-weight: 500; color: var(--text-3);
      cursor: pointer; transition: all 0.15s; white-space: nowrap;
    }
    .tab-btn.active { background: var(--surface); color: var(--text); font-weight: 600; box-shadow: var(--shadow-xs); }

    /* ══════════════════════════════════════
       SEARCH
    ══════════════════════════════════════ */
    .search-wrap { position: relative; }
    .search-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-4); font-size: 13px; pointer-events: none; }
    .search-input {
      width: 100%; padding: 8px 12px 8px 34px;
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 13.5px; color: var(--text);
      background: var(--surface); outline: none; transition: all 0.15s;
    }
    .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 2px var(--primary-dim); }

    /* ══════════════════════════════════════
       MISC
    ══════════════════════════════════════ */
    .highlight-card { border-color: var(--primary-border) !important; background: var(--primary-dim) !important; }
    .two-col-grid   { display: grid; grid-template-columns: 3fr 2fr; gap: 18px; }
    hr { border: none; border-top: 1px solid var(--border); }

    /* Divider label */
    .section-label {
      font-size: 10.5px; font-weight: 700; color: var(--text-4);
      text-transform: uppercase; letter-spacing: 0.8px;
      display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
    }
    .section-label::after { content:''; flex:1; height:1px; background:var(--border); }

    /* ══════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════ */
    @media (max-width: 1100px) {
      .stats-4 { grid-template-columns: repeat(2, 1fr); }
      .stats-3 { grid-template-columns: repeat(2, 1fr); }
      .two-col-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      :root { --topbar-h: 52px; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); box-shadow: 4px 0 24px rgba(0,0,0,0.2); }
      .sidebar-overlay { display: block; }
      .sidebar-close { display: flex; }
      .main-content { margin-left: 0; }
      .hamburger { display: flex; }
      .topbar-date { display: none; }
      .page-body { padding: 14px; }
      .page-header { flex-direction: column; align-items: stretch; gap: 10px; }
      .page-header-actions { flex-wrap: wrap; }
      .stats-4, .stats-3 { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .stat-card { padding: 12px 14px; }
      .stat-value { font-size: 20px; }
      .form-row-2, .form-row-3 { grid-template-columns: 1fr; }
      .two-col-grid { grid-template-columns: 1fr; }
      .modal-overlay { align-items: flex-end; padding: 0; }
      .modal-box { border-radius: var(--radius-xl) var(--radius-xl) 0 0; max-height: 90vh; max-width: 100%; transform: translateY(100%); }
      .modal-overlay.active .modal-box { transform: translateY(0); }
      .topbar { padding: 0 14px; }
      .card-header { padding: 12px 14px; flex-wrap: wrap; }
      .card-body { padding: 14px; }
    }

    @media (max-width: 480px) {
      .stats-4 { grid-template-columns: 1fr 1fr; gap: 8px; }
      .btn { font-size: 13px; padding: 7px 14px; }
      .btn-sm { padding: 5px 10px; font-size: 12px; }
      .page-body { padding: 10px; }
    }
  </style>
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">B</div>
      <div class="logo-text">Biz<span>Flow</span></div>
      <button class="sidebar-close" onclick="closeSidebar()">✕</button>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">
        <div class="nav-section-label">ภาพรวม</div>
        <a href="/dashboard" class="nav-item <%= activePage==='dashboard'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📊</span> Dashboard
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">การเงิน</div>
        <a href="/income" class="nav-item <%= activePage==='income'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">💰</span> รายรับ-รายจ่าย
        </a>
        <a href="/reports" class="nav-item <%= activePage==='reports'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📋</span> รายงานการเงิน
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">การขาย</div>
        <a href="/sales" class="nav-item <%= activePage==='sales'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🧾</span> งานขาย
        </a>
        <a href="/products" class="nav-item <%= activePage==='products'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📦</span> สินค้า
        </a>
        <a href="/customers" class="nav-item <%= activePage==='customers'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🏢</span> ลูกค้า
        </a>
        <a href="/ecommerce" class="nav-item <%= activePage==='ecommerce'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🛒</span> อีคอมเมิร์ซ
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">ทรัพยากรบุคคล</div>
        <a href="/hr" class="nav-item <%= activePage==='hr'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">👥</span> พนักงาน
        </a>
        <a href="/hr/payroll" class="nav-item <%= activePage==='payroll'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">💵</span> เงินเดือน
        </a>
        <a href="/hr/leave" class="nav-item <%= activePage==='leave'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🗓️</span> วันลา
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">ระบบ</div>
        <a href="/settings" class="nav-item <%= activePage==='settings'?'active':'' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">⚙️</span> ตั้งค่า
        </a>
      </div>
    </nav>

    <div class="sidebar-footer">
      <div class="user-card">
        <div class="user-avatar"><%= user.name ? user.name[0].toUpperCase() : 'U' %></div>
        <div class="user-info">
          <div class="user-name"><%= user.name %></div>
          <div class="user-role"><%= user.role==='admin'?'ผู้ดูแลระบบ':user.role==='manager'?'ผู้จัดการ':'พนักงาน' %></div>
        </div>
        <a href="/logout" class="btn-logout" title="ออกจากระบบ">⏻</a>
      </div>
    </div>
  </aside>

  <div class="main-content">
    <div class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="openSidebar()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <div class="topbar-title"><%- title %></div>
      </div>
      <div class="topbar-actions">
        <span class="topbar-date"><%= new Date().toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'long',day:'numeric'}) %></span>
      </div>
    </div>
    <div class="page-body">

  <script>
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open')
      document.getElementById('sidebarOverlay').classList.add('active')
      document.body.style.overflow = 'hidden'
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open')
      document.getElementById('sidebarOverlay').classList.remove('active')
      document.body.style.overflow = ''
    }
    function closeSidebarOnMobile() { if (window.innerWidth <= 768) closeSidebar() }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeSidebar(); document.querySelectorAll('.modal-overlay.active').forEach(m => closeModal(m.id)) } })
    function openModal(id)  { const m = document.getElementById(id); if(m){ m.style.display='flex'; requestAnimationFrame(()=>m.classList.add('active')) } }
    function closeModal(id) { const m = document.getElementById(id); if(m){ m.classList.remove('active'); setTimeout(()=>{ if(!m.classList.contains('active')) m.style.display='none' },220) } }
  </script>
