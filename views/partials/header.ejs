<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — BizFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Prompt', 'Plus Jakarta Sans', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'Prompt', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --sidebar-w: 256px;
      --topbar-h: 56px;
      --primary: #f97316;
      --primary-dark: #ea580c;
      --primary-light: #fb923c;
      --primary-dim: rgba(249,115,22,0.12);
      --primary-border: rgba(249,115,22,0.3);
      --accent: #fbbf24;
      --accent-dim: rgba(251,191,36,0.12);
      --success: #22c55e;
      --success-dim: rgba(34,197,94,0.12);
      --danger: #ef4444;
      --danger-dim: rgba(239,68,68,0.12);
      --warning: #f59e0b;
      --warning-dim: rgba(245,158,11,0.12);
      --info: #3b82f6;
      --info-dim: rgba(59,130,246,0.12);
      --bg: #0d0d0d;
      --surface: #181818;
      --surface-2: #222222;
      --text: #f5f5f5;
      --text-2: #e0e0e0;
      --text-3: #a0a0a0;
      --text-4: #686868;
      --border: #2c2c2c;
      --border-2: #1e1e1e;
      --shadow-xs: 0 1px 2px rgba(0,0,0,0.4);
      --shadow-sm: 0 2px 8px rgba(0,0,0,0.4);
      --shadow: 0 4px 16px rgba(0,0,0,0.5);
      --shadow-md: 0 8px 24px rgba(0,0,0,0.6);
      --shadow-primary: 0 4px 18px rgba(249,115,22,0.35);
      --radius-xs: 6px;
      --radius-sm: 10px;
      --radius: 14px;
      --radius-lg: 18px;
      --radius-xl: 22px;
      --radius-full: 9999px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-weight: 400;
      font-size: 15px;
      line-height: 1.6;
      background: var(--bg);
      display: flex;
      min-height: 100vh;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ─── Sidebar ─── */
    .sidebar {
      width: var(--sidebar-w);
      background: #111111;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 0; top: 0; bottom: 0;
      z-index: 200;
      border-right: 1px solid #1e1e1e;
      transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    }

    /* ─── Mobile Overlay ─── */
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(3px);
      z-index: 190;
      opacity: 0;
      transition: opacity 0.28s ease;
    }
    .sidebar-overlay.active { opacity: 1; }

    .sidebar-logo {
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid #1e1e1e;
      flex-shrink: 0;
    }

    .logo-mark {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, #ea580c, #fbbf24);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 17px; font-weight: 800;
      color: #fff;
      box-shadow: 0 4px 12px rgba(249,115,22,0.4);
      flex-shrink: 0;
    }

    .logo-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 17px; font-weight: 700;
      color: var(--text);
      letter-spacing: -0.3px;
      flex: 1;
    }
    .logo-text span { color: var(--primary); }

    /* close button inside sidebar (mobile only) */
    .sidebar-close {
      display: none;
      width: 32px; height: 32px;
      background: #222;
      border: none;
      border-radius: 8px;
      color: var(--text-3);
      cursor: pointer;
      align-items: center; justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .sidebar-close:hover { background: var(--danger-dim); color: var(--danger); }

    .sidebar-nav {
      flex: 1;
      padding: 10px 8px;
      overflow-y: auto;
    }

    .nav-section { margin-bottom: 4px; }

    .nav-section-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--text-4);
      padding: 12px 10px 4px;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-3);
      transition: all 0.15s;
      margin-bottom: 2px;
      border: 1px solid transparent;
    }
    .nav-item:hover { background: #1e1e1e; color: var(--text-2); }
    .nav-item.active {
      background: rgba(249,115,22,0.14);
      color: var(--primary);
      font-weight: 600;
      border-color: rgba(249,115,22,0.2);
    }
    .nav-icon { font-size: 15px; width: 20px; text-align: center; flex-shrink: 0; }

    .sidebar-footer {
      padding: 14px 16px;
      border-top: 1px solid #1e1e1e;
      flex-shrink: 0;
    }

    .user-card { display: flex; align-items: center; gap: 10px; }

    .user-avatar {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 700;
      color: #fff;
      flex-shrink: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .user-info { flex: 1; min-width: 0; }
    .user-name { font-size: 13.5px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .user-role { font-size: 11.5px; color: var(--text-4); margin-top: 1px; }

    .btn-logout {
      width: 30px; height: 30px;
      background: none;
      border: 1px solid var(--border);
      border-radius: 50%;
      color: var(--text-4);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
      text-decoration: none;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .btn-logout:hover { border-color: var(--danger); color: var(--danger); background: var(--danger-dim); }

    /* ─── Main content ─── */
    .main-content {
      margin-left: var(--sidebar-w);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-width: 0;
    }

    /* ─── Topbar ─── */
    .topbar {
      background: #111111;
      border-bottom: 1px solid #1e1e1e;
      padding: 0 24px;
      height: var(--topbar-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; min-width: 0; }

    /* hamburger - hidden on desktop */
    .hamburger {
      display: none;
      width: 38px; height: 38px;
      background: #1e1e1e;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-3);
      cursor: pointer;
      align-items: center; justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .hamburger:hover { background: #2a2a2a; color: var(--primary); border-color: rgba(249,115,22,0.3); }

    .topbar-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 15px; font-weight: 700;
      color: var(--text);
      letter-spacing: -0.2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

    .topbar-date {
      font-size: 12px;
      color: var(--text-4);
      background: #1a1a1a;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      padding: 5px 14px;
      white-space: nowrap;
    }

    .page-body { padding: 24px; flex: 1; }

    /* ─── Buttons ─── */
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 20px;
      border-radius: var(--radius-full);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      text-decoration: none;
      white-space: nowrap;
      line-height: 1.4;
      letter-spacing: 0.1px;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--primary-dark), var(--primary));
      color: #fff;
      box-shadow: var(--shadow-primary);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(249,115,22,0.45); }
    .btn-secondary { background: #222; color: var(--text-2); border: 1px solid var(--border); }
    .btn-secondary:hover { background: #2a2a2a; border-color: #3c3c3c; color: var(--text); }
    .btn-danger { background: var(--danger-dim); color: var(--danger); border: 1px solid rgba(239,68,68,0.25); }
    .btn-danger:hover { background: var(--danger); color: #fff; }
    .btn-success { background: var(--success-dim); color: var(--success); border: 1px solid rgba(34,197,94,0.25); }
    .btn-success:hover { background: var(--success); color: #fff; }
    .btn-warning { background: var(--warning-dim); color: var(--warning); border: 1px solid rgba(245,158,11,0.25); }
    .btn-accent { background: linear-gradient(135deg, #d97706, var(--accent)); color: #111; font-weight: 700; box-shadow: 0 4px 14px rgba(251,191,36,0.3); }
    .btn-accent:hover { transform: translateY(-1px); }
    .btn-sm { padding: 6px 16px; font-size: 13px; }
    .btn-xs { padding: 4px 12px; font-size: 12px; }
    .btn:active { transform: translateY(0) !important; }

    /* ─── Cards ─── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }
    .card-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px;
    }
    .card-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; font-weight: 700; color: var(--text);
    }
    .card-body { padding: 20px; }

    /* ─── Table ─── */
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius-lg); }
    .data-table { width: 100%; border-collapse: collapse; min-width: 500px; }
    .data-table th {
      padding: 11px 16px;
      font-size: 11px; font-weight: 600;
      color: var(--text-4);
      text-transform: uppercase; letter-spacing: 0.8px;
      border-bottom: 1px solid var(--border);
      background: #111111;
      text-align: left;
      white-space: nowrap;
    }
    .data-table td {
      padding: 13px 16px;
      font-size: 14px; color: var(--text-2);
      border-bottom: 1px solid var(--border-2);
    }
    .data-table tbody tr:hover { background: #1e1e1e; }
    .data-table tbody tr:last-child td { border-bottom: none; }

    /* ─── Badges ─── */
    .badge {
      display: inline-flex; align-items: center;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      font-size: 12px; font-weight: 600;
    }
    .badge-primary { background: var(--primary-dim); color: var(--primary); border: 1px solid rgba(249,115,22,0.2); }
    .badge-success { background: var(--success-dim); color: var(--success); }
    .badge-danger { background: var(--danger-dim); color: var(--danger); }
    .badge-warning { background: var(--warning-dim); color: var(--warning); }
    .badge-info { background: var(--info-dim); color: var(--info); }
    .badge-gray { background: #222; color: var(--text-3); border: 1px solid var(--border); }
    .badge-accent { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.25); }

    /* ─── Forms ─── */
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-3); margin-bottom: 7px; }
    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 14.5px; color: var(--text);
      background: #1a1a1a;
      outline: none;
      transition: all 0.2s;
      line-height: 1.4;
    }
    .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(249,115,22,0.15); }
    .form-control::placeholder { color: var(--text-4); }
    .form-hint { font-size: 12px; color: var(--text-4); margin-top: 5px; }
    .form-row { display: grid; gap: 14px; }
    .form-row-2 { grid-template-columns: 1fr 1fr; }
    .form-row-3 { grid-template-columns: 1fr 1fr 1fr; }
    select.form-control option { background: #1a1a1a; color: var(--text); }
    input[type="date"].form-control::-webkit-calendar-picker-indicator { filter: invert(1); opacity: 0.5; }

    /* ─── Modal ─── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(6px);
      z-index: 1000;
      display: none; align-items: center; justify-content: center;
      padding: 20px;
      opacity: 0; transition: opacity 0.25s;
    }
    .modal-overlay.active { display: flex; opacity: 1; }
    .modal-box {
      background: #181818;
      border: 1px solid #2c2c2c;
      width: 100%; max-width: 520px;
      border-radius: var(--radius-xl);
      box-shadow: 0 24px 64px rgba(0,0,0,0.6);
      transform: translateY(16px) scale(0.98);
      transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
      max-height: 88vh; overflow-y: auto;
    }
    .modal-box-lg { max-width: 680px; }
    .modal-overlay.active .modal-box { transform: translateY(0) scale(1); }
    .modal-header {
      padding: 18px 22px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; background: #181818; z-index: 1;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
    .modal-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 700; color: var(--text); }
    .modal-close {
      width: 32px; height: 32px;
      border: none; background: #222; border-radius: 50%;
      color: var(--text-3); cursor: pointer; font-size: 18px;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; line-height: 1;
    }
    .modal-close:hover { background: var(--danger-dim); color: var(--danger); }
    .modal-body { padding: 22px; }
    .modal-footer {
      padding: 16px 22px; border-top: 1px solid var(--border);
      display: flex; justify-content: flex-end; gap: 10px;
    }

    /* ─── Alert ─── */
    .alert {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 13px 16px; border-radius: var(--radius-sm);
      font-size: 14px; margin-bottom: 20px; line-height: 1.5;
    }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.25); color: #4ade80; }
    .alert-error { background: var(--danger-dim); border: 1px solid rgba(239,68,68,0.25); color: #f87171; }

    /* ─── Page Header ─── */
    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 24px; gap: 16px;
    }
    .page-header h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 22px; font-weight: 800; color: var(--text); letter-spacing: -0.5px;
    }
    .page-header p { font-size: 13.5px; color: var(--text-4); margin-top: 2px; }
    .page-header-actions { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }

    /* ─── Stat Cards ─── */
    .stats-grid { display: grid; gap: 14px; margin-bottom: 24px; }
    .stats-4 { grid-template-columns: repeat(4, 1fr); }
    .stats-3 { grid-template-columns: repeat(3, 1fr); }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover { border-color: rgba(249,115,22,0.25); box-shadow: 0 4px 20px rgba(249,115,22,0.1); }
    .stat-icon {
      width: 42px; height: 42px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; margin-bottom: 14px;
    }
    .stat-label { font-size: 11px; font-weight: 600; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px; }
    .stat-value {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 26px; font-weight: 800; color: var(--text);
      line-height: 1; letter-spacing: -0.5px;
    }
    .stat-sub { font-size: 12px; color: var(--text-4); margin-top: 6px; }

    /* ─── Empty State ─── */
    .empty-state { text-align: center; padding: 56px 20px; color: var(--text-4); }
    .empty-icon { font-size: 42px; margin-bottom: 14px; }
    .empty-title { font-size: 15px; font-weight: 600; color: var(--text-3); margin-bottom: 6px; }
    .empty-desc { font-size: 13.5px; }

    /* ─── Tabs ─── */
    .tab-bar {
      display: flex; gap: 2px;
      background: #111; border: 1px solid var(--border);
      border-radius: var(--radius-full); padding: 4px;
      width: fit-content; margin-bottom: 20px;
      overflow-x: auto; max-width: 100%;
    }
    .tab-btn {
      padding: 8px 18px;
      border-radius: var(--radius-full);
      border: 1px solid transparent; background: none;
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 13.5px; font-weight: 500; color: var(--text-3);
      cursor: pointer; transition: all 0.2s; white-space: nowrap;
    }
    .tab-btn.active { background: rgba(249,115,22,0.15); color: var(--primary); font-weight: 600; border-color: rgba(249,115,22,0.25); }

    /* ─── Search ─── */
    .search-wrap { position: relative; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-4); font-size: 14px; pointer-events: none; }
    .search-input {
      width: 100%; padding: 9px 14px 9px 36px;
      border: 1.5px solid var(--border); border-radius: var(--radius-full);
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; color: var(--text);
      background: #1a1a1a; outline: none; transition: all 0.2s;
    }
    .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(249,115,22,0.12); }

    /* ─── Highlight card ─── */
    .highlight-card {
      border-color: rgba(249,115,22,0.3) !important;
      background: rgba(249,115,22,0.06) !important;
    }

    /* ─── Responsive 2-col grid (for dashboard inline grids) ─── */
    .two-col-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 20px; }

    /* ════════════════════════════════════════
       RESPONSIVE BREAKPOINTS
    ════════════════════════════════════════ */

    /* Tablet */
    @media (max-width: 1100px) {
      .stats-4 { grid-template-columns: repeat(2, 1fr); }
      .stats-3 { grid-template-columns: repeat(2, 1fr); }
      .two-col-grid { grid-template-columns: 1fr; }
    }

    /* Mobile */
    @media (max-width: 768px) {
      :root { --topbar-h: 54px; }

      /* Sidebar hidden by default on mobile */
      .sidebar { transform: translateX(-100%); box-shadow: none; }
      .sidebar.open { transform: translateX(0); box-shadow: 4px 0 32px rgba(0,0,0,0.6); }
      .sidebar-overlay { display: block; }
      .sidebar-close { display: flex; }

      /* Main content full width */
      .main-content { margin-left: 0; }

      /* Hamburger visible */
      .hamburger { display: flex; }

      /* Hide date on mobile topbar */
      .topbar-date { display: none; }

      /* Page body less padding */
      .page-body { padding: 16px; }

      /* Page header stacks on mobile */
      .page-header {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }
      .page-header-actions { flex-wrap: wrap; }

      /* Stats grid 2 columns on mobile */
      .stats-4 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .stats-3 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .stat-card { padding: 14px 16px; }
      .stat-value { font-size: 20px; }

      /* Form rows collapse to 1 col */
      .form-row-2 { grid-template-columns: 1fr; }
      .form-row-3 { grid-template-columns: 1fr; }

      /* Two-col grid stacks */
      .two-col-grid { grid-template-columns: 1fr; }

      /* Modal becomes bottom sheet on mobile */
      .modal-overlay { align-items: flex-end; padding: 0; }
      .modal-box {
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        max-height: 90vh;
        max-width: 100%;
        transform: translateY(100%);
      }
      .modal-overlay.active .modal-box { transform: translateY(0); scale(1); }

      /* Topbar title smaller */
      .topbar-title { font-size: 14px; }
      .topbar { padding: 0 16px; }

      /* Card adjustments */
      .card-header { padding: 14px 16px; flex-wrap: wrap; gap: 8px; }
      .card-body { padding: 16px; }
    }

    /* Small mobile */
    @media (max-width: 480px) {
      .stats-4 { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .stat-label { font-size: 10px; }
      .stat-value { font-size: 18px; }
      .btn { font-size: 13px; padding: 8px 16px; }
      .btn-sm { padding: 6px 12px; font-size: 12px; }
      .page-body { padding: 12px; }
    }
  </style>
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
  <!-- Mobile overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">B</div>
      <div class="logo-text">Biz<span>Flow</span></div>
      <button class="sidebar-close" onclick="closeSidebar()" aria-label="ปิดเมนู">✕</button>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">
        <div class="nav-section-label">ภาพรวม</div>
        <a href="/dashboard" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📊</span> Dashboard
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">การเงิน</div>
        <a href="/income" class="nav-item <%= activePage === 'income' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">💰</span> รายรับ-รายจ่าย
        </a>
        <a href="/reports" class="nav-item <%= activePage === 'reports' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📋</span> รายงานการเงิน
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">การขาย</div>
        <a href="/sales" class="nav-item <%= activePage === 'sales' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🧾</span> งานขาย
        </a>
        <a href="/products" class="nav-item <%= activePage === 'products' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">📦</span> สินค้า
        </a>
        <a href="/customers" class="nav-item <%= activePage === 'customers' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🏢</span> ลูกค้า
        </a>
        <a href="/ecommerce" class="nav-item <%= activePage === 'ecommerce' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🛒</span> อีคอมเมิร์ซ
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">ทรัพยากรบุคคล</div>
        <a href="/hr" class="nav-item <%= activePage === 'hr' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">👥</span> พนักงาน
        </a>
        <a href="/hr/payroll" class="nav-item <%= activePage === 'payroll' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">💵</span> เงินเดือน
        </a>
        <a href="/hr/leave" class="nav-item <%= activePage === 'leave' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">🗓️</span> วันลา
        </a>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">ระบบ</div>
        <a href="/settings" class="nav-item <%= activePage === 'settings' ? 'active' : '' %>" onclick="closeSidebarOnMobile()">
          <span class="nav-icon">⚙️</span> ตั้งค่า
        </a>
      </div>
    </nav>

    <div class="sidebar-footer">
      <div class="user-card">
        <div class="user-avatar"><%= user.name ? user.name[0].toUpperCase() : 'U' %></div>
        <div class="user-info">
          <div class="user-name"><%= user.name %></div>
          <div class="user-role"><%= user.role === 'admin' ? 'ผู้ดูแลระบบ' : user.role === 'manager' ? 'ผู้จัดการ' : 'พนักงาน' %></div>
        </div>
        <a href="/logout" class="btn-logout" title="ออกจากระบบ">⏻</a>
      </div>
    </div>
  </aside>

  <div class="main-content">
    <div class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="openSidebar()" aria-label="เปิดเมนู">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <div class="topbar-title"><%- title %></div>
      </div>
      <div class="topbar-actions">
        <span class="topbar-date"><%= new Date().toLocaleDateString('th-TH', {weekday:'short', year:'numeric', month:'long', day:'numeric'}) %></span>
      </div>
    </div>
    <div class="page-body">

  <script>
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open')
      document.getElementById('sidebarOverlay').classList.add('active')
      document.body.style.overflow = 'hidden'
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open')
      document.getElementById('sidebarOverlay').classList.remove('active')
      document.body.style.overflow = ''
    }
    function closeSidebarOnMobile() {
      if (window.innerWidth <= 768) closeSidebar()
    }
    // Close sidebar on ESC
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar() })
  </script>
