<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>ลูกค้า</h1>
    <p>จัดการข้อมูลลูกค้าและผู้ติดต่อ</p>
  </div>
  <button class="btn btn-primary" onclick="openModal('addModal')">+ เพิ่มลูกค้า</button>
</div>

<% if (success && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error">⚠ <%= error[0] %></div><% } %>

<div class="card">
  <div class="card-header">
    <span class="card-title">รายชื่อลูกค้า (<%= customers.length %> ราย)</span>
    <div class="search-wrap" style="width:280px;">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" id="searchInput" placeholder="ค้นหาชื่อ, เลขภาษี, เบอร์โทร..." oninput="filterTable()">
    </div>
  </div>
  <div class="table-wrap">
    <% if (customers.length > 0) { %>
    <table class="data-table" id="customerTable">
      <thead>
        <tr>
          <th>รหัส</th>
          <th>ชื่อลูกค้า</th>
          <th>เลขประจำตัวผู้เสียภาษี</th>
          <th>โทรศัพท์</th>
          <th>ผู้ติดต่อ</th>
          <th>เครดิต</th>
          <th style="text-align:center;">จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% customers.forEach(c => { %>
          <tr>
            <td style="font-size:12.5px;color:var(--text-3)"><%= c.code || '-' %></td>
            <td>
              <div style="font-weight:600;"><%= c.name %></div>
              <% if (c.branch_name && c.branch_name !== 'สำนักงานใหญ่') { %><div style="font-size:11.5px;color:var(--text-4)"><%= c.branch_name %></div><% } %>
            </td>
            <td style="font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;"><%= c.tax_id || '-' %></td>
            <td><%= c.phone || '-' %></td>
            <td><%= c.contact_person || '-' %></td>
            <td><%= c.credit_days > 0 ? `${c.credit_days} วัน` : 'เงินสด' %></td>
            <td style="text-align:center;">
              <div style="display:flex;gap:6px;justify-content:center;">
                <button class="btn btn-secondary btn-xs" onclick="openEdit(<%= JSON.stringify(c).replace(/"/g,'&quot;') %>)">แก้ไข</button>
                <form action="/customers/<%= c.id %>?_method=DELETE" method="POST" style="margin:0;" onsubmit="return confirm('ลบลูกค้า <%= c.name %>?')">
                  <button type="submit" class="btn btn-danger btn-xs">ลบ</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">🏢</div>
      <div class="empty-title">ยังไม่มีข้อมูลลูกค้า</div>
      <div class="empty-desc">คลิก "+ เพิ่มลูกค้า" เพื่อเริ่มต้น</div>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal เพิ่มลูกค้า -->
<div class="modal-overlay" id="addModal">
  <div class="modal-box modal-box-lg">
    <div class="modal-header">
      <span class="modal-title">เพิ่มลูกค้าใหม่</span>
      <button class="modal-close" onclick="closeModal('addModal')">×</button>
    </div>
    <div class="modal-body">
      <form action="/customers" method="POST">
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">รหัสลูกค้า</label>
            <input type="text" name="code" class="form-control" placeholder="เช่น C001">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อลูกค้า / บริษัท *</label>
            <input type="text" name="name" class="form-control" required placeholder="ชื่อเต็ม">
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">เลขประจำตัวผู้เสียภาษี</label>
            <input type="text" name="tax_id" class="form-control" placeholder="0000000000000">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อสำนักงาน</label>
            <input type="text" name="branch_name" class="form-control" value="สำนักงานใหญ่">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ที่อยู่</label>
          <textarea name="address" class="form-control" rows="2" placeholder="บ้านเลขที่ ถนน แขวง/ตำบล เขต/อำเภอ"></textarea>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">จังหวัด</label>
            <input type="text" name="province" class="form-control" placeholder="กรุงเทพมหานคร">
          </div>
          <div class="form-group">
            <label class="form-label">รหัสไปรษณีย์</label>
            <input type="text" name="postal_code" class="form-control" placeholder="10000">
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label class="form-label">โทรศัพท์</label>
            <input type="text" name="phone" class="form-control" placeholder="02-xxx-xxxx">
          </div>
          <div class="form-group">
            <label class="form-label">อีเมล</label>
            <input type="email" name="email" class="form-control" placeholder="example@co.th">
          </div>
          <div class="form-group">
            <label class="form-label">เครดิต (วัน)</label>
            <input type="number" name="credit_days" class="form-control" value="0" min="0">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ผู้ติดต่อ</label>
          <input type="text" name="contact_person" class="form-control" placeholder="ชื่อ-นามสกุล ผู้ติดต่อ">
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-primary">บันทึกลูกค้า</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal แก้ไขลูกค้า -->
<div class="modal-overlay" id="editModal">
  <div class="modal-box modal-box-lg">
    <div class="modal-header">
      <span class="modal-title">แก้ไขข้อมูลลูกค้า</span>
      <button class="modal-close" onclick="closeModal('editModal')">×</button>
    </div>
    <div class="modal-body">
      <form id="editForm" method="POST">
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">รหัสลูกค้า</label>
            <input type="text" name="code" id="e_code" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อลูกค้า / บริษัท *</label>
            <input type="text" name="name" id="e_name" class="form-control" required>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">เลขประจำตัวผู้เสียภาษี</label>
            <input type="text" name="tax_id" id="e_tax_id" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อสำนักงาน</label>
            <input type="text" name="branch_name" id="e_branch" class="form-control">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ที่อยู่</label>
          <textarea name="address" id="e_address" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">จังหวัด</label>
            <input type="text" name="province" id="e_province" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">รหัสไปรษณีย์</label>
            <input type="text" name="postal_code" id="e_postal" class="form-control">
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label class="form-label">โทรศัพท์</label>
            <input type="text" name="phone" id="e_phone" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">อีเมล</label>
            <input type="email" name="email" id="e_email" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">เครดิต (วัน)</label>
            <input type="number" name="credit_days" id="e_credit" class="form-control" min="0">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ผู้ติดต่อ</label>
          <input type="text" name="contact_person" id="e_contact" class="form-control">
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-primary">บันทึกการแก้ไข</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openModal(id) { document.getElementById(id).classList.add('active') }
  function closeModal(id) { document.getElementById(id).classList.remove('active') }
  window.onclick = e => { if (e.target.classList.contains('modal-overlay')) e.target.classList.remove('active') }

  function openEdit(c) {
    document.getElementById('editForm').action = `/customers/${c.id}?_method=PUT`
    document.getElementById('e_code').value = c.code || ''
    document.getElementById('e_name').value = c.name || ''
    document.getElementById('e_tax_id').value = c.tax_id || ''
    document.getElementById('e_branch').value = c.branch_name || 'สำนักงานใหญ่'
    document.getElementById('e_address').value = c.address || ''
    document.getElementById('e_province').value = c.province || ''
    document.getElementById('e_postal').value = c.postal_code || ''
    document.getElementById('e_phone').value = c.phone || ''
    document.getElementById('e_email').value = c.email || ''
    document.getElementById('e_credit').value = c.credit_days || 0
    document.getElementById('e_contact').value = c.contact_person || ''
    openModal('editModal')
  }

  function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase()
    document.querySelectorAll('#customerTable tbody tr').forEach(row => {
      row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none'
    })
  }
</script>

<%- include('../partials/footer') %>
