<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>รายงานการเงิน</h1>
    <p>สรุปรายรับ-รายจ่ายประจำปี <%= year %></p>
  </div>
  <form action="/reports" method="GET" style="display:flex;align-items:center;gap:10px;">
    <select name="year" class="form-control" style="width:120px;" onchange="this.form.submit()">
      <% availableYears.forEach(y => { %>
        <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
      <% }) %>
    </select>
  </form>
</div>

<!-- KPI Cards -->
<div class="stats-grid stats-4" style="margin-bottom:24px;">
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(16,185,129,0.1);">💰</div>
    <div class="stat-label">รายรับรวม</div>
    <div class="stat-value" style="color:#10b981;font-size:22px;">฿<%= totalIncome.toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
    <div class="stat-sub">ปี <%= year %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(239,68,68,0.1);">💸</div>
    <div class="stat-label">รายจ่ายรวม</div>
    <div class="stat-value" style="color:#ef4444;font-size:22px;">฿<%= totalExpense.toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
    <div class="stat-sub">ปี <%= year %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(99,102,241,0.1);">📊</div>
    <div class="stat-label">กำไรสุทธิ</div>
    <div class="stat-value" style="font-size:22px;"><%= netProfit >= 0 ? '' : '-' %>฿<%= Math.abs(netProfit).toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
    <div class="stat-sub" style="color:<%= netProfit >= 0 ? '#10b981' : '#ef4444' %>;font-weight:600;"><%= netProfit >= 0 ? '▲ กำไร' : '▼ ขาดทุน' %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(139,92,246,0.1);">👥</div>
    <div class="stat-label">พนักงาน</div>
    <div class="stat-value"><%= totalEmployees %></div>
    <div class="stat-sub">คน (active)</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:3fr 2fr;gap:20px;">
  <!-- กราฟรายเดือน -->
  <div class="card">
    <div class="card-header"><span class="card-title">📈 รายรับ-รายจ่ายรายเดือน</span></div>
    <div class="card-body">
      <% const maxVal = Math.max(...monthlyData.map(m => Math.max(m.income, m.expense)), 1) %>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <% monthlyData.forEach(m => { %>
        <div style="display:flex;align-items:center;gap:10px;">
          <div style="width:36px;font-size:11.5px;color:var(--text-4);text-align:right;flex-shrink:0;"><%= m.monthName %></div>
          <div style="flex:1;display:flex;flex-direction:column;gap:3px;">
            <% if (m.income > 0) { %>
            <div style="display:flex;align-items:center;gap:6px;">
              <div style="height:10px;background:linear-gradient(90deg,#10b981,#34d399);border-radius:99px;width:<%= Math.round((m.income/maxVal)*100) %>%;min-width:2px;"></div>
              <span style="font-size:11px;color:#10b981;font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;">฿<%= m.income.toLocaleString('th-TH',{maximumFractionDigits:0}) %></span>
            </div>
            <% } %>
            <% if (m.expense > 0) { %>
            <div style="display:flex;align-items:center;gap:6px;">
              <div style="height:10px;background:linear-gradient(90deg,#ef4444,#f87171);border-radius:99px;width:<%= Math.round((m.expense/maxVal)*100) %>%;min-width:2px;"></div>
              <span style="font-size:11px;color:#ef4444;font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;">฿<%= m.expense.toLocaleString('th-TH',{maximumFractionDigits:0}) %></span>
            </div>
            <% } %>
            <% if (m.income === 0 && m.expense === 0) { %>
            <div style="height:10px;background:var(--border-2);border-radius:99px;width:4px;"></div>
            <% } %>
          </div>
          <div style="width:80px;text-align:right;font-size:11.5px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:<%= m.income-m.expense>=0?'#10b981':'#ef4444' %>;">
            <% if (m.income > 0 || m.expense > 0) { %>฿<%= (m.income-m.expense).toLocaleString('th-TH',{maximumFractionDigits:0}) %><% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <div style="display:flex;gap:16px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border-2);">
        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-3);"><div style="width:12px;height:8px;background:#10b981;border-radius:4px;"></div>รายรับ</div>
        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-3);"><div style="width:12px;height:8px;background:#ef4444;border-radius:4px;"></div>รายจ่าย</div>
      </div>
    </div>
  </div>

  <!-- หมวดหมู่ -->
  <div class="card">
    <div class="card-header"><span class="card-title">📂 แยกตามหมวดหมู่ (Top 10)</span></div>
    <div class="card-body" style="padding-top:12px;">
      <% if (categoryBreakdown.length > 0) { %>
        <% const maxCat = Math.max(...categoryBreakdown.map(c=>c.total), 1) %>
        <% categoryBreakdown.forEach(c => { %>
        <div style="margin-bottom:12px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
            <span style="font-size:12.5px;color:var(--text-2);font-weight:500;"><%= c.name %></span>
            <span style="font-size:12px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:<%= c.type==='income'?'#10b981':'#ef4444' %>;">฿<%= c.total.toLocaleString('th-TH',{maximumFractionDigits:0}) %></span>
          </div>
          <div style="height:6px;background:var(--border-2);border-radius:99px;overflow:hidden;">
            <div style="height:100%;width:<%= Math.round((c.total/maxCat)*100) %>%;background:<%= c.type==='income'?'linear-gradient(90deg,#10b981,#34d399)':'linear-gradient(90deg,#ef4444,#f87171)' %>;border-radius:99px;"></div>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state" style="padding:30px 0;">
          <div class="empty-icon">📂</div>
          <div class="empty-title">ยังไม่มีข้อมูล</div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ตารางรายเดือน -->
<div class="card" style="margin-top:20px;">
  <div class="card-header"><span class="card-title">📋 ตารางสรุปรายเดือน</span></div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>เดือน</th>
          <th style="text-align:right;">รายรับ</th>
          <th style="text-align:right;">รายจ่าย</th>
          <th style="text-align:right;">กำไร/ขาดทุน</th>
        </tr>
      </thead>
      <tbody>
        <% monthlyData.forEach(m => { %>
        <tr>
          <td style="font-weight:600;"><%= m.monthName %> <%= year %></td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;color:#10b981;font-weight:600;">฿<%= m.income.toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;color:#ef4444;font-weight:600;">฿<%= m.expense.toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:<%= m.income-m.expense>=0?'#10b981':'#ef4444' %>;">
            <%= m.income-m.expense>=0?'+':'' %>฿<%= (m.income-m.expense).toLocaleString('th-TH',{minimumFractionDigits:2}) %>
          </td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr style="background:var(--primary-dim);">
          <td style="font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;">รวมทั้งปี</td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:#10b981;">฿<%= totalIncome.toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:#ef4444;">฿<%= totalExpense.toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
          <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:<%= netProfit>=0?'#10b981':'#ef4444' %>;">
            <%= netProfit>=0?'+':'' %>฿<%= netProfit.toLocaleString('th-TH',{minimumFractionDigits:2}) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
