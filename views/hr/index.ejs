<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1><%= tab === 'payroll' ? 'เงินเดือน' : tab === 'leave' ? 'วันลา' : 'พนักงาน' %></h1>
    <p>จัดการข้อมูลบุคลากร เงินเดือน และการลางาน</p>
  </div>
  <div style="display: flex; gap: 8px;">
    <% if (tab === 'employees') { %>
    <a href="/hr/employees/new" class="btn btn-orange">+ เพิ่มพนักงาน</a>
    <% } else if (tab === 'leave') { %>
    <button class="btn btn-orange" onclick="openModal('addLeaveModal')">+ บันทึกวันลา</button>
    <% } %>
  </div>
</div>

<div style="display: flex; gap: 4px; background: rgba(255,255,255,0.15); padding: 4px; border-radius: 50px; width: fit-content; margin-bottom: 24px; backdrop-filter: blur(8px);">
  <a href="/hr" class="btn btn-sm <%= tab === 'employees' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 50px; padding: 6px 16px; text-decoration: none;">พนักงาน</a>
  <a href="/hr/payroll" class="btn btn-sm <%= tab === 'payroll' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 50px; padding: 6px 16px; text-decoration: none;">เงินเดือน</a>
  <a href="/hr/leave" class="btn btn-sm <%= tab === 'leave' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 50px; padding: 6px 16px; text-decoration: none;">วันลา</a>
</div>

<% if (success && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error">⚠ <%= error[0] %></div><% } %>

<!-- TAB: พนักงาน -->
<% if (tab === 'employees') { %>
<div style="display: grid; grid-template-columns: 1fr 300px; gap: 24px; align-items: start;">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">รายชื่อพนักงานทั้งหมด (<%= employees.length %> คน)</h3>
      <div class="search-wrap" style="width: 240px;">
        <span class="search-icon">🔍</span>
        <input type="text" class="search-input" id="searchInput" oninput="filterTable()" placeholder="ค้นหาชื่อ, ตำแหน่ง...">
      </div>
    </div>
    <div class="table-wrap">
      <% if (employees.length > 0) { %>
      <table class="data-table" id="empTable">
        <thead>
          <tr>
            <th>รหัส</th>
            <th>ชื่อ-นามสกุล</th>
            <th>แผนก/ตำแหน่ง</th>
            <th>ประเภท</th>
            <th style="text-align:right;">เงินเดือน</th>
            <th style="text-align:center;">สถานะ</th>
            <th style="text-align:right;">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% employees.forEach(e => { %>
          <tr>
            <td style="font-size:12px; color:var(--text-muted); font-family:'Plus Jakarta Sans',sans-serif;"><%= e.code %></td>
            <td>
              <div style="font-weight:600;"><%= e.title ? e.title + ' ' : '' %><%= e.first_name %> <%= e.last_name %></div>
              <% if (e.nickname) { %><div style="font-size:11px; color:var(--text-muted);">(<%= e.nickname %>)</div><% } %>
            </td>
            <td>
              <div style="font-weight:500;"><%= e.dept?.name || '-' %></div>
              <div style="font-size:11px; color:var(--text-muted);"><%= e.position || '-' %></div>
            </td>
            <td>
              <span class="badge badge-gray">
                <%= e.employment_type==='full_time'?'ประจำ':e.employment_type==='part_time'?'พาร์ทไทม์':'สัญญาจ้าง' %>
              </span>
            </td>
            <td style="text-align:right; font-family:'Plus Jakarta Sans',sans-serif; font-weight:700;">฿<%= (parseFloat(e.base_salary)||0).toLocaleString('th-TH') %></td>
            <td style="text-align:center;">
              <% let sClass = e.status==='active'?'badge-success':e.status==='resigned'?'badge-orange':'badge-danger'; %>
              <span class="badge <%= sClass %>">
                <%= e.status==='active'?'ทำงาน':e.status==='resigned'?'ลาออก':'พ้นสภาพ' %>
              </span>
            </td>
            <td style="text-align:right;">
              <div style="display:flex; gap:6px; justify-content: flex-end;">
                <a href="/hr/employees/<%= e.id %>/edit" class="btn btn-secondary btn-xs">แก้ไข</a>
                <form action="/hr/employees/<%= e.id %>?_method=DELETE" method="POST" style="margin:0;" id="del_<%= e.id %>">
                  <button type="button" class="btn btn-xs" style="color: var(--danger); background: none; border: none; cursor: pointer;" onclick="if(confirm('ลบข้อมูลพนักงาน <%= e.first_name %>?')) document.getElementById('del_<%= e.id %>').submit()">🗑</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">👥</div>
        <div class="empty-title">ยังไม่มีข้อมูลพนักงาน</div>
      </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">แผนก</h3></div>
    <div class="card-body">
      <% departments.forEach(d => { %>
        <div style="padding: 10px 0; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; align-items: center;">
          <span style="font-weight: 500; font-size: 14px; color: var(--text-main);"><%= d.name %></span>
          <span class="badge badge-gray">DEPT</span>
        </div>
      <% }) %>
      <form action="/hr/departments" method="POST" style="margin-top: 20px; padding-top: 20px; border-top: 2px dashed var(--border);">
        <div class="form-group">
          <input type="text" name="name" class="form-control" placeholder="ชื่อแผนกใหม่" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">+ เพิ่มแผนก</button>
      </form>
    </div>
  </div>
</div>
<% } %>

<!-- TAB: เงินเดือน -->
<% if (tab === 'payroll') { %>
<div class="stats-grid stats-3">
  <div class="stat-card" style="background: var(--white); padding: 20px; border: 1px solid rgba(255,255,255,0.45);">
    <div class="stat-label">พนักงานทั้งหมด</div>
    <div class="stat-value"><%= employees.length %> <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">คน</span></div>
  </div>
  <div class="stat-card" style="background: var(--black); padding: 20px;">
    <div style="color: rgba(255,255,255,0.5); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">งบประมาณเงินเดือน/เดือน</div>
    <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 20px; font-weight: 800; color: #fff;">฿<%= employees.reduce((s,e)=>s+(parseFloat(e.base_salary)||0),0).toLocaleString('th-TH') %></div>
  </div>
  <div class="stat-card" style="background: var(--white); padding: 20px; border: 1px solid rgba(255,255,255,0.45);">
    <div class="stat-label">เฉลี่ยต่อคน</div>
    <div class="stat-value" style="font-size: 20px; color: var(--primary);">฿<%= employees.length > 0 ? Math.round(employees.reduce((s,e)=>s+(parseFloat(e.base_salary)||0),0)/employees.length).toLocaleString('th-TH') : '0' %></div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3 class="card-title">โครงสร้างเงินเดือนรายบุคคล</h3></div>
  <div class="table-wrap">
    <% if (employees.length > 0) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>รหัส</th><th>ชื่อ-นามสกุล</th><th>แผนก</th><th>ประเภทการจ่าย</th><th style="text-align:right;">เงินเดือนฐาน</th><th>บัญชีธนาคาร</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach(e => { %>
        <tr>
          <td style="font-size:12px; color:var(--text-muted);"><%= e.code %></td>
          <td style="font-weight:600;"><%= e.first_name %> <%= e.last_name %></td>
          <td style="font-weight: 500;"><%= e.dept?.name || '-' %></td>
          <td><span class="badge badge-gray"><%= e.salary_type==='monthly'?'รายเดือน':e.salary_type==='daily'?'รายวัน':'รายชั่วโมง' %></span></td>
          <td style="text-align:right; font-family:'Plus Jakarta Sans',sans-serif; font-weight:700;">฿<%= (parseFloat(e.base_salary)||0).toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
          <td style="font-size:12.5px; color:var(--text-muted);"><%= e.bank_name ? e.bank_name + ' ' + (e.bank_account||'') : '-' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state" style="padding: 40px;"><div class="empty-title">ไม่มีข้อมูล</div></div>
    <% } %>
  </div>
</div>
<% } %>

<!-- TAB: วันลา -->
<% if (tab === 'leave') { %>
<div class="card">
  <div class="card-header"><h3 class="card-title">รายการคำขอลาหยุด</h3></div>
  <div class="table-wrap">
    <% if (leaves && leaves.length > 0) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>พนักงาน</th><th>ประเภทการลา</th><th>วันที่</th><th style="text-align:center;">จำนวนวัน</th><th>เหตุผล</th><th style="text-align:center;">สถานะ</th><th style="text-align:right;">จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% const leaveTypeLabel = {annual:'ลาพักร้อน',sick:'ลาป่วย',personal:'ลากิจ',maternity:'ลาคลอด',ordain:'ลาบวช'} %>
        <% const leaveStatusClass = {pending:'badge-orange',approved:'badge-success',rejected:'badge-danger'} %>
        <% leaves.forEach(l => { %>
        <tr>
          <td style="font-weight:600;"><%= l.emp ? l.emp.first_name + ' ' + l.emp.last_name : '-' %></td>
          <td><span class="badge badge-gray"><%= leaveTypeLabel[l.leave_type] || l.leave_type %></span></td>
          <td style="font-size:13px; color: var(--text-muted);">
            <%= new Date(l.start_date).toLocaleDateString('th-TH') %> - <%= new Date(l.end_date).toLocaleDateString('th-TH') %>
          </td>
          <td style="text-align:center; font-family:'Plus Jakarta Sans',sans-serif; font-weight:700;"><%= l.days %></td>
          <td style="font-size:13px;"><%= l.reason || '-' %></td>
          <td style="text-align:center;"><span class="badge <%= leaveStatusClass[l.status] || 'badge-orange' %>"><%= l.status==='pending'?'รออนุมัติ':l.status==='approved'?'อนุมัติแล้ว':'ปฏิเสธ' %></span></td>
          <td style="text-align:right;">
            <% if (l.status === 'pending') { %>
            <div style="display:flex; gap:6px; justify-content: flex-end;">
              <form action="/hr/leave/<%= l.id %>/status?_method=PUT" method="POST" style="margin:0;"><input type="hidden" name="status" value="approved"><button type="submit" class="btn btn-secondary btn-xs" style="color: var(--success);">อนุมัติ</button></form>
              <form action="/hr/leave/<%= l.id %>/status?_method=PUT" method="POST" style="margin:0;"><input type="hidden" name="status" value="rejected"><button type="submit" class="btn btn-secondary btn-xs" style="color: var(--danger);">ปฏิเสธ</button></form>
            </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state" style="padding: 40px;"><div class="empty-title">ไม่มีรายการคำขอ</div></div>
    <% } %>
  </div>
</div>

<!-- Modal บันทึกวันลา -->
<div class="modal-overlay" id="addLeaveModal" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">บันทึกคำขอลา</span>
      <button class="modal-close" onclick="closeModal('addLeaveModal')">×</button>
    </div>
    <div class="modal-body">
      <form action="/hr/leave" method="POST">
        <div class="form-group">
          <label class="form-label">พนักงาน</label>
          <select name="employee_id" class="form-control" required>
            <option value="">เลือกพนักงาน</option>
            <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">ประเภทการลา</label>
          <select name="leave_type" class="form-control" required>
            <option value="annual">ลาพักร้อน</option>
            <option value="sick">ลาป่วย</option>
            <option value="personal">ลากิจ</option>
            <option value="maternity">ลาคลอด</option>
            <option value="ordain">ลาบวช</option>
          </select>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label class="form-label">วันที่เริ่ม</label>
            <input type="date" name="start_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">วันที่สิ้นสุด</label>
            <input type="date" name="end_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">จำนวนวัน</label>
            <input type="number" name="days" class="form-control" min="0.5" step="0.5" value="1" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">เหตุผลการลา</label>
          <textarea name="reason" class="form-control" rows="2" placeholder="ระบุเหตุผลการลา"></textarea>
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('addLeaveModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-orange">บันทึกคำขอ</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<script>
  function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase()
    document.querySelectorAll('#empTable tbody tr').forEach(row => {
      row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none'
    })
  }
</script>

<%- include('../partials/footer') %>
