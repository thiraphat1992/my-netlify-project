<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error — BizFlow</title>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Prompt', sans-serif;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh;
      background: #0d0d0d;
      color: #f5f5f5;
      padding: 20px;
    }
    .error-box { text-align: center; }
    .code {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 96px; font-weight: 800;
      background: linear-gradient(135deg, #ea580c, #fbbf24);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1; letter-spacing: -2px;
    }
    .msg { font-size: 18px; color: #a0a0a0; margin-top: 16px; }
    a { color: #f97316; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back-link { margin-top: 28px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="error-box">
    <div class="code"><%= typeof code !== 'undefined' ? code : '500' %></div>
    <div class="msg"><%= message || 'เกิดข้อผิดพลาด' %></div>
    <p class="back-link"><a href="/dashboard">← กลับหน้าหลัก</a></p>
  </div>
</body>
</html>
