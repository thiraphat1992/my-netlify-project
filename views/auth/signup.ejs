<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สมัครสมาชิก — BizFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #f97316;
      --glass-bg: rgba(255,255,255,0.72);
      --glass-border: rgba(255,255,255,0.35);
      --text-main: #1a1a1a;
      --text-muted: #5f5f5f;
      --input-bg: rgba(255,255,255,0.55);
      --radius-card: 28px;
      --radius-input: 12px;
      --radius-btn: 14px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      overflow-x: hidden;
    }

    /* Blobs */
    .blob {
      position: fixed; z-index: 0;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.55;
      animation: blobFloat 20s ease-in-out infinite alternate;
    }
    .blob-1 { width: 420px; height: 420px; background: #f97316; top: -120px; left: -100px; }
    .blob-2 { width: 360px; height: 360px; background: #3b82f6; bottom: -80px; right: -80px; animation-delay: -6s; }
    .blob-3 { width: 260px; height: 260px; background: #ec4899; top: 38%; left: 58%; animation-delay: -12s; }
    @keyframes blobFloat {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(40px, 30px) scale(1.08); }
    }

    .page-wrap {
      position: relative; z-index: 1;
      width: 100%; max-width: 480px;
      animation: fadeUp 0.6s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Logo */
    .logo-area {
      display: flex; align-items: center; justify-content: center; gap: 12px;
      margin-bottom: 26px;
    }
    .logo-mark {
      width: 44px; height: 44px;
      background: var(--text-main);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 22px; font-weight: 900; color: #fff;
      flex-shrink: 0;
    }
    .logo-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 23px; font-weight: 700; letter-spacing: -.4px; color: #fff;
    }
    .logo-text span { color: var(--primary); }

    /* Card */
    .form-card {
      background: var(--glass-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-card);
      padding: 44px 40px;
      box-shadow: 0 30px 60px -12px rgba(0,0,0,.28), 0 8px 20px rgba(0,0,0,.12);
    }

    .form-header { margin-bottom: 28px; text-align: center; }
    .form-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 26px; font-weight: 800; letter-spacing: -.5px;
      margin-bottom: 7px; color: var(--text-main);
    }
    .form-subtitle { font-size: 14.5px; color: var(--text-muted); }

    /* Alerts */
    .alert {
      padding: 13px 16px; border-radius: 12px;
      font-size: 13.5px; margin-bottom: 22px;
      display: flex; align-items: flex-start; gap: 10px; line-height: 1.5;
    }
    .alert svg { flex-shrink: 0; margin-top: 1px; }
    .alert-error   { background: rgba(220,38,38,.09);  border: 1px solid rgba(220,38,38,.2);  color: #c53030; }
    .alert-success { background: rgba(22,163,74,.09);  border: 1px solid rgba(22,163,74,.2);  color: #15803d; }

    /* Divider */
    .field-divider {
      display: flex; align-items: center; gap: 12px;
      margin: 20px 0;
    }
    .field-divider::before, .field-divider::after {
      content: ''; flex: 1; height: 1px;
      background: rgba(0,0,0,.08);
    }
    .field-divider span { font-size: 12px; color: var(--text-muted); white-space: nowrap; }

    /* Fields */
    .form-group { margin-bottom: 16px; }
    .form-group-row { display: grid; gap: 14px; }
    .form-label {
      display: block; font-size: 13px; font-weight: 600;
      margin-bottom: 7px; color: var(--text-main);
    }
    .input-wrap { position: relative; }
    .input-icon {
      position: absolute; left: 15px; top: 50%;
      transform: translateY(-50%);
      color: #9ca3af; pointer-events: none; display: flex; align-items: center;
      transition: color .2s;
    }
    .input-wrap:focus-within .input-icon { color: var(--primary); }
    .form-input {
      width: 100%;
      background: var(--input-bg); border: 1px solid rgba(0,0,0,.06);
      border-radius: var(--radius-input); padding: 13px 14px 13px 46px;
      font-family: 'Inter', sans-serif; font-size: 15px; color: var(--text-main);
      outline: none; transition: all .2s;
    }
    .form-input::placeholder { color: #b0b0b0; }
    .form-input:focus {
      background: #fff; border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(249,115,22,.12);
    }

    .field-hint { font-size: 12px; color: var(--text-muted); margin-top: 5px; }

    .toggle-password {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #9ca3af; padding: 5px; display: flex; align-items: center;
      transition: color .2s;
    }
    .toggle-password:hover { color: var(--text-main); }

    /* Button */
    .btn-submit {
      width: 100%;
      background: var(--text-main); color: #fff;
      border: none; border-radius: var(--radius-btn);
      padding: 15px 20px;
      font-family: 'Inter', sans-serif;
      font-size: 15.5px; font-weight: 700;
      cursor: pointer; transition: all .25s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      margin-top: 8px;
    }
    .btn-submit:hover {
      background: #000; transform: translateY(-2px);
      box-shadow: 0 12px 24px -6px rgba(0,0,0,.3);
    }
    .btn-submit:active { transform: translateY(0); box-shadow: none; }
    .btn-submit.loading { opacity: .75; pointer-events: none; }
    .loader {
      width: 18px; height: 18px;
      border: 2px solid rgba(255,255,255,.35);
      border-top-color: #fff; border-radius: 50%;
      animation: spin .75s linear infinite; display: none;
    }
    .btn-submit.loading .loader { display: block; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .terms-note {
      font-size: 12px; color: var(--text-muted); text-align: center;
      margin-top: 14px; line-height: 1.6;
    }
    .terms-note a { color: var(--text-main); font-weight: 600; text-decoration: underline; }

    /* Footer */
    .page-footer {
      text-align: center; margin-top: 22px;
      font-size: 14px; color: rgba(255,255,255,.75);
    }
    .page-footer a { color: #fff; font-weight: 700; text-decoration: none; }
    .page-footer a:hover { text-decoration: underline; }

    @media (max-width: 480px) { .form-card { padding: 32px 24px; } }
  </style>
</head>
<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="page-wrap">
    <div class="logo-area">
      <div class="logo-mark">B</div>
      <div class="logo-text">Biz<span>Flow</span></div>
    </div>

    <div class="form-card">
      <div class="form-header">
        <h2 class="form-title">สร้างบัญชีใหม่</h2>
        <p class="form-subtitle">เริ่มต้นจัดการธุรกิจของคุณด้วย BizFlow</p>
      </div>

      <% if (error && error.length > 0) { %>
      <div class="alert alert-error">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= error[0] %>
      </div>
      <% } %>
      <% if (success && success.length > 0) { %>
      <div class="alert alert-success">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= success[0] %>
      </div>
      <% } %>

      <form action="/signup" method="POST" id="signupForm">
        <div class="form-group">
          <label class="form-label">ชื่อ-นามสกุล</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </span>
            <input type="text" name="name" class="form-input" placeholder="สมชาย ใจดี" required autofocus>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">อีเมล</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <input type="email" name="email" class="form-input" placeholder="name@company.com" required>
          </div>
        </div>

        <div class="field-divider"><span>ตั้งรหัสผ่าน</span></div>

        <div class="form-group">
          <label class="form-label">รหัสผ่าน</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </span>
            <input type="password" id="pw1" name="password" class="form-input" placeholder="••••••••" required>
            <button type="button" class="toggle-password" onclick="togglePwd('pw1','eye1')">
              <svg id="eye1" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <div class="field-hint">อย่างน้อย 6 ตัวอักษร</div>
        </div>

        <div class="form-group">
          <label class="form-label">ยืนยันรหัสผ่าน</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </span>
            <input type="password" id="pw2" name="password_confirm" class="form-input" placeholder="••••••••" required>
            <button type="button" class="toggle-password" onclick="togglePwd('pw2','eye2')">
              <svg id="eye2" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <div class="loader"></div>
          <span id="btn-text">ลงทะเบียน</span>
        </button>

        <p class="terms-note">
          การลงทะเบียนถือว่าคุณยอมรับ
          <a href="#">ข้อกำหนดการใช้งาน</a> และ <a href="#">นโยบายความเป็นส่วนตัว</a>
        </p>
      </form>
    </div>

    <div class="page-footer">
      มีบัญชีอยู่แล้ว? <a href="/login">เข้าสู่ระบบ</a>
    </div>
  </div>

  <script>
    const eyeOpen   = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`
    const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`

    function togglePwd(fieldId, iconId) {
      const inp = document.getElementById(fieldId)
      const ico = document.getElementById(iconId)
      inp.type = inp.type === 'password' ? 'text' : 'password'
      ico.innerHTML = inp.type === 'text' ? eyeClosed : eyeOpen
    }

    document.getElementById('signupForm').addEventListener('submit', () => {
      const btn = document.getElementById('submitBtn')
      btn.classList.add('loading')
      document.getElementById('btn-text').textContent = 'กำลังสมัคร...'
    })
  </script>
</body>
</html>
