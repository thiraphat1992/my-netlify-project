<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สมัครสมาชิก — BizFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary: #f97316;
      --primary-dark: #ea580c;
      --primary-light: #fb923c;
      --primary-dim: rgba(249,115,22,0.12);
      --accent: #fbbf24;
      --bg: #0d0d0d;
      --surface: #171717;
      --text: #fafafa;
      --text-3: #a3a3a3;
      --text-4: #737373;
      --border: #2a2a2a;
      --shadow-primary: 0 8px 32px rgba(249,115,22,0.35);
      --radius-sm: 8px;
      --radius-full: 9999px;
      --error-bg: rgba(239,68,68,0.1);
      --error-border: rgba(239,68,68,0.3);
      --success-bg: rgba(34,197,94,0.1);
      --success-border: rgba(34,197,94,0.3);
    }

    body {
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 20px;
      color: var(--text);
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      width: 600px; height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%);
      top: -200px; right: -150px;
      pointer-events: none;
    }

    body::after {
      content: '';
      position: fixed;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(251,191,36,0.05) 0%, transparent 70%);
      bottom: -100px; left: -100px;
      pointer-events: none;
    }

    .form-container {
      width: 100%;
      max-width: 420px;
      position: relative;
      z-index: 1;
      animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .logo-area {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 28px;
    }

    .logo-mark {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--primary-dark), var(--accent));
      border-radius: 11px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 18px; font-weight: 800;
      color: #fff;
      box-shadow: 0 4px 14px rgba(249,115,22,0.35);
    }

    .logo-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 20px; font-weight: 700;
      color: var(--text);
    }

    .logo-text span { color: var(--primary); }

    .form-card {
      background: #171717;
      border: 1px solid #2a2a2a;
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    }

    .form-header { margin-bottom: 28px; }

    .form-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--primary);
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .form-eyebrow::before {
      content: '';
      width: 18px; height: 2px;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      border-radius: 2px;
    }

    .form-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 26px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    .form-subtitle {
      font-size: 14px;
      color: var(--text-4);
      line-height: 1.5;
    }

    .alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      margin-bottom: 22px;
      line-height: 1.5;
    }

    .alert-icon { flex-shrink: 0; margin-top: 1px; }

    .alert-error {
      background: var(--error-bg);
      border: 1px solid var(--error-border);
      color: #f87171;
    }

    .alert-success {
      background: var(--success-bg);
      border: 1px solid var(--success-border);
      color: #4ade80;
    }

    .form-group { margin-bottom: 16px; }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-3);
      margin-bottom: 7px;
    }

    .input-wrap { position: relative; }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-4);
      font-size: 15px;
      pointer-events: none;
      transition: color 0.2s;
      display: flex;
      align-items: center;
    }

    .input-wrap:focus-within .input-icon { color: var(--primary); }

    .form-input {
      width: 100%;
      background: #111111;
      border: 1.5px solid #2a2a2a;
      border-radius: var(--radius-sm);
      padding: 12px 14px 12px 42px;
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 14.5px;
      color: var(--text);
      outline: none;
      transition: all 0.2s;
      -webkit-appearance: none;
    }

    .form-input::placeholder { color: var(--text-4); font-size: 13.5px; }

    .form-input:focus {
      border-color: var(--primary);
      background: #0f0f0f;
      box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
    }

    .form-input:hover:not(:focus) { border-color: #3a3a3a; background: #0f0f0f; }

    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, var(--primary-dark), var(--primary));
      border: none;
      border-radius: 50px;
      padding: 14px;
      font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      transition: all 0.25s;
      letter-spacing: 0.2px;
      box-shadow: var(--shadow-primary);
      margin-top: 8px;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 36px rgba(249,115,22,0.45);
    }

    .btn-submit:active { transform: translateY(0); }

    .form-footer {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
      color: var(--text-4);
    }

    .form-footer a { color: var(--primary); text-decoration: none; font-weight: 500; }
    .form-footer a:hover { color: var(--primary-light); text-decoration: underline; }

    @media (max-width: 480px) {
      .form-card { padding: 28px 20px; }
    }
  </style>
</head>
<body>
  <div class="form-container">
    <div class="logo-area">
      <div class="logo-mark">B</div>
      <div class="logo-text">Biz<span>Flow</span></div>
    </div>

    <div class="form-card">
      <div class="form-header">
        <div class="form-eyebrow">สมัครสมาชิก</div>
        <h2 class="form-title">เข้าร่วม BizFlow</h2>
        <p class="form-subtitle">สร้างบัญชีเพื่อเริ่มใช้ระบบจัดการธุรกิจ</p>
      </div>

      <% if (error && error.length > 0) { %>
        <div class="alert alert-error">
          <span class="alert-icon">⚠️</span>
          <span><%= error[0] %></span>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success">
          <span class="alert-icon">✓</span>
          <span><%= success[0] %></span>
        </div>
      <% } %>

      <form action="/signup" method="POST">
        <div class="form-group">
          <label class="form-label" for="name">ชื่อเต็ม</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </span>
            <input type="text" id="name" name="name" class="form-input" placeholder="ชื่อจริง นามสกุล" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">อีเมล</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <input type="email" id="email" name="email" class="form-input" placeholder="your@email.com" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">รหัสผ่าน</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </span>
            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required>
          </div>
          <div style="font-size:12px;color:var(--text-4);margin-top:5px;">อย่างน้อย 6 ตัวอักษร</div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password_confirm">ยืนยันรหัสผ่าน</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </span>
            <input type="password" id="password_confirm" name="password_confirm" class="form-input" placeholder="••••••••" required>
          </div>
        </div>

        <button type="submit" class="btn-submit">สมัครสมาชิก</button>
      </form>
    </div>

    <div class="form-footer" style="margin-top:20px;">
      มีบัญชีแล้ว? <a href="/login">เข้าสู่ระบบ</a>
    </div>
  </div>
</body>
</html>
