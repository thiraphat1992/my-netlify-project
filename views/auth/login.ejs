<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เข้าสู่ระบบ — BizFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #f97316;
      --glass-bg: rgba(255,255,255,0.72);
      --glass-border: rgba(255,255,255,0.35);
      --text-main: #1a1a1a;
      --text-muted: #5f5f5f;
      --input-bg: rgba(255,255,255,0.55);
      --radius-card: 28px;
      --radius-input: 12px;
      --radius-btn: 14px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-main);
      padding: 24px 20px;
      overflow-x: hidden;
    }

    /* Blobs */
    .blob {
      position: fixed;
      z-index: 0;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.55;
      animation: blobFloat 20s ease-in-out infinite alternate;
    }
    .blob-1 { width: 420px; height: 420px; background: #f97316; top: -120px; left: -100px; }
    .blob-2 { width: 360px; height: 360px; background: #3b82f6; bottom: -80px; right: -80px; animation-delay: -6s; }
    .blob-3 { width: 260px; height: 260px; background: #ec4899; top: 38%; left: 58%; animation-delay: -12s; }
    @keyframes blobFloat {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(40px, 30px) scale(1.08); }
    }

    /* Main glass card */
    .main-container {
      position: relative; z-index: 1;
      width: 100%; max-width: 980px;
      display: flex;
      background: var(--glass-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-card);
      box-shadow: 0 30px 60px -12px rgba(0,0,0,0.28), 0 8px 20px rgba(0,0,0,0.12);
      overflow: hidden;
      animation: fadeUp 0.7s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ══ LEFT PANEL ══ */
    .panel-left {
      width: 44%;
      padding: 56px 52px;
      background: rgba(0,0,0,0.04);
      border-right: 1px solid var(--glass-border);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .logo-area {
      display: flex; align-items: center; gap: 12px;
    }
    .logo-mark {
      width: 44px; height: 44px;
      background: var(--text-main);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 22px; font-weight: 900; color: #fff;
      flex-shrink: 0;
    }
    .logo-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 23px; font-weight: 700; letter-spacing: -.4px;
      color: var(--text-main);
    }
    .logo-text span { color: var(--primary); }

    .hero-content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 48px 0 32px; }
    .hero-content h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 40px; font-weight: 900;
      line-height: 1.1; letter-spacing: -1.5px;
      margin-bottom: 18px; color: var(--text-main);
    }
    .hero-content h1 em { font-style: normal; color: var(--primary); }
    .hero-sub {
      font-size: 15px; color: var(--text-muted); line-height: 1.7;
    }

    .features-list { display: grid; gap: 11px; }
    .feature-item {
      display: flex; align-items: center; gap: 10px;
      font-size: 14px; font-weight: 500; color: var(--text-main);
    }
    .feature-icon {
      width: 22px; height: 22px; border-radius: 50%;
      background: rgba(249,115,22,0.15);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      color: var(--primary); font-size: 12px;
    }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      width: 56%;
      padding: 56px 52px;
      display: flex; flex-direction: column; justify-content: center;
    }

    .form-header { margin-bottom: 28px; }
    .form-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 30px; font-weight: 800; letter-spacing: -.5px;
      margin-bottom: 7px; color: var(--text-main);
    }
    .form-subtitle { font-size: 15px; color: var(--text-muted); }

    /* Alerts */
    .alert {
      padding: 13px 16px;
      border-radius: 12px;
      font-size: 13.5px;
      margin-bottom: 22px;
      display: flex; align-items: flex-start; gap: 10px;
      line-height: 1.5;
    }
    .alert svg { flex-shrink: 0; margin-top: 1px; }
    .alert-error   { background: rgba(220,38,38,.09);  border: 1px solid rgba(220,38,38,.2);  color: #c53030; }
    .alert-success { background: rgba(22,163,74,.09);  border: 1px solid rgba(22,163,74,.2);  color: #15803d; }

    /* Form */
    .form-group { margin-bottom: 18px; }
    .form-label {
      display: block; font-size: 13px; font-weight: 600;
      margin-bottom: 7px; color: var(--text-main);
    }

    .input-wrap { position: relative; }
    .input-icon {
      position: absolute; left: 15px; top: 50%;
      transform: translateY(-50%);
      color: #9ca3af; pointer-events: none;
      display: flex; align-items: center;
      transition: color .2s;
    }
    .input-wrap:focus-within .input-icon { color: var(--primary); }

    .form-input {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: var(--radius-input);
      padding: 13px 14px 13px 46px;
      font-family: 'Inter', sans-serif;
      font-size: 15px; color: var(--text-main);
      outline: none; transition: all .2s;
    }
    .form-input::placeholder { color: #b0b0b0; }
    .form-input:focus {
      background: #fff;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(249,115,22,.12);
    }

    .toggle-password {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #9ca3af; padding: 5px; display: flex; align-items: center;
      transition: color .2s;
    }
    .toggle-password:hover { color: var(--text-main); }

    .form-options {
      display: flex; align-items: center;
      justify-content: space-between; margin-bottom: 26px;
    }
    .remember-me {
      display: flex; align-items: center; gap: 8px;
      font-size: 13.5px; color: var(--text-muted); cursor: pointer;
    }
    .remember-me input[type="checkbox"] { accent-color: var(--primary); width: 15px; height: 15px; }
    .forgot-link {
      font-size: 13.5px; color: var(--primary); font-weight: 600;
      text-decoration: none; transition: opacity .2s;
    }
    .forgot-link:hover { opacity: .75; }

    /* Button */
    .btn-login {
      width: 100%;
      background: var(--text-main); color: #fff;
      border: none; border-radius: var(--radius-btn);
      padding: 15px 20px;
      font-family: 'Inter', sans-serif;
      font-size: 15.5px; font-weight: 700;
      cursor: pointer; transition: all .25s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-login:hover {
      background: #000;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -6px rgba(0,0,0,.3);
    }
    .btn-login:active { transform: translateY(0); box-shadow: none; }
    .btn-login.loading { opacity: .75; pointer-events: none; }

    .loader {
      width: 18px; height: 18px;
      border: 2px solid rgba(255,255,255,.35);
      border-top-color: #fff; border-radius: 50%;
      animation: spin .75s linear infinite;
      display: none;
    }
    .btn-login.loading .loader { display: block; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .form-footer {
      margin-top: 28px; text-align: center;
      font-size: 14px; color: var(--text-muted);
    }
    .form-footer a { color: var(--text-main); font-weight: 700; text-decoration: none; }
    .form-footer a:hover { text-decoration: underline; }

    /* Responsive */
    @media (max-width: 860px) {
      .main-container { flex-direction: column; max-width: 480px; }
      .panel-left  { width: 100%; padding: 36px 36px 28px; border-right: none; border-bottom: 1px solid var(--glass-border); }
      .panel-right { width: 100%; padding: 36px; }
      .hero-content { padding: 24px 0 20px; }
      .hero-content h1 { font-size: 30px; }
    }
    @media (max-width: 500px) {
      .panel-left { display: none; }
      .panel-right { padding: 32px 24px; }
    }
  </style>
</head>
<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="main-container">
    <!-- LEFT -->
    <div class="panel-left">
      <div class="logo-area">
        <div class="logo-mark">B</div>
        <div class="logo-text">Biz<span>Flow</span></div>
      </div>

      <div class="hero-content">
        <h1>บริหารธุรกิจ<br>ให้ <em>ง่ายขึ้น</em></h1>
        <p class="hero-sub">
          จัดการรายรับ-รายจ่าย, สต็อกสินค้า และระบบ HR<br>ครบจบในที่เดียว ด้วยเทคโนโลยีที่ทันสมัย
        </p>
      </div>

      <div class="features-list">
        <div class="feature-item">
          <span class="feature-icon">
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          บันทึกบัญชีรายวันอัตโนมัติ
        </div>
        <div class="feature-item">
          <span class="feature-icon">
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          ออกใบกำกับภาษีได้ทันที
        </div>
        <div class="feature-item">
          <span class="feature-icon">
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          เชื่อมต่อ Shopee / Lazada
        </div>
        <div class="feature-item">
          <span class="feature-icon">
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          ระบบ HR และเงินเดือน
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="panel-right">
      <div class="form-header">
        <h2 class="form-title">ยินดีต้อนรับ</h2>
        <p class="form-subtitle">เข้าสู่ระบบเพื่อจัดการธุรกิจของคุณ</p>
      </div>

      <% if (error && error.length > 0) { %>
      <div class="alert alert-error">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= error[0] %>
      </div>
      <% } %>
      <% if (success && success.length > 0) { %>
      <div class="alert alert-success">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= success[0] %>
      </div>
      <% } %>

      <form action="/login" method="POST" id="loginForm">
        <div class="form-group">
          <label class="form-label" for="email">อีเมล</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <input type="email" id="email" name="email" class="form-input" placeholder="name@company.com" autocomplete="email" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">รหัสผ่าน</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </span>
            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" autocomplete="current-password" required>
            <button type="button" class="toggle-password" onclick="togglePwd()">
              <svg id="eye-icon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-options">
          <label class="remember-me">
            <input type="checkbox" name="remember"> จดจำฉันไว้
          </label>
          <a href="/forgot-password" class="forgot-link">ลืมรหัสผ่าน?</a>
        </div>

        <button type="submit" class="btn-login" id="submitBtn">
          <div class="loader"></div>
          <span id="btn-text">เข้าสู่ระบบ</span>
        </button>
      </form>

      <div class="form-footer">
        ยังไม่มีบัญชี? <a href="/signup">ลงทะเบียนใหม่</a>
      </div>
    </div>
  </div>

  <script>
    const eyeOpen   = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`
    const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`

    function togglePwd() {
      const inp = document.getElementById('password')
      const ico = document.getElementById('eye-icon')
      inp.type = inp.type === 'password' ? 'text' : 'password'
      ico.innerHTML = inp.type === 'text' ? eyeClosed : eyeOpen
    }

    document.getElementById('loginForm').addEventListener('submit', () => {
      const btn = document.getElementById('submitBtn')
      btn.classList.add('loading')
      document.getElementById('btn-text').textContent = 'กำลังเข้าสู่ระบบ...'
    })

    const remEmail = document.cookie.split('; ').find(r => r.startsWith('rememberedEmail='))
    if (remEmail) {
      document.getElementById('email').value = decodeURIComponent(remEmail.split('=')[1])
      document.querySelector('input[name="remember"]').checked = true
    }
  </script>
</body>
</html>
