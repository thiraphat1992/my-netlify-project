<%- include('../partials/header') %>

<%
  let totalIncome = 0, totalExpense = 0
  if (transactions && transactions.length > 0) {
    transactions.forEach(t => {
      if (t.type === 'income') totalIncome += Number(t.amount)
      if (t.type === 'expense') totalExpense += Number(t.amount)
    })
  }
  const balance = totalIncome - totalExpense
%>

<div class="page-header">
  <div>
    <h1>รายรับ-รายจ่าย</h1>
    <p>บันทึกและจัดการรายการบัญชีทั้งหมดของธุรกิจ</p>
  </div>
  <div style="display: flex; gap: 8px;">
    <a href="/income/categories" class="btn btn-secondary btn-sm">หมวดหมู่</a>
    <button class="btn btn-orange btn-sm" onclick="openModal('addModal')">+ เพิ่มรายการ</button>
  </div>
</div>

<div class="stats-grid stats-3">
  <div class="stat-card" style="background: var(--white); padding: 20px; border: 1px solid rgba(255,255,255,0.45);">
    <div class="stat-label">รายรับรวม</div>
    <div class="stat-value" style="font-size: 22px; color: var(--success);">฿<%= totalIncome.toLocaleString('th-TH',{minimumFractionDigits:2}) %></div>
  </div>
  <div class="stat-card" style="background: var(--white); padding: 20px; border: 1px solid rgba(255,255,255,0.45);">
    <div class="stat-label">รายจ่ายรวม</div>
    <div class="stat-value" style="font-size: 22px; color: var(--danger);">฿<%= totalExpense.toLocaleString('th-TH',{minimumFractionDigits:2}) %></div>
  </div>
  <div class="stat-card" style="background: var(--black); padding: 20px;">
    <div style="color: rgba(255,255,255,0.5); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">คงเหลือสุทธิ</div>
    <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 22px; font-weight: 800; color: #fff;">฿<%= balance.toLocaleString('th-TH',{minimumFractionDigits:2}) %></div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (typeof error !== 'undefined' && error.length > 0) { %><div class="alert alert-error">⚠ <%= error[0] %></div><% } %>

<div class="card">
  <div class="card-header">
    <div style="display: flex; gap: 4px; background: rgba(0,0,0,0.06); padding: 4px; border-radius: 50px;">
      <button class="btn btn-sm tab-btn active" id="tab-all" onclick="filterType('all')" style="border-radius: 50px; padding: 5px 14px;">ทั้งหมด</button>
      <button class="btn btn-sm tab-btn btn-secondary" id="tab-income" onclick="filterType('income')" style="border-radius: 50px; padding: 5px 14px;">รายรับ</button>
      <button class="btn btn-sm tab-btn btn-secondary" id="tab-expense" onclick="filterType('expense')" style="border-radius: 50px; padding: 5px 14px;">รายจ่าย</button>
    </div>
    <div class="search-wrap" style="width: 280px;">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" id="searchInput" oninput="applyFilter()" placeholder="ค้นหารายการ...">
    </div>
  </div>
  <div class="table-wrap">
    <% if (transactions && transactions.length > 0) { %>
    <table class="data-table" id="txTable">
      <thead>
        <tr>
          <th>วันที่</th>
          <th>ประเภท</th>
          <th>หมวดหมู่</th>
          <th>รายละเอียด</th>
          <th style="text-align:right;">จำนวนเงิน</th>
          <th style="text-align:center;">จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(t => { %>
          <tr data-type="<%= t.type %>">
            <td style="color:var(--text-muted); font-size:13px; white-space:nowrap;">
              <%= new Date(t.transaction_date).toLocaleDateString('th-TH', {day:'numeric', month:'short', year:'2-digit'}) %>
            </td>
            <td>
              <span class="badge <%= t.type === 'income' ? 'badge-success' : 'badge-danger' %>">
                <%= t.type === 'income' ? '▲ รายรับ' : '▼ รายจ่าย' %>
              </span>
            </td>
            <td style="font-size:13px; font-weight:500;"><%= t.category ? t.category.name : '-' %></td>
            <td style="font-weight:500;"><%= t.description %></td>
            <td style="text-align:right; font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; color:<%= t.type === 'income' ? '#10b981' : '#ef4444' %>;">
              <%= t.type === 'income' ? '+' : '-' %>฿<%= Number(t.amount).toLocaleString('th-TH',{minimumFractionDigits:2}) %>
            </td>
            <td style="text-align:center;">
              <div style="display:flex; gap:6px; justify-content:center;">
                <button type="button" class="btn btn-secondary btn-xs"
                  data-id="<%= t.id %>" data-type="<%= t.type %>" data-date="<%= t.transaction_date %>"
                  data-category="<%= t.category_id %>" data-desc="<%= t.description %>" data-amount="<%= t.amount %>"
                  onclick="openEditModal(this)">แก้ไข</button>
                <form action="/income/<%= t.id %>?_method=DELETE" method="POST" style="margin:0;" id="del_<%= t.id %>">
                  <button type="button" class="btn btn-xs" style="color: var(--danger); padding: 4px; background: none; border: none; cursor: pointer;" onclick="if(confirm('ลบรายการนี้?')) document.getElementById('del_<%= t.id %>').submit()">🗑</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">📭</div>
      <div class="empty-title">ยังไม่มีรายการบัญชี</div>
      <div class="empty-desc">เริ่มบันทึกรายการแรกโดยคลิก "+ เพิ่มรายการ"</div>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal เพิ่มรายการ -->
<div class="modal-overlay" id="addModal" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">เพิ่มรายรับ-รายจ่าย</span>
      <button class="modal-close" onclick="closeModal('addModal')">×</button>
    </div>
    <div class="modal-body">
      <form action="/income" method="POST">
        <div class="form-group">
          <label class="form-label">ประเภทรายการ</label>
          <div style="display: flex; gap: 16px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px;">
              <input type="radio" name="type" value="income" required style="accent-color: var(--success);"> รายรับ
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px;">
              <input type="radio" name="type" value="expense" required checked style="accent-color: var(--danger);"> รายจ่าย
            </label>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">วันที่</label>
            <input type="date" id="add_date" name="transaction_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">หมวดหมู่</label>
            <select name="category_id" class="form-control" required>
              <option value="" disabled selected>เลือกหมวดหมู่</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>">[<%= cat.type === 'income' ? 'รับ' : 'จ่าย' %>] <%= cat.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">รายละเอียด</label>
          <input type="text" name="description" class="form-control" placeholder="ระบุรายละเอียดรายการ" required>
        </div>
        <div class="form-group">
          <label class="form-label">จำนวนเงิน (฿)</label>
          <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required min="0">
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-orange">บันทึกรายการ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal แก้ไขรายการ -->
<div class="modal-overlay" id="editModal" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">แก้ไขรายการบัญชี</span>
      <button class="modal-close" onclick="closeModal('editModal')">×</button>
    </div>
    <div class="modal-body">
      <form id="editForm" method="POST">
        <div class="form-group">
          <label class="form-label">ประเภทรายการ</label>
          <div style="display: flex; gap: 16px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px;">
              <input type="radio" name="type" value="income" id="editTypeIncome" style="accent-color: var(--success);"> รายรับ
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px;">
              <input type="radio" name="type" value="expense" id="editTypeExpense" style="accent-color: var(--danger);"> รายจ่าย
            </label>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">วันที่</label>
            <input type="date" id="editDate" name="transaction_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">หมวดหมู่</label>
            <select id="editCategory" name="category_id" class="form-control" required>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>">[<%= cat.type === 'income' ? 'รับ' : 'จ่าย' %>] <%= cat.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">รายละเอียด</label>
          <input type="text" id="editDesc" name="description" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">จำนวนเงิน (฿)</label>
          <input type="number" step="0.01" id="editAmount" name="amount" class="form-control" required min="0">
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-orange">อัปเดตรายการ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('add_date').valueAsDate = new Date()

  function openEditModal(btn) {
    document.getElementById('editForm').action = '/income/' + btn.dataset.id + '?_method=PUT'
    document.getElementById(btn.dataset.type === 'income' ? 'editTypeIncome' : 'editTypeExpense').checked = true
    document.getElementById('editDate').value = btn.dataset.date
    document.getElementById('editCategory').value = btn.dataset.category
    document.getElementById('editDesc').value = btn.dataset.desc
    document.getElementById('editAmount').value = btn.dataset.amount
    openModal('editModal')
  }

  let currentType = 'all'
  function filterType(type) {
    currentType = type
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('active', 'btn-primary')
      b.classList.add('btn-secondary')
    })
    const activeBtn = document.getElementById('tab-' + type)
    activeBtn.classList.add('active', 'btn-primary')
    activeBtn.classList.remove('btn-secondary')
    applyFilter()
  }

  function applyFilter() {
    const q = document.getElementById('searchInput').value.toLowerCase()
    document.querySelectorAll('#txTable tbody tr').forEach(row => {
      const matchType = currentType === 'all' || row.dataset.type === currentType
      const matchQ = !q || row.textContent.toLowerCase().includes(q)
      row.style.display = matchType && matchQ ? '' : 'none'
    })
  }
</script>

<%- include('../partials/footer') %>
