<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>สินค้า</h1>
    <p>จัดการรายการสินค้าและบริการทั้งหมด</p>
  </div>
  <button class="btn btn-primary" onclick="openModal('addModal')">+ เพิ่มสินค้า</button>
</div>

<% if (success && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error">⚠ <%= error[0] %></div><% } %>

<!-- Stats -->
<div class="stats-grid stats-3" style="margin-bottom:20px;">
  <div class="stat-card">
    <div class="stat-label">สินค้าทั้งหมด</div>
    <div class="stat-value"><%= products.length %></div>
    <div class="stat-sub">รายการ</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">มูลค่าต้นทุนรวม</div>
    <div class="stat-value" style="font-size:20px;">฿<%= products.reduce((s,p)=>s+(parseFloat(p.cost_price)||0)*(parseFloat(p.stock_qty)||0),0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
    <div class="stat-sub">คำนวณจากสต็อก × ต้นทุน</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">สินค้าที่ใช้งาน</div>
    <div class="stat-value"><%= products.filter(p=>p.is_active).length %></div>
    <div class="stat-sub">รายการ active</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">รายการสินค้าทั้งหมด</span>
    <div class="search-wrap" style="width:260px;">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" id="searchInput" placeholder="ค้นหาสินค้า..." oninput="filterTable()">
    </div>
  </div>
  <div class="table-wrap">
    <% if (products.length > 0) { %>
    <table class="data-table" id="productTable">
      <thead>
        <tr>
          <th>รหัส</th>
          <th>ชื่อสินค้า</th>
          <th>หมวดหมู่</th>
          <th>หน่วย</th>
          <th style="text-align:right;">ราคาทุน</th>
          <th style="text-align:right;">ราคาขาย</th>
          <th style="text-align:right;">สต็อก</th>
          <th style="text-align:center;">VAT</th>
          <th style="text-align:center;">จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td style="font-family:'Plus Jakarta Sans',sans-serif;font-size:12.5px;color:var(--text-3)"><%= p.code || '-' %></td>
            <td style="font-weight:600;"><%= p.name %></td>
            <td><%= p.category?.name || '-' %></td>
            <td><%= p.unit %></td>
            <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;">฿<%= (parseFloat(p.cost_price)||0).toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
            <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;color:var(--primary);">฿<%= (parseFloat(p.retail_price)||0).toLocaleString('th-TH',{minimumFractionDigits:2}) %></td>
            <td style="text-align:right;font-family:'Plus Jakarta Sans',sans-serif;<%= parseFloat(p.stock_qty)<=parseFloat(p.min_stock)?'color:#ef4444;font-weight:700;':'' %>"><%= (parseFloat(p.stock_qty)||0).toLocaleString('th-TH') %></td>
            <td style="text-align:center;">
              <span class="badge <%= p.vat_type==='vat7'?'badge-primary':p.vat_type==='exempt'?'badge-gray':'badge-info' %>">
                <%= p.vat_type==='vat7'?'VAT 7%':p.vat_type==='vat0'?'VAT 0%':'ยกเว้น' %>
              </span>
            </td>
            <td style="text-align:center;">
              <div style="display:flex;gap:6px;justify-content:center;">
                <button class="btn btn-secondary btn-xs"
                  data-id="<%= p.id %>" data-code="<%= p.code || '' %>" data-name="<%= p.name %>"
                  data-catid="<%= p.category_id || '' %>" data-unit="<%= p.unit || '' %>"
                  data-cost="<%= p.cost_price || 0 %>" data-retail="<%= p.retail_price || 0 %>"
                  data-stock="<%= p.stock_qty || 0 %>" data-vat="<%= p.vat_type || 'vat7' %>"
                  onclick="openEdit(this.dataset)">แก้ไข</button>
                <form action="/products/<%= p.id %>?_method=DELETE" method="POST" style="margin:0;" onsubmit="return confirm('ลบสินค้า <%= p.name %>?')">
                  <button type="submit" class="btn btn-danger btn-xs">ลบ</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <div class="empty-title">ยังไม่มีสินค้า</div>
      <div class="empty-desc">คลิก "+ เพิ่มสินค้า" เพื่อเริ่มต้น</div>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal เพิ่มสินค้า -->
<div class="modal-overlay" id="addModal">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">เพิ่มสินค้าใหม่</span>
      <button class="modal-close" onclick="closeModal('addModal')">×</button>
    </div>
    <div class="modal-body">
      <form action="/products" method="POST">
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">รหัสสินค้า</label>
            <input type="text" name="code" class="form-control" placeholder="เช่น P001">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อสินค้า *</label>
            <input type="text" name="name" class="form-control" required placeholder="ชื่อสินค้า">
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">หมวดหมู่</label>
            <select name="category_id" class="form-control">
              <option value="">-- เลือกหมวดหมู่ --</option>
              <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">หน่วย</label>
            <input type="text" name="unit" class="form-control" value="ชิ้น" placeholder="ชิ้น, กล่อง, กก.">
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label class="form-label">ราคาทุน (฿)</label>
            <input type="number" step="0.01" name="cost_price" class="form-control" placeholder="0.00">
          </div>
          <div class="form-group">
            <label class="form-label">ราคาขาย (฿)</label>
            <input type="number" step="0.01" name="retail_price" class="form-control" placeholder="0.00">
          </div>
          <div class="form-group">
            <label class="form-label">จำนวนสต็อก</label>
            <input type="number" step="0.001" name="stock_qty" class="form-control" placeholder="0">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ประเภท VAT</label>
          <select name="vat_type" class="form-control">
            <option value="vat7">VAT 7%</option>
            <option value="vat0">VAT 0%</option>
            <option value="exempt">ยกเว้น VAT</option>
          </select>
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-primary">บันทึกสินค้า</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal แก้ไขสินค้า -->
<div class="modal-overlay" id="editModal">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">แก้ไขสินค้า</span>
      <button class="modal-close" onclick="closeModal('editModal')">×</button>
    </div>
    <div class="modal-body">
      <form id="editForm" method="POST">
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">รหัสสินค้า</label>
            <input type="text" name="code" id="edit_code" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">ชื่อสินค้า *</label>
            <input type="text" name="name" id="edit_name" class="form-control" required>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label class="form-label">หมวดหมู่</label>
            <select name="category_id" id="edit_category" class="form-control">
              <option value="">-- เลือกหมวดหมู่ --</option>
              <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">หน่วย</label>
            <input type="text" name="unit" id="edit_unit" class="form-control">
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label class="form-label">ราคาทุน (฿)</label>
            <input type="number" step="0.01" name="cost_price" id="edit_cost" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">ราคาขาย (฿)</label>
            <input type="number" step="0.01" name="retail_price" id="edit_retail" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">จำนวนสต็อก</label>
            <input type="number" step="0.001" name="stock_qty" id="edit_stock" class="form-control">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ประเภท VAT</label>
          <select name="vat_type" id="edit_vat" class="form-control">
            <option value="vat7">VAT 7%</option>
            <option value="vat0">VAT 0%</option>
            <option value="exempt">ยกเว้น VAT</option>
          </select>
        </div>
        <div class="modal-footer" style="padding:0;border:none;margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-primary">บันทึกการแก้ไข</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openModal(id) { document.getElementById(id).classList.add('active') }
  function closeModal(id) { document.getElementById(id).classList.remove('active') }
  window.onclick = e => { if (e.target.classList.contains('modal-overlay')) e.target.classList.remove('active') }

  function openEdit(d) {
    document.getElementById('editForm').action = `/products/${d.id}?_method=PUT`
    document.getElementById('edit_code').value = d.code || ''
    document.getElementById('edit_name').value = d.name || ''
    document.getElementById('edit_category').value = d.catid || ''
    document.getElementById('edit_unit').value = d.unit || 'ชิ้น'
    document.getElementById('edit_cost').value = d.cost || 0
    document.getElementById('edit_retail').value = d.retail || 0
    document.getElementById('edit_stock').value = d.stock || 0
    document.getElementById('edit_vat').value = d.vat || 'vat7'
    openModal('editModal')
  }

  function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase()
    document.querySelectorAll('#productTable tbody tr').forEach(row => {
      row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none'
    })
  }
</script>

<%- include('../partials/footer') %>
