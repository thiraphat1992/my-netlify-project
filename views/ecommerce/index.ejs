<!-- ═══════ Modal: QR Payment ═══════ -->
<div class="modal-overlay" id="qrModal">
  <div class="modal-box" style="max-width:400px;">
    <div class="modal-header">
      <div class="modal-title">💳 QR PromptPay รับเงิน</div>
      <button class="modal-close" onclick="closeModal('qrModal')">×</button>
    </div>
    <div class="modal-body" style="text-align:center;">
      <div class="form-row form-row-2" style="text-align:left;margin-bottom:16px;">
        <div class="form-group" style="margin:0;">
          <label class="form-label">เบอร์โทร / เลขบัตรประชาชน / Tax ID</label>
          <input type="text" id="qrPromptPayId" class="form-control" placeholder="0XX-XXX-XXXX" oninput="renderQR()">
        </div>
        <div class="form-group" style="margin:0;">
          <label class="form-label">จำนวนเงิน (บาท)</label>
          <input type="number" id="qrAmount" class="form-control" placeholder="0.00" step="0.01" min="0" oninput="renderQR()">
        </div>
      </div>
      <!-- ปรับแต่งกรอบ + โลโก้ -->
      <div style="display:flex;gap:8px;margin:10px 0 12px;text-align:left;align-items:flex-end;">
        <div>
          <label style="font-size:11.5px;font-weight:600;color:var(--text-3);display:block;margin-bottom:4px;">🎨 สีกรอบ</label>
          <input type="color" id="qrFrameColor" value="#1a56db"
            style="width:48px;height:36px;border:1.5px solid var(--border);border-radius:8px;cursor:pointer;padding:2px;background:none;"
            oninput="renderQR()">
        </div>
        <div style="flex:1;">
          <label style="font-size:11.5px;font-weight:600;color:var(--text-3);display:block;margin-bottom:4px;">🖼️ URL โลโก้ตรงกลาง (ไม่บังคับ)</label>
          <input type="url" id="qrLogoUrl" class="form-control" style="font-size:12.5px;"
            placeholder="https://... ลิงก์รูปโลโก้ร้าน" oninput="renderQR()">
        </div>
      </div>

      <div id="qrCanvas" style="display:flex;justify-content:center;margin:0 0 8px;"></div>
      <div id="qrStatus" style="font-size:12px;color:var(--text-4);margin-bottom:4px;">กรอกเบอร์โทร/Tax ID เพื่อสร้าง QR</div>

      <!-- ข้อความอัตโนมัติ -->
      <div style="text-align:left;margin-top:14px;border-top:1px solid var(--border);padding-top:14px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
          <label style="font-size:12.5px;font-weight:600;color:var(--text-2);">💬 ข้อความส่งพร้อม QR</label>
          <button type="button" class="btn btn-secondary btn-xs" onclick="saveQRTemplate()">💾 บันทึก</button>
        </div>
        <textarea id="qrAutoMsg" class="form-control" rows="3"
          style="font-size:13px;resize:vertical;"
          placeholder="เช่น: กรุณาโอน {amount} บาท&#10;บัญชี: ชื่อร้าน&#10;ขอบคุณที่ใช้บริการ 🙏"></textarea>
        <div style="font-size:11.5px;color:var(--text-4);margin-top:4px;">ใช้ <code>{amount}</code> แทนจำนวนเงิน — กด บันทึก เพื่อจำไว้ใช้ครั้งต่อไป</div>
      </div>

      <div style="display:flex;gap:8px;justify-content:center;margin-top:14px;">
        <button class="btn btn-secondary btn-sm" onclick="downloadQR()">⬇️ ดาวน์โหลด</button>
        <button class="btn btn-primary btn-sm" onclick="sendQRToChat()">📤 ส่งใน Chat</button>
      </div>
    </div>
  </div>
</div>

