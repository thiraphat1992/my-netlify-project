<%- include('../partials/header', { extraStyles: `
<style>
/* ─── E-commerce specific ─── */
.status-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
.stab { padding:6px 14px; border-radius:var(--radius-full); font-size:12.5px; font-weight:600;
  border:1.5px solid var(--border); background:var(--surface); color:var(--text-3);
  cursor:pointer; text-decoration:none; transition:all 0.15s; }
.stab:hover { border-color:var(--primary); color:var(--primary); }
.stab.active { background:var(--primary-dim); border-color:var(--primary); color:var(--primary); }
.stab .cnt { display:inline-flex; align-items:center; justify-content:center;
  min-width:18px; height:18px; border-radius:100px; font-size:10px;
  background:var(--primary); color:#fff; margin-left:5px; padding:0 4px; }
.stab.active .cnt { background:var(--primary-dark); }

.order-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:16px 18px; margin-bottom:10px; display:grid; grid-template-columns:1fr auto;
  gap:10px; align-items:start; box-shadow:var(--shadow-sm); cursor:pointer; transition:all 0.15s; }
.order-card:hover { border-color:var(--primary); box-shadow:var(--shadow-primary); }
.order-card-left { min-width:0; }
.order-no { font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; color:var(--text-4); }
.order-customer { font-size:14px; font-weight:700; color:var(--text); margin:2px 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.order-items-preview { font-size:12.5px; color:var(--text-3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.order-meta { display:flex; gap:10px; margin-top:8px; align-items:center; flex-wrap:wrap; }
.order-meta-item { font-size:11.5px; color:var(--text-4); display:flex; align-items:center; gap:3px; }
.order-card-right { display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.order-total { font-family:'Plus Jakarta Sans',sans-serif; font-size:15px; font-weight:800; color:var(--text); }

/* ─── Chat Split Layout ─── */
.chat-container {
  display:grid; grid-template-columns:300px 1fr;
  height:calc(100vh - 260px); min-height:520px;
  border:1px solid var(--border); border-radius:var(--radius-lg);
  overflow:hidden; background:var(--surface); box-shadow:var(--shadow-sm);
}
.chat-sidebar {
  border-right:1px solid var(--border); display:flex; flex-direction:column;
  background:var(--surface);
}
.chat-sidebar-header {
  padding:14px 14px 10px; border-bottom:1px solid var(--border); flex-shrink:0;
}
.chat-sidebar-title { font-family:'Plus Jakarta Sans',sans-serif; font-size:14px; font-weight:700; color:var(--text); margin-bottom:8px; }
.chat-search-input {
  width:100%; padding:7px 12px; border:1.5px solid var(--border);
  border-radius:var(--radius-full); font-size:13px; outline:none; font-family:inherit;
}
.chat-search-input:focus { border-color:var(--primary); }
.chat-list { flex:1; overflow-y:auto; padding:6px; }
.chat-item {
  display:flex; align-items:center; gap:10px; padding:10px 10px;
  border-radius:var(--radius-sm); cursor:pointer; transition:background 0.12s; margin-bottom:2px;
}
.chat-item:hover { background:var(--surface-2); }
.chat-item.active { background:var(--primary-dim); }
.chat-avatar {
  width:40px; height:40px; border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--violet));
  display:flex; align-items:center; justify-content:center;
  font-size:16px; color:#fff; font-weight:700; flex-shrink:0;
}
.chat-info { flex:1; min-width:0; }
.chat-name { font-size:13px; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.chat-preview { font-size:11.5px; color:var(--text-4); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:1px; }
.chat-time { font-size:10.5px; color:var(--text-4); white-space:nowrap; }
.chat-unread {
  min-width:17px; height:17px; background:var(--danger); border-radius:100px;
  color:#fff; font-size:9.5px; font-weight:700;
  display:flex; align-items:center; justify-content:center; padding:0 4px;
}

/* ─── Chat Main Window ─── */
.chat-main { display:flex; flex-direction:column; background:#f7f8fc; overflow:hidden; min-height:0; }
.chat-empty-state {
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
  color:var(--text-4); gap:10px;
}
.chat-empty-state .ei { font-size:44px; }
.chat-window { display:none; flex-direction:column; height:100%; min-height:0; overflow:hidden; }
.chat-window.active { display:flex; }
.chat-window-header {
  padding:12px 16px; background:var(--surface); border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:10px; flex-shrink:0;
}
.chat-window-title { font-size:14px; font-weight:700; color:var(--text); }
.chat-window-sub { font-size:11.5px; color:var(--text-4); }
.chat-window-acts { margin-left:auto; display:flex; gap:6px; }
.chat-messages-area { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:6px; min-height:0; }
.msg-row { display:flex; flex-direction:column; }
.msg-row.me { align-items:flex-end; }
.msg-row.them { align-items:flex-start; }
.msg-bubble {
  max-width:72%; padding:9px 13px; border-radius:18px;
  font-size:13.5px; line-height:1.55; word-break:break-word;
}
.msg-bubble.me { background:linear-gradient(135deg,var(--primary-dark),var(--violet)); color:#fff; border-bottom-right-radius:4px; }
.msg-bubble.them { background:var(--surface); color:var(--text); border-bottom-left-radius:4px; box-shadow:var(--shadow-xs); }
.msg-image { max-width:200px; max-height:200px; border-radius:12px; cursor:zoom-in; object-fit:cover; }
.msg-time { font-size:10.5px; color:var(--text-4); margin-top:3px; }
.chat-input-area {
  padding:10px 12px; background:var(--surface); border-top:1px solid var(--border); flex-shrink:0;
}
.chat-tool-bar { display:flex; gap:6px; margin-bottom:8px; }
.chat-tool-btn {
  padding:5px 12px; border:1.5px solid var(--border); border-radius:var(--radius-full);
  background:var(--surface); font-size:12px; font-weight:600; cursor:pointer;
  color:var(--text-3); transition:all 0.15s; display:flex; align-items:center; gap:4px;
}
.chat-tool-btn:hover { border-color:var(--primary); color:var(--primary); background:var(--primary-dim); }
.chat-input-row { display:flex; gap:8px; align-items:flex-end; }
.chat-text-input {
  flex:1; padding:9px 14px; border:1.5px solid var(--border); border-radius:var(--radius-full);
  font-family:inherit; font-size:13.5px; outline:none; resize:none; max-height:100px;
  transition:border-color 0.2s;
}
.chat-text-input:focus { border-color:var(--primary); }
.chat-send-btn { padding:9px 20px; border-radius:var(--radius-full); flex-shrink:0; }

/* ─── Order Slide Panel ─── */
.slide-panel { position:fixed; top:0; right:0; width:480px; max-width:95vw; height:100vh;
  background:var(--surface); box-shadow:-8px 0 32px rgba(0,0,0,0.12); z-index:200;
  transform:translateX(100%); transition:transform 0.3s cubic-bezier(.4,0,.2,1); display:flex; flex-direction:column; }
.slide-panel.open { transform:translateX(0); }
.slide-panel-header { padding:18px 22px; border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
.slide-panel-body { flex:1; overflow-y:auto; padding:20px 22px; }
.slide-panel-footer { padding:14px 22px; border-top:1px solid var(--border); flex-shrink:0; }
.panel-overlay { position:fixed; inset:0; background:rgba(15,23,42,0.35); z-index:199;
  display:none; backdrop-filter:blur(2px); }
.panel-overlay.open { display:block; }

@media(max-width:800px){
  .chat-container { grid-template-columns:1fr; }
  .chat-sidebar { display:none; }
  .chat-sidebar.mobile-show { display:flex; position:absolute; z-index:10; width:100%; height:100%; }
}

/* ─── Product Cards ─── */
.product-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; }
.product-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  overflow:hidden; box-shadow:var(--shadow-sm); transition:all 0.15s; }
.product-card:hover { border-color:var(--primary); box-shadow:var(--shadow-primary); }
.product-img { width:100%; height:150px; object-fit:cover; background:var(--surface-2); display:block; }
.product-img-placeholder { width:100%; height:150px; background:var(--surface-2);
  display:flex; align-items:center; justify-content:center; font-size:36px; }
.product-body { padding:12px; }
.product-name { font-size:13.5px; font-weight:700; color:var(--text); margin-bottom:4px;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.product-price { font-size:15px; font-weight:800; color:var(--primary); }
.product-compare { font-size:11.5px; color:var(--text-4); text-decoration:line-through; margin-left:4px; }
.product-meta { display:flex; justify-content:space-between; align-items:center; margin-top:8px; }
.product-stock { font-size:11.5px; }
.product-actions { display:flex; gap:6px; padding:8px 12px; border-top:1px solid var(--border); background:var(--surface); }

/* Label printed badge */
.label-ok { display:inline-flex; align-items:center; gap:4px; font-size:11px; color:var(--success); }

/* Settings */
.platform-card { border:2px solid var(--border); border-radius:var(--radius-lg); padding:16px 18px; cursor:pointer; transition:all 0.15s; }
.platform-card:hover,.platform-card.selected { border-color:var(--primary); background:var(--primary-dim); }
.platform-logo { font-size:26px; margin-bottom:6px; }
.platform-name { font-size:13px; font-weight:700; color:var(--text); }
.platform-desc { font-size:11.5px; color:var(--text-3); margin-top:2px; }

.store-badge { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:var(--radius-full);
  border:1px solid var(--border); background:var(--surface); font-size:12.5px; font-weight:600; }

@media(max-width:600px){
  .slide-panel { width:100%; }
  .stats-4 { grid-template-columns:1fr 1fr; }
}
</style>
` }) %>

<%
  const activeTab = (typeof query !== 'undefined' && query.tab) || (filters && filters.tab) || 'orders'
  const urlParams = new URLSearchParams()
  const statusLabel = {
    pending:'รอดำเนินการ', confirmed:'ยืนยันแล้ว', packing:'กำลังแพ็ค',
    packed:'แพ็คแล้ว', shipped:'จัดส่งแล้ว', delivered:'ส่งถึงแล้ว',
    cancelled:'ยกเลิก', returned:'คืนสินค้า', manual:'สร้างเอง'
  }
  const statusClass = {
    pending:'badge-warning', confirmed:'badge-info', packing:'badge-info',
    packed:'badge-primary', shipped:'badge-primary', delivered:'badge-success',
    cancelled:'badge-danger', returned:'badge-danger'
  }
  const platformIcon = { line_shopping:'🛍️', myshop:'🏪', shopee:'🔶', lazada:'🔷', tiktok:'🎵', manual:'✏️' }
  const platformLabel = { line_shopping:'LINE Shopping', myshop:'MyShop', shopee:'Shopee', lazada:'Lazada', tiktok:'TikTok Shop', manual:'สร้างเอง' }
%>

<div class="page-header">
  <div>
    <h1>🛒 อีคอมเมิร์ซ</h1>
    <p>จัดการออเดอร์, สินค้า, แชท และเชื่อมต่อร้านค้าออนไลน์</p>
  </div>
  <div class="page-header-actions">
    <% stores.forEach(s => { %>
    <form action="/ecommerce/sync/<%= s.id %>" method="POST" style="margin:0;">
      <button type="submit" class="btn btn-secondary btn-sm">⟳ ซิงค์ <%= s.store_name %></button>
    </form>
    <% }) %>
    <button class="btn btn-primary" onclick="openModal('addOrderModal')">+ เพิ่มออเดอร์</button>
  </div>
</div>

<% if (success && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error">⚠ <%= error[0] %></div><% } %>

<!-- Stats -->
<div class="stats-grid stats-4" style="margin-bottom:18px;">
  <div class="stat-card">
    <div class="stat-icon" style="background:#eef2ff;">📦</div>
    <div class="stat-label">ออเดอร์ทั้งหมด</div>
    <div class="stat-value"><%= stats.total %></div>
    <div class="stat-sub">รายการ</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--warning-dim);">⏳</div>
    <div class="stat-label">รอดำเนินการ</div>
    <div class="stat-value" style="color:var(--warning);"><%= stats.pending %></div>
    <div class="stat-sub">รายการ</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--info-dim);">🚚</div>
    <div class="stat-label">จัดส่งแล้ว</div>
    <div class="stat-value" style="color:var(--info);"><%= stats.shipped %></div>
    <div class="stat-sub">รายการ</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--success-dim);">💰</div>
    <div class="stat-label">ยอดรวม</div>
    <div class="stat-value" style="font-size:20px;color:var(--success);">฿<%= stats.revenue.toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
    <div class="stat-sub">ออเดอร์ทั้งหมด</div>
  </div>
</div>

<!-- Tab Bar -->
<div class="tab-bar">
  <button class="tab-btn <%= activeTab === 'orders' ? 'active' : '' %>" onclick="switchTab('orders')">📦 ออเดอร์</button>
  <button class="tab-btn <%= activeTab === 'chat' ? 'active' : '' %>" onclick="switchTab('chat')">💬 แชท<% if(chats.filter(c=>c.unread_count>0).length > 0) { %> <span style="display:inline-flex;align-items:center;justify-content:center;min-width:16px;height:16px;background:var(--danger);color:#fff;font-size:10px;border-radius:100px;margin-left:4px;padding:0 3px;"><%= chats.filter(c=>c.unread_count>0).length %></span><% } %></button>
  <button class="tab-btn <%= activeTab === 'products' ? 'active' : '' %>" onclick="switchTab('products')">🛍️ สินค้า <span style="display:inline-flex;align-items:center;justify-content:center;min-width:16px;height:16px;background:var(--border);color:var(--text-3);font-size:10px;border-radius:100px;margin-left:4px;padding:0 4px;"><%= products.length %></span></button>
  <button class="tab-btn <%= activeTab === 'settings' ? 'active' : '' %>" onclick="switchTab('settings')">⚙️ ตั้งค่าร้าน</button>
</div>

<!-- ═══════════════ TAB: ORDERS ═══════════════ -->
<div id="tab-orders" class="tab-pane" style="display:<%= activeTab==='orders'?'block':'none' %>">
  <!-- Filter by status -->
  <div class="status-tabs">
    <a class="stab <%= !filters.status ? 'active' : '' %>" href="/ecommerce">ทั้งหมด <span class="cnt"><%= stats.total %></span></a>
    <a class="stab <%= filters.status==='pending' ? 'active' : '' %>" href="/ecommerce?status=pending">รอดำเนินการ <span class="cnt"><%= stats.pending %></span></a>
    <a class="stab <%= filters.status==='confirmed' ? 'active' : '' %>" href="/ecommerce?status=confirmed">ยืนยันแล้ว</a>
    <a class="stab <%= filters.status==='packing'||filters.status==='packed' ? 'active' : '' %>" href="/ecommerce?status=packing">กำลังแพ็ค <span class="cnt"><%= stats.packing %></span></a>
    <a class="stab <%= filters.status==='shipped' ? 'active' : '' %>" href="/ecommerce?status=shipped">จัดส่งแล้ว <span class="cnt"><%= stats.shipped %></span></a>
    <a class="stab <%= filters.status==='delivered' ? 'active' : '' %>" href="/ecommerce?status=delivered">ส่งถึงแล้ว <span class="cnt"><%= stats.delivered %></span></a>
    <a class="stab <%= filters.status==='cancelled' ? 'active' : '' %>" href="/ecommerce?status=cancelled">ยกเลิก</a>
  </div>

  <!-- Search + Filter bar -->
  <div style="display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap;">
    <form method="GET" action="/ecommerce" style="display:flex;gap:10px;flex:1;min-width:200px;">
      <input type="hidden" name="status" value="<%= filters.status || '' %>">
      <div class="search-wrap" style="flex:1;">
        <span class="search-icon">🔍</span>
        <input type="text" name="q" class="search-input" placeholder="ค้นหาชื่อลูกค้า, เลขออเดอร์, tracking..." value="<%= filters.q || '' %>">
      </div>
      <% if (stores.length > 1) { %>
      <select name="store_id" class="form-control" style="width:auto;padding:8px 12px;border-radius:var(--radius-full);">
        <option value="">ทุกร้าน</option>
        <% stores.forEach(s => { %><option value="<%= s.id %>" <%= filters.store_id===s.id?'selected':'' %>><%= s.store_name %></option><% }) %>
      </select>
      <% } %>
      <button type="submit" class="btn btn-secondary btn-sm">ค้นหา</button>
    </form>
  </div>

  <!-- Orders list -->
  <% if (orders.length === 0) { %>
  <div class="empty-state card">
    <div class="empty-icon">📭</div>
    <div class="empty-title">ยังไม่มีออเดอร์</div>
    <div class="empty-desc">เชื่อมต่อร้านค้าเพื่อดึงออเดอร์ หรือ <a href="#" onclick="openModal('addOrderModal')" style="color:var(--primary)">+ เพิ่มออเดอร์ด้วยตนเอง</a></div>
  </div>
  <% } else { %>
  <div id="ordersList">
    <% orders.forEach(order => {
      const itemsText = order.items && order.items.length > 0
        ? order.items.map(i => `${i.product_name}${i.variant?' ('+i.variant+')':''} x${i.qty}`).join(', ')
        : 'ไม่มีรายการสินค้า'
    %>
    <div class="order-card" onclick="openOrderPanel('<%= order.id %>')">
      <div class="order-card-left">
        <div class="order-no">
          <%= platformIcon[order.platform] || '📦' %> <%= platformLabel[order.platform] || order.platform %>
          <% if (order.platform_order_id) { %> · #<%= order.platform_order_id %><% } %>
          <% if (order.store) { %> · <%= order.store.store_name %><% } %>
        </div>
        <div class="order-customer"><%= order.customer_name || 'ลูกค้า' %></div>
        <div class="order-items-preview"><%= itemsText %></div>
        <div class="order-meta">
          <% if (order.customer_phone) { %><span class="order-meta-item">📞 <%= order.customer_phone %></span><% } %>
          <% if (order.tracking_no) { %><span class="order-meta-item" style="color:var(--success);">🚚 <%= order.tracking_no %></span><% } %>
          <% if (order.shipping_provider) { %><span class="order-meta-item">📮 <%= order.shipping_provider %></span><% } %>
          <span class="order-meta-item">🕐 <%= new Date(order.ordered_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit',hour:'2-digit',minute:'2-digit'}) %></span>
          <% if (order.label_printed) { %><span class="label-ok">✓ ปริ้นLabel แล้ว</span><% } %>
        </div>
      </div>
      <div class="order-card-right">
        <span class="badge <%= statusClass[order.status] || 'badge-gray' %>"><%= statusLabel[order.status] || order.status %></span>
        <div class="order-total">฿<%= (parseFloat(order.total)||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></div>
        <div style="display:flex;gap:6px;" onclick="event.stopPropagation()">
          <a href="/ecommerce/orders/<%= order.id %>/label" target="_blank" class="btn btn-secondary btn-xs">🏷️ Label</a>
          <form action="/ecommerce/orders/<%= order.id %>?_method=DELETE" method="POST" onsubmit="return confirm('ลบออเดอร์นี้?')">
            <button type="submit" class="btn btn-danger btn-xs">ลบ</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- ═══════════════ TAB: CHAT ═══════════════ -->
<div id="tab-chat" class="tab-pane" style="display:<%= activeTab==='chat'?'block':'none' %>">

  <!-- Top bar: Broadcast -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
    <div style="font-size:13px;color:var(--text-3);"><%= chats.length %> การสนทนา</div>
    <div style="display:flex;gap:8px;">
      <button class="btn btn-secondary btn-sm" onclick="openModal('broadcastModal')">📢 Broadcast</button>
    </div>
  </div>

  <div class="chat-container">
    <!-- ─── Left: Customer list ─── -->
    <div class="chat-sidebar">
      <div class="chat-sidebar-header">
        <div class="chat-sidebar-title">💬 รายชื่อลูกค้า</div>
        <input type="text" class="chat-search-input" placeholder="🔍 ค้นหาชื่อลูกค้า..."
          oninput="filterChatList(this.value)">
      </div>
      <div class="chat-list" id="chatList">
        <% if (chats.length === 0) { %>
        <div style="padding:30px;text-align:center;color:var(--text-4);font-size:13px;">
          ยังไม่มีแชท<br>เชื่อมต่อ LINE OA และตั้งค่า Webhook
        </div>
        <% } %>
        <% chats.forEach(chat => { %>
        <div class="chat-item"
          id="ci-<%= chat.id %>"
          data-name="<%= chat.customer_name || 'ลูกค้า' %>"
          data-id="<%= chat.id %>"
          data-avatar="<%= (chat.customer_name||'?')[0].toUpperCase() %>"
          onclick="selectChat(this)">
          <div class="chat-avatar"><%= (chat.customer_name||'?')[0].toUpperCase() %></div>
          <div class="chat-info">
            <div class="chat-name"><%= chat.customer_name || 'ลูกค้า' %></div>
            <div class="chat-preview"><%= chat.last_message || '...' %></div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
            <div class="chat-time"><%= chat.last_message_at ? new Date(chat.last_message_at).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : '' %></div>
            <% if (chat.unread_count > 0) { %><div class="chat-unread"><%= chat.unread_count %></div><% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- ─── Right: Chat window ─── -->
    <div class="chat-main">
      <!-- Empty state -->
      <div class="chat-empty-state" id="chatEmptyState">
        <div class="ei">💬</div>
        <div style="font-size:15px;font-weight:600;color:var(--text-3);">เลือกลูกค้าเพื่อแชท</div>
        <div style="font-size:13px;">คลิกชื่อลูกค้าด้านซ้ายเพื่อเปิดการสนทนา</div>
      </div>

      <!-- Active chat window -->
      <div class="chat-window" id="chatWindow">
        <!-- Header -->
        <div class="chat-window-header">
          <div class="chat-avatar" id="cwAvatar" style="width:36px;height:36px;font-size:14px;">?</div>
          <div>
            <div class="chat-window-title" id="cwName">ลูกค้า</div>
            <div class="chat-window-sub">LINE OA</div>
          </div>
          <div class="chat-window-acts">
            <button class="chat-tool-btn" onclick="openCreateOrderForChat()" title="สร้างออเดอร์จากแชทนี้">📋 สร้างบิล</button>
            <button class="chat-tool-btn" onclick="openQRModal()" title="สร้าง QR PromptPay รับเงิน">💳 QR รับเงิน</button>
          </div>
        </div>

        <!-- Messages -->
        <div class="chat-messages-area" id="cwMessages">
          <div style="text-align:center;color:var(--text-4);font-size:13px;padding:20px;">กำลังโหลด...</div>
        </div>

        <!-- Toolbar + Input -->
        <div class="chat-input-area">
          <div class="chat-tool-bar">
            <label class="chat-tool-btn" style="cursor:pointer;" title="แนบรูปภาพ">
              🖼️ แนบรูป
              <input type="file" accept="image/*" style="display:none;" onchange="handleImageUpload(this)">
            </label>
          </div>
          <div class="chat-input-row">
            <textarea class="chat-text-input" id="cwInput" rows="1"
              placeholder="พิมพ์ข้อความ..."
              onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChatMessage()}"
              oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,100)+'px'"></textarea>
            <button class="btn btn-primary chat-send-btn" onclick="sendChatMessage()">ส่ง</button>
          </div>
          <!-- Image preview -->
          <div id="imgPreviewWrap" style="display:none;margin-top:8px;position:relative;width:fit-content;">
            <img id="imgPreview" style="max-width:120px;max-height:120px;border-radius:8px;border:1px solid var(--border);">
            <button onclick="clearImage()" style="position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;border:none;background:var(--danger);color:#fff;font-size:12px;cursor:pointer;line-height:1;">×</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ TAB: PRODUCTS ═══════════════ -->
<div id="tab-products" class="tab-pane" style="display:<%= activeTab==='products'?'block':'none' %>">

  <!-- Toolbar -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <% stores.filter(s => s.settings && s.settings.myshop_api_key).forEach(s => { %>
      <form action="/ecommerce/sync-products/<%= s.id %>" method="POST" style="margin:0;">
        <button type="submit" class="btn btn-secondary btn-sm">⟳ ซิงค์ MyShop: <%= s.store_name %></button>
      </form>
      <% }) %>
    </div>
    <button class="btn btn-primary btn-sm" onclick="openModal('addProductModal')">+ เพิ่มสินค้า</button>
  </div>

  <!-- Stats row -->
  <% const activeProds = products.filter(p => p.status === 'active').length
     const outOfStock  = products.filter(p => p.stock === 0).length %>
  <div class="stats-grid stats-4" style="margin-bottom:16px;">
    <div class="stat-card">
      <div class="stat-icon" style="background:#eef2ff;">🛍️</div>
      <div class="stat-label">สินค้าทั้งหมด</div>
      <div class="stat-value"><%= products.length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--success-dim);">✅</div>
      <div class="stat-label">กำลังขาย</div>
      <div class="stat-value" style="color:var(--success);"><%= activeProds %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--danger-dim);">⚠️</div>
      <div class="stat-label">สินค้าหมด</div>
      <div class="stat-value" style="color:var(--danger);"><%= outOfStock %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--warning-dim);">🏪</div>
      <div class="stat-label">จาก MyShop</div>
      <div class="stat-value" style="color:var(--warning);"><%= products.filter(p=>p.platform==='myshop').length %></div>
    </div>
  </div>

  <!-- Search + filter -->
  <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
    <div class="search-wrap" style="flex:1;min-width:200px;">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" placeholder="ค้นหาชื่อสินค้า, SKU..."
        oninput="filterProducts(this.value)" id="productSearchInput">
    </div>
    <select class="form-control" style="width:auto;padding:8px 12px;border-radius:var(--radius-full);" onchange="filterProductsByStatus(this.value)">
      <option value="">ทุกสถานะ</option>
      <option value="active">กำลังขาย</option>
      <option value="inactive">ปิด</option>
      <option value="out_of_stock">สินค้าหมด</option>
    </select>
  </div>

  <!-- Product grid -->
  <% if (products.length === 0) { %>
  <div class="empty-state card">
    <div class="empty-icon">🛍️</div>
    <div class="empty-title">ยังไม่มีสินค้า</div>
    <div class="empty-desc">
      เชื่อมต่อ MyShop แล้วกด <strong>ซิงค์ MyShop</strong> หรือ
      <a href="#" onclick="openModal('addProductModal')" style="color:var(--primary)">+ เพิ่มสินค้าด้วยตนเอง</a>
    </div>
  </div>
  <% } else { %>
  <div class="product-grid" id="productGrid">
    <% products.forEach(p => { %>
    <div class="product-card"
      data-name="<%= (p.name||'').toLowerCase() %>"
      data-sku="<%= (p.sku||'').toLowerCase() %>"
      data-status="<%= p.status || 'active' %>">
      <% if (p.image_url) { %>
      <img src="<%= p.image_url %>" alt="<%= p.name %>" class="product-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <div class="product-img-placeholder" style="display:none;">🛍️</div>
      <% } else { %>
      <div class="product-img-placeholder">🛍️</div>
      <% } %>
      <div class="product-body">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:4px;margin-bottom:4px;">
          <div class="product-name" title="<%= p.name %>"><%= p.name %></div>
          <span class="badge <%= p.status === 'active' ? 'badge-success' : 'badge-gray' %>" style="font-size:10px;flex-shrink:0;">
            <%= p.status === 'active' ? 'ขาย' : 'ปิด' %>
          </span>
        </div>
        <% if (p.sku) { %><div style="font-size:11px;color:var(--text-4);margin-bottom:4px;">SKU: <%= p.sku %></div><% } %>
        <div style="display:flex;align-items:baseline;gap:2px;">
          <span class="product-price">฿<%= parseFloat(p.price||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></span>
          <% if (p.compare_price && p.compare_price > p.price) { %>
          <span class="product-compare">฿<%= parseFloat(p.compare_price).toLocaleString('th-TH',{minimumFractionDigits:0}) %></span>
          <% } %>
        </div>
        <div class="product-meta">
          <span class="product-stock" style="color:<%= p.stock === 0 ? 'var(--danger)' : p.stock <= 5 ? 'var(--warning)' : 'var(--text-3)' %>">
            <%= p.stock === 0 ? '❌ หมดสต็อก' : `📦 ${p.stock} ชิ้น` %>
          </span>
          <% if (p.platform === 'myshop') { %><span style="font-size:10px;color:var(--primary);font-weight:600;">MyShop</span><% } %>
        </div>
      </div>
      <div class="product-actions">
        <button class="btn btn-secondary btn-xs" style="flex:1;"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-sku="<%= p.sku||'' %>"
          data-price="<%= p.price||0 %>"
          data-compare-price="<%= p.compare_price||'' %>"
          data-cost="<%= p.cost||'' %>"
          data-stock="<%= p.stock||0 %>"
          data-image-url="<%= p.image_url||'' %>"
          data-category="<%= p.category||'' %>"
          data-description="<%= p.description||'' %>"
          data-status="<%= p.status||'active' %>"
          onclick="openEditProduct(this)">✏️ แก้ไข</button>
        <form action="/ecommerce/products/<%= p.id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('ลบสินค้านี้?')">
          <button type="submit" class="btn btn-danger btn-xs">ลบ</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>

  <!-- MyShop API Key per store -->
  <% if (stores.length > 0) { %>
  <div class="card" style="margin-top:20px;">
    <div class="card-header">
      <span class="card-title">🔑 MyShop API Key</span>
      <span style="font-size:12px;color:var(--text-4);">รับ API Key จาก <a href="https://oaplus.line.biz" target="_blank" style="color:var(--primary);">oaplus.line.biz</a> → Developer → API Key</span>
    </div>
    <div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
      <% stores.forEach(s => { %>
      <form action="/ecommerce/stores/<%= s.id %>/api-key" method="POST" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span style="font-weight:600;font-size:13.5px;min-width:120px;"><%= s.store_name %></span>
        <input type="password" name="myshop_api_key" class="form-control" style="flex:1;min-width:200px;"
          placeholder="ใส่ MyShop API Key"
          value="<%= s.settings && s.settings.myshop_api_key ? '••••••••' : '' %>">
        <button type="submit" class="btn btn-primary btn-sm">บันทึก</button>
      </form>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<!-- ═══════════════ TAB: SETTINGS ═══════════════ -->
<div id="tab-settings" class="tab-pane" style="display:<%= activeTab==='settings'?'block':'none' %>">
  <!-- Connected stores -->
  <% if (stores.length > 0) { %>
  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><span class="card-title">ร้านค้าที่เชื่อมต่อแล้ว</span></div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>ร้านค้า</th><th>แพลตฟอร์ม</th><th>ผู้ส่ง</th><th>Webhook URL</th><th>สถานะ</th><th>ซิงค์ล่าสุด</th><th>จัดการ</th></tr></thead>
        <tbody>
          <% stores.forEach(s => { %>
          <tr>
            <td><strong><%= s.store_name %></strong></td>
            <td><span class="store-badge"><%= platformIcon[s.platform] || '🏪' %> <%= platformLabel[s.platform] || s.platform %></span></td>
            <td style="font-size:12.5px;"><%= s.sender_name || '-' %></td>
            <td style="font-size:11px;color:var(--text-4);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <span id="wh-<%= s.id %>"><%= appUrl %>/ecommerce/webhook/<%= s.id %></span>
              <button onclick="copyText('wh-<%= s.id %>')" class="btn btn-secondary btn-xs" style="margin-left:4px;">คัดลอก</button>
            </td>
            <td><span class="badge <%= s.is_active ? 'badge-success' : 'badge-gray' %>"><%= s.is_active ? 'เปิดใช้' : 'ปิด' %></span></td>
            <td style="font-size:12px;color:var(--text-4);"><%= s.last_sync_at ? new Date(s.last_sync_at).toLocaleString('th-TH') : 'ยังไม่ได้ซิงค์' %></td>
            <td>
              <div style="display:flex;gap:6px;">
                <button class="btn btn-secondary btn-xs"
                  data-id="<%= s.id %>"
                  data-name="<%= s.store_name %>"
                  data-platform="<%= s.platform %>"
                  data-channel-id="<%= s.channel_id||'' %>"
                  data-access-token="<%= s.access_token ? '••••••' : '' %>"
                  data-sender-name="<%= s.sender_name||'' %>"
                  data-sender-phone="<%= s.sender_phone||'' %>"
                  data-sender-address="<%= s.sender_address||'' %>"
                  onclick="openEditStoreBtn(this)">แก้ไข</button>
                <form action="/ecommerce/stores/<%= s.id %>?_method=DELETE" method="POST" style="margin:0;" onsubmit="return confirm('ลบร้านค้านี้?')">
                  <button type="submit" class="btn btn-danger btn-xs">ลบ</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Add new store -->
  <div class="card">
    <div class="card-header"><span class="card-title">➕ เชื่อมต่อร้านค้าใหม่</span></div>
    <div class="card-body">
      <form action="/ecommerce/stores" method="POST">
        <div class="form-row form-row-2" style="margin-bottom:16px;">
          <div class="form-group" style="margin:0;">
            <label class="form-label">ชื่อร้านค้า *</label>
            <input type="text" name="store_name" class="form-control" placeholder="ชื่อร้านของคุณ" required>
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">แพลตฟอร์ม *</label>
            <select name="platform" class="form-control" id="platformSelect" onchange="showPlatformFields()">
              <option value="line_shopping">🛍️ LINE Shopping</option>
              <option value="myshop">🏪 MyShop (LINE)</option>
              <option value="shopee">🔶 Shopee</option>
              <option value="lazada">🔷 Lazada</option>
              <option value="tiktok">🎵 TikTok Shop</option>
              <option value="manual">✏️ สร้างเอง (ไม่ต้อง API)</option>
            </select>
          </div>
        </div>

        <div id="apiFields">
          <div class="form-row form-row-2" style="margin-bottom:12px;">
            <div class="form-group" style="margin:0;">
              <label class="form-label">Channel ID / Shop ID</label>
              <input type="text" name="channel_id" class="form-control" placeholder="Channel ID">
            </div>
            <div class="form-group" style="margin:0;">
              <label class="form-label">Channel Secret</label>
              <input type="password" name="channel_secret" class="form-control" placeholder="Channel Secret">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Access Token / API Key</label>
            <input type="password" name="access_token" class="form-control" placeholder="Channel Access Token (Long-lived)">
            <div class="form-hint">สำหรับ LINE: ใช้ Long-lived Channel Access Token จาก LINE Developers Console</div>
          </div>
          <div class="form-group">
            <label class="form-label">Webhook Secret (ไม่บังคับ)</label>
            <input type="text" name="webhook_secret" class="form-control" placeholder="Webhook secret สำหรับยืนยัน signature">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0;">
        <p style="font-size:13px;font-weight:700;color:var(--text-2);margin-bottom:14px;">📍 ที่อยู่ผู้ส่ง (ใช้พิมพ์ใบ Label)</p>
        <div class="form-row form-row-2" style="margin-bottom:12px;">
          <div class="form-group" style="margin:0;">
            <label class="form-label">ชื่อผู้ส่ง</label>
            <input type="text" name="sender_name" class="form-control" placeholder="ชื่อร้าน / บริษัท">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">เบอร์โทรผู้ส่ง</label>
            <input type="text" name="sender_phone" class="form-control" placeholder="0XX-XXX-XXXX">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">ที่อยู่ผู้ส่ง</label>
          <textarea name="sender_address" class="form-control" rows="2" placeholder="ที่อยู่ร้านค้า / โกดัง"></textarea>
        </div>

        <div style="text-align:right;margin-top:8px;">
          <button type="submit" class="btn btn-primary">เชื่อมต่อร้านค้า</button>
        </div>
      </form>
    </div>
  </div>

  <!-- LINE API Notice -->
  <div class="card" style="margin-top:16px;border-color:var(--warning);background:var(--warning-dim);">
    <div class="card-body" style="font-size:13px;color:#92400e;">
      <strong>⚠️ LINE Shopping Merchant API</strong> ต้องสมัครเป็น LINE Certified Partner ก่อน (ไม่ใช่ API สาธารณะ)<br>
      สำหรับร้านค้าทั่วไป ใช้ <strong>2 วิธีนี้แทน:</strong>
      <div style="display:flex;gap:10px;margin-top:10px;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;background:#fff;border-radius:8px;padding:10px 14px;border:1px solid var(--border);">
          <div style="font-weight:700;margin-bottom:4px;">✅ วิธีที่ 1: Webhook (แนะนำ)</div>
          <div style="color:var(--text-3);font-size:12.5px;">ลูกค้าส่งออเดอร์มาทาง LINE OA Chat → ระบบรับอัตโนมัติ ไม่ต้อง sync</div>
        </div>
        <div style="flex:1;min-width:200px;background:#fff;border-radius:8px;padding:10px 14px;border:1px solid var(--border);">
          <div style="font-weight:700;margin-bottom:4px;">📥 วิธีที่ 2: Import CSV</div>
          <div style="color:var(--text-3);font-size:12.5px;">Export ออเดอร์จาก LINE Shopping Seller Center → Import ขึ้น BizFlow</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Verify LINE Token -->
  <% if (stores.length > 0) { %>
  <div class="card" style="margin-top:16px;">
    <div class="card-header"><span class="card-title">🔑 ทดสอบการเชื่อมต่อ LINE OA</span></div>
    <div class="card-body">
      <% stores.filter(s => s.access_token).forEach(s => { %>
      <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border-2);">
        <span style="font-weight:600;flex:1;"><%= s.store_name %></span>
        <button class="btn btn-secondary btn-sm" onclick="verifyToken('<%= s.id %>', this)">
          🔍 ทดสอบ Token
        </button>
        <span id="verify-<%= s.id %>" style="font-size:12.5px;color:var(--text-4);"></span>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Import CSV -->
  <div class="card" style="margin-top:16px;">
    <div class="card-header">
      <span class="card-title">📥 Import ออเดอร์จาก CSV</span>
      <span style="font-size:12px;color:var(--text-4);">LINE Shopping Seller Center → ออเดอร์ → Export</span>
    </div>
    <div class="card-body">
      <form action="/ecommerce/import-csv/<%= stores[0] ? stores[0].id : 'default' %>" method="POST" id="csvImportForm">
        <% if (stores.length > 1) { %>
        <div class="form-group">
          <label class="form-label">ร้านค้า</label>
          <select name="store_id" class="form-control" onchange="document.getElementById('csvImportForm').action='/ecommerce/import-csv/'+this.value">
            <% stores.forEach(s => { %><option value="<%= s.id %>"><%= s.store_name %></option><% }) %>
          </select>
        </div>
        <% } %>
        <div class="form-group">
          <label class="form-label">วาง CSV ที่นี่</label>
          <textarea name="csv_data" class="form-control" rows="6"
            placeholder="วาง CSV content ที่ copy มาจาก Excel หรือ LINE Shopping Seller Center&#10;รองรับคอลัมน์: Order ID, Status, Recipient Name, Phone, Address, Province, Zip, Carrier, Tracking, Total, Shipping Fee, Date"></textarea>
          <div class="form-hint">เปิดไฟล์ CSV ด้วย Excel/Notepad → Select All → Copy → วางที่นี่ / หรือ drag &amp; drop ไฟล์</div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <button type="submit" class="btn btn-primary btn-sm">📥 Import ออเดอร์</button>
          <label class="btn btn-secondary btn-sm" style="cursor:pointer;">
            📂 เลือกไฟล์ .csv
            <input type="file" accept=".csv,.txt" style="display:none;" onchange="readCSVFile(this)">
          </label>
        </div>
      </form>
    </div>
  </div>

  <!-- Webhook diagnostic -->
  <div class="card" style="margin-top:16px;">
    <div class="card-header">
      <span class="card-title">🔔 Webhook Diagnostic</span>
      <button class="btn btn-secondary btn-sm" onclick="loadWebhookLog()">🔄 รีเฟรช</button>
    </div>
    <div class="card-body">
      <div style="padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px;"
        id="webhookStatusBox"
        style="background:var(--surface-2);">กด รีเฟรช เพื่อดูว่า LINE ส่ง Webhook มาถึงหรือเปล่า</div>
      <div id="webhookLogWrap" style="font-size:12px;font-family:monospace;background:var(--surface-2);border-radius:8px;padding:10px;max-height:160px;overflow-y:auto;color:var(--text-3);">
        (ยังไม่ได้โหลด)
      </div>
      <div style="margin-top:12px;font-size:12.5px;color:var(--text-3);line-height:1.8;">
        📌 ถ้า log ว่างเปล่าหลังจากลูกค้าทัก → <strong>LINE ยังส่ง Webhook ไม่ถึง</strong><br>
        ให้ไปที่ <a href="https://developers.line.biz" target="_blank" style="color:var(--primary);">LINE Developers Console</a> →
        Messaging API → Webhook URL → ใส่ URL ด้านบน → กด <strong>Verify</strong> → เปิด <strong>Use webhook: ON</strong>
      </div>
    </div>
  </div>

  <!-- How to setup LINE -->
  <div class="card" style="margin-top:16px;">
    <div class="card-header"><span class="card-title">📖 วิธีเชื่อมต่อ LINE OA กับ BizFlow</span></div>
    <div class="card-body" style="font-size:13.5px;line-height:1.9;color:var(--text-2);">
      <ol style="padding-left:18px;">
        <li>สมัคร LINE Official Account ที่ <a href="https://manager.line.biz" target="_blank" style="color:var(--primary);">manager.line.biz</a></li>
        <li>ไปที่ <a href="https://developers.line.biz" target="_blank" style="color:var(--primary);">developers.line.biz</a> → Create Provider → Create channel → <strong>Messaging API</strong></li>
        <li>แท็บ <strong>Messaging API</strong> → คัดลอก Channel ID, Channel Secret และ Issue Long-lived Access Token</li>
        <li>กรอกข้อมูลในฟอร์มด้านบน → เชื่อมต่อร้านค้า</li>
        <li>คัดลอก <strong>Webhook URL</strong> ไปใส่ใน LINE Developers → กด <strong>Verify</strong> → เปิด <strong>Use webhook: ON</strong></li>
        <li>กด <strong>🔍 ทดสอบ Token</strong> เพื่อตรวจสอบว่าเชื่อมต่อถูกต้อง</li>
        <li>ปิด Auto-reply ใน LINE OA Manager เพื่อให้ตอบเองผ่าน BizFlow</li>
      </ol>
      <div style="margin-top:12px;padding:10px 14px;background:var(--warning-dim);border-radius:8px;font-size:12.5px;color:#92400e;">
        ⚠️ <strong>สำคัญ:</strong> Webhook URL ต้องเป็น <strong>HTTPS สาธารณะ</strong> เท่านั้น — <code>localhost:3000</code> ใช้ไม่ได้<br>
        ต้อง deploy บน Netlify หรือใช้ <strong>ngrok</strong> (<code>ngrok http 3000</code>) แล้วเอา URL จาก ngrok ไปใส่แทน
      </div>
    </div>
  </div>
</div>

