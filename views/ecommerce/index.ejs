          <label class="form-label">สถานะ</label>
          <select name="is_active" class="form-control">
            <option value="true">เปิดใช้งาน</option>
            <option value="false">ปิด</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('editStoreModal')">ยกเลิก</button>
        <button type="submit" class="btn btn-primary">บันทึก</button>
      </div>
    </form>
  </div>
</div>

<script>
// Tab switching
function switchTab(name) {
  document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none')
  document.getElementById('tab-' + name).style.display = 'block'
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
  event.target.classList.add('active')
  history.replaceState(null, '', '/ecommerce?tab=' + name)
  if (name === 'chat') startChatPolling()
  else stopChatPolling()
}

// Modals
function openModal(id) {
  const m = document.getElementById(id)
  m.style.display = 'flex'
  setTimeout(() => m.classList.add('active'), 10)
}
function closeModal(id) {
  const m = document.getElementById(id)
  m.classList.remove('active')
  setTimeout(() => m.style.display = 'none', 250)
}
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click', e => { if (e.target === m) closeModal(m.id) }))

// Order slide panel
let currentOrderId = null
async function openOrderPanel(id) {
  currentOrderId = id
  document.getElementById('panelOverlay').classList.add('open')
  document.getElementById('orderPanel').classList.add('open')
  document.getElementById('panelBody').innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-4);">กำลังโหลด...</div>'

  const order = await fetch('/ecommerce/api/orders/' + id).then(r => r.json())
  if (!order) { document.getElementById('panelBody').innerHTML = '<div class="empty-state">ไม่พบออเดอร์</div>'; return }

  const statusOpts = ['pending','confirmed','packing','packed','shipped','delivered','cancelled','returned']
  const statusLabel = {pending:'รอดำเนินการ',confirmed:'ยืนยันแล้ว',packing:'กำลังแพ็ค',packed:'แพ็คแล้ว',shipped:'จัดส่งแล้ว',delivered:'ส่งถึงแล้ว',cancelled:'ยกเลิก',returned:'คืนสินค้า'}
  const carriers = ['ไปรษณีย์ไทย','Kerry','Flash','J&T','Ninja Van','DHL','SCG']

  document.getElementById('panelTitle').textContent = 'ออเดอร์: ' + (order.customer_name || 'ลูกค้า')
  document.getElementById('panelBody').innerHTML = `
    <div style="display:grid;gap:14px;">
      <div class="card" style="padding:16px;">
        <div style="font-size:12px;font-weight:600;color:var(--text-4);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;">ข้อมูลลูกค้า</div>
        <div style="font-size:14px;font-weight:700;">${order.customer_name || '-'}</div>
        <div style="font-size:13px;color:var(--text-3);margin-top:4px;">📞 ${order.customer_phone || '-'}</div>
        <div style="font-size:13px;color:var(--text-3);margin-top:4px;">📍 ${[order.customer_address, order.customer_district, order.customer_province, order.customer_postal_code].filter(Boolean).join(' ')}</div>
      </div>

      <div class="card" style="padding:16px;">
        <div style="font-size:12px;font-weight:600;color:var(--text-4);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;">สินค้า</div>
        ${(order.items || []).map(i => `
          <div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border-2);font-size:13.5px;">
            <span>${i.product_name}${i.variant?' <span style="color:var(--text-4);font-size:12px;">('+i.variant+')</span>':''} × ${i.qty}</span>
            <span style="font-weight:700;">฿${((i.line_total||0)).toLocaleString('th-TH',{minimumFractionDigits:0})}</span>
          </div>`).join('')}
        <div style="display:flex;justify-content:space-between;margin-top:10px;font-size:13px;color:var(--text-3);">
          <span>ค่าส่ง (${order.shipping_provider || '-'})</span>
          <span>฿${(parseFloat(order.shipping_fee)||0).toLocaleString('th-TH',{minimumFractionDigits:0})}</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:16px;font-weight:800;font-family:'Plus Jakarta Sans',sans-serif;">
          <span>รวมทั้งหมด</span>
          <span style="color:var(--primary);">฿${(parseFloat(order.total)||0).toLocaleString('th-TH',{minimumFractionDigits:0})}</span>
        </div>
      </div>

      <form action="/ecommerce/orders/${id}/update" method="POST" class="card" style="padding:16px;">
        <div style="font-size:12px;font-weight:600;color:var(--text-4);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;">อัปเดตออเดอร์</div>
        <div class="form-row form-row-2">
          <div class="form-group" style="margin-bottom:12px;">
            <label class="form-label">สถานะ</label>
            <select name="status" class="form-control">
              ${statusOpts.map(s => `<option value="${s}" ${order.status===s?'selected':''}>${statusLabel[s]||s}</option>`).join('')}
            </select>
          </div>
          <div class="form-group" style="margin-bottom:12px;">
            <label class="form-label">บริษัทขนส่ง</label>
            <select name="shipping_provider" class="form-control">
              ${carriers.map(c => `<option ${order.shipping_provider===c?'selected':''}>${c}</option>`).join('')}
            </select>
