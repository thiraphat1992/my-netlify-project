// ─── Chat: Split Layout ───────────────────────────────────────────────────────
let activeChatId = null
let pendingImageFile = null

function selectChat(el) {
  const id   = el.dataset.id
  const name = el.dataset.name
  const av   = el.dataset.avatar
  activeChatId = id

  document.querySelectorAll('.chat-item').forEach(c => c.classList.remove('active'))
  el.classList.add('active')
  document.getElementById('chatEmptyState').style.display = 'none'
  document.getElementById('chatWindow').classList.add('active')
  document.getElementById('cwName').textContent = name
  document.getElementById('cwAvatar').textContent = av

  loadChatMessages()
  document.getElementById('cwInput').focus()
  // ล้าง unread badge
  const unreadEl = document.getElementById('unread-' + id)
  if (unreadEl) unreadEl.textContent = ''
  // mark as read ใน DB
  fetch('/ecommerce/chat/' + id + '/read', { method: 'POST' }).catch(() => {})
}

async function loadChatMessages() {
  if (!activeChatId) return
  const msgs = await fetch('/ecommerce/api/chat/' + activeChatId + '/messages').then(r => r.json())
  const area = document.getElementById('cwMessages')
  if (!msgs.length) {
    area.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-4);font-size:13px;">ยังไม่มีข้อความ</div>'
    return
  }
  area.innerHTML = msgs.map(m => {
    const isMe = m.sender_type === 'merchant'
    const time  = new Date(m.sent_at).toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'})
    let content
    if (m.message_type === 'image' && m.media_url) {
      content = `<img src="${escHtml(m.media_url)}" class="msg-image" onclick="window.open('${escHtml(m.media_url)}','_blank')" alt="รูปภาพ">`
    } else {
      content = `<div class="msg-bubble ${isMe?'me':'them'}">${escHtml(m.message||'')}</div>`
    }
    return `<div class="msg-row ${isMe?'me':'them'}">${content}<div class="msg-time">${time}</div></div>`
  }).join('')
  area.scrollTop = area.scrollHeight
}

async function sendChatMessage() {
  const input = document.getElementById('cwInput')
  const msg   = input.value.trim()
  if (!activeChatId) return

  // ส่งรูปถ้ามี
  if (pendingImageFile) {
    await sendImage()
    if (!msg) return
  }

  if (!msg) return
  input.value = ''
  input.style.height = 'auto'

  // Optimistic UI
  const area = document.getElementById('cwMessages')
  const row  = document.createElement('div')
  row.className = 'msg-row me'
  row.innerHTML = `<div class="msg-bubble me">${escHtml(msg)}</div><div class="msg-time">เมื่อกี้</div>`
  area.appendChild(row)
  area.scrollTop = area.scrollHeight

  const r = await fetch('/ecommerce/chat/' + activeChatId + '/reply', {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ message: msg })
  })
  if (!r.ok) { row.style.opacity = '0.5'; row.title = 'ส่งไม่สำเร็จ' }
}

// parse JSON safely — ถ้า server ส่ง HTML (redirect / error page) กลับมาจะโชว์ error ที่อ่านออก
async function apiJson(response) {
  const ct = response.headers.get('content-type') || ''
  if (!ct.includes('application/json')) {
    const hint = response.status === 401 ? 'session หมดอายุ กรุณา reload หน้าแล้วล็อกอินใหม่'
               : response.status === 404 ? 'ไม่พบ API endpoint — กรุณา restart server'
               : `Server ตอบกลับ HTTP ${response.status} (ไม่ใช่ JSON)`
    throw new Error(hint)
  }
  return response.json()
}

// ─── Image upload ─────────────────────────────────────────────────────────────
function handleImageUpload(input) {
  const file = input.files[0]
  if (!file) return
  pendingImageFile = file
  const reader = new FileReader()
  reader.onload = e => {
    document.getElementById('imgPreview').src = e.target.result
    document.getElementById('imgPreviewWrap').style.display = 'block'
  }
  reader.readAsDataURL(file)
}
function clearImage() {
  pendingImageFile = null
  document.getElementById('imgPreviewWrap').style.display = 'none'
  document.getElementById('imgPreview').src = ''
}

// แปลง File → base64 string (ไม่มี prefix data:...)
function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader()
    reader.onload = e => resolve(e.target.result.split(',')[1])
    reader.onerror = reject
    reader.readAsDataURL(file)
  })
}

// ส่งรูปเป็น base64 JSON — ทำงานได้ทั้ง localhost และ Netlify serverless
async function sendImage() {
  if (!pendingImageFile || !activeChatId) return
  const file = pendingImageFile
  clearImage()
  try {
    const base64 = await fileToBase64(file)
    const r = await fetch('/ecommerce/chat/' + activeChatId + '/upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageBase64: base64, mimeType: file.type, filename: file.name || 'image.jpg' })
    })
    const j = await apiJson(r)
    if (j.ok) { await loadChatMessages() }
    else { alert('ส่งรูปไม่สำเร็จ: ' + j.error) }
  } catch (e) {
    alert('ส่งรูปไม่สำเร็จ: ' + e.message)
  }
}

// ─── Filter chat list ─────────────────────────────────────────────────────────
function filterChatList(q) {
  const lower = q.toLowerCase()
  document.querySelectorAll('#chatList .chat-item').forEach(el => {
    el.style.display = el.dataset.name.toLowerCase().includes(lower) ? '' : 'none'
  })
}

// ─── Chat auto-poll ───────────────────────────────────────────────────────────
let _chatPollTimer = null

function startChatPolling() {
  if (_chatPollTimer) return
  _chatPollTimer = setInterval(async () => {
    // refresh messages ของแชทที่เปิดอยู่
    if (activeChatId) await loadChatMessages()
    // refresh chat list sidebar
    await refreshChatList()
  }, 5000)
}

function stopChatPolling() {
  clearInterval(_chatPollTimer)
  _chatPollTimer = null
}

async function refreshChatList() {
  try {
    const chats = await fetch('/ecommerce/api/chats').then(r => r.json())
    const list = document.getElementById('chatList')
    if (!list || !Array.isArray(chats)) return

    chats.forEach(c => {
      const existing = list.querySelector(`.chat-item[data-id="${c.id}"]`)
      if (!existing) {
        // แชทใหม่ — เพิ่มขึ้นบนสุด
        const av = (c.customer_name || '?')[0].toUpperCase()
        const timeStr = c.last_message_at ? new Date(c.last_message_at).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : ''
        const div = document.createElement('div')
        div.className = 'chat-item'
        div.dataset.id = c.id
        div.dataset.name = c.customer_name || 'ลูกค้า'
        div.dataset.avatar = av
        div.onclick = function(){ selectChat(this) }
        div.innerHTML = `
          <div class="chat-avatar">${escHtml(av)}</div>
          <div class="chat-info">
            <div class="chat-name">${escHtml(c.customer_name || 'ลูกค้า')}</div>
            <div class="chat-preview" id="preview-${c.id}">${escHtml(c.last_message || '')}</div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
            <div class="chat-time" id="time-${c.id}">${timeStr}</div>
            ${c.unread_count > 0 ? `<div class="chat-unread" id="unread-${c.id}">${c.unread_count}</div>` : `<div id="unread-${c.id}"></div>`}
          </div>`
        list.prepend(div)
      } else {
        // อัปเดต preview + unread ของแชทที่มีอยู่แล้ว
        const previewEl = document.getElementById('preview-' + c.id)
        const unreadEl  = document.getElementById('unread-' + c.id)
        const timeEl    = document.getElementById('time-' + c.id)
        if (previewEl) previewEl.textContent = c.last_message || ''
        if (timeEl && c.last_message_at) timeEl.textContent = new Date(c.last_message_at).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'})
        if (unreadEl) {
          if (c.id === activeChatId) {
            unreadEl.textContent = ''
          } else if (c.unread_count > 0) {
            unreadEl.className = 'chat-unread'
            unreadEl.textContent = c.unread_count
          } else {
            unreadEl.textContent = ''
          }
        }
      }
    })
  } catch(_) {}
}

// เริ่ม polling เมื่อเปิด tab แชท
document.addEventListener('DOMContentLoaded', () => {
  if (document.getElementById('tab-chat')?.style.display !== 'none') startChatPolling()
})

// ─── สร้างบิลจากแชท ───────────────────────────────────────────────────────────
function openCreateOrderForChat() {
  const name = document.getElementById('cwName').textContent
  openModal('addOrderModal')
  setTimeout(() => {
    const f = document.querySelector('[name="customer_name"]')
    if (f) f.value = name
  }, 50)
}

// ─── QR PromptPay ─────────────────────────────────────────────────────────────
const QR_DEFAULT_TEMPLATE = 'กรุณาโอน {amount} บาท\nขอบคุณที่ใช้บริการนะคะ 🙏'
let _qrPayload = ''
let _qrDebounce = null

function openQRModal() {
  openModal('qrModal')
  const ta = document.getElementById('qrAutoMsg')
  if (!ta.value) ta.value = localStorage.getItem('bizflow_qr_template') || QR_DEFAULT_TEMPLATE
  renderQR()
}

function generatePromptPayPayload(raw, amount) {
  const cleaned = raw.replace(/\D/g,'')
  let id = (cleaned.length >= 10 && cleaned.startsWith('0')) ? '0066' + cleaned.slice(1) : cleaned
  const f = (tag, v) => tag + v.length.toString().padStart(2,'0') + v
  const ma = f('00','A000000677010111') + f('01', id)
  let data = f('00','01') + f('01','12') + f('29', ma) + f('53','764') +
    (parseFloat(amount) > 0 ? f('54', parseFloat(amount).toFixed(2)) : '') +
    f('58','TH') + f('59','N/A') + f('60','Bangkok') + '6304'
  let crc = 0xFFFF
  for (let i = 0; i < data.length; i++) {
    crc ^= data.charCodeAt(i) << 8
    for (let j = 0; j < 8; j++) crc = (crc & 0x8000) ? ((crc<<1)^0x1021)&0xFFFF : (crc<<1)&0xFFFF
  }
  return data + crc.toString(16).toUpperCase().padStart(4,'0')
}

// debounce render เพื่อไม่ให้ rebuild ทุก keystroke
function renderQR() {
  clearTimeout(_qrDebounce)
  _qrDebounce = setTimeout(_doRenderQR, 280)
}

function _doRenderQR() {
  const id  = (document.getElementById('qrPromptPayId').value || '').trim()
  const wrap   = document.getElementById('qrCanvas')
  const status = document.getElementById('qrStatus')
  if (!id) { wrap.innerHTML = ''; _qrPayload = ''; status.textContent = 'กรอกเบอร์โทร/Tax ID เพื่อสร้าง QR'; return }
  if (!window.QRCode) { status.textContent = 'กำลังโหลด QR library...'; return }
  try {
    const amt = document.getElementById('qrAmount').value || 0
    _qrPayload = generatePromptPayPayload(id, amt)
    status.textContent = `PromptPay: ${id}${parseFloat(amt)>0?' · ฿'+parseFloat(amt).toLocaleString('th-TH',{minimumFractionDigits:2}):''}`
    buildQRCanvas().then(c => { if (!c) return; wrap.innerHTML = ''; c.style.maxWidth='100%'; wrap.appendChild(c) })
  } catch(e) { status.textContent = 'ข้อมูลไม่ถูกต้อง' }
}

// สร้าง canvas ที่มีกรอบสวย + โลโก้ตรงกลาง
function buildQRCanvas() {
  return new Promise(resolve => {
    if (!_qrPayload || !window.QRCode) { resolve(null); return }

    const color   = document.getElementById('qrFrameColor').value || '#1a56db'
    const logoUrl = (document.getElementById('qrLogoUrl').value || '').trim()
    const amt     = parseFloat(document.getElementById('qrAmount').value) || 0
    const idText  = document.getElementById('qrPromptPayId').value || ''
    const QS = 210, PAD = 18, HDR = 64, FTR = 44
    const W = QS + PAD * 2, H = QS + PAD * 2 + HDR + FTR

    // render QR ดิบไว้ใน hidden div
    const tmp = document.createElement('div')
    tmp.style.cssText = 'position:fixed;left:-9999px;top:-9999px;'
    document.body.appendChild(tmp)
    new QRCode(tmp, { text: _qrPayload, width: QS, height: QS, correctLevel: QRCode.CorrectLevel.H })

    setTimeout(async () => {
      const qrC = tmp.querySelector('canvas')
      document.body.removeChild(tmp)

      const c = document.createElement('canvas')
      c.width = W; c.height = H
      const ctx = c.getContext('2d')

      // เงา + พื้นขาว
      ctx.shadowColor = 'rgba(0,0,0,0.12)'; ctx.shadowBlur = 14; ctx.shadowOffsetY = 4
      ctx.fillStyle = '#ffffff'; rrect(ctx,0,0,W,H,16); ctx.fill()
      ctx.shadowBlur = 0; ctx.shadowOffsetY = 0

      // header สี
      ctx.fillStyle = color; rrectTop(ctx,0,0,W,HDR,16); ctx.fill()
      ctx.fillStyle = '#fff'; ctx.textAlign = 'center'
      ctx.font = 'bold 16px "Segoe UI",sans-serif'
      ctx.fillText('💳  PromptPay', W/2, 28)
      ctx.font = '13px "Segoe UI",sans-serif'
      ctx.fillText(amt > 0 ? '฿' + amt.toLocaleString('th-TH',{minimumFractionDigits:2}) : 'สแกนเพื่อชำระเงิน', W/2, 50)

      // วาด QR
      const qrX = PAD, qrY = HDR + PAD
      if (qrC) ctx.drawImage(qrC, qrX, qrY, QS, QS)

      // กรอบ border
      ctx.strokeStyle = color; ctx.lineWidth = 3; rrect(ctx,1.5,1.5,W-3,H-3,16); ctx.stroke()

      // footer
      const fy = qrY + QS + 10
      ctx.fillStyle = '#9ca3af'; ctx.font = '11px "Segoe UI",sans-serif'; ctx.textAlign = 'center'
      ctx.fillText(idText, W/2, fy + 10)
      ctx.fillStyle = color; ctx.font = 'bold 10px "Segoe UI",sans-serif'
      ctx.fillText('Thai QR Payment Standard', W/2, fy + 28)

      // โลโก้ตรงกลาง QR
      if (logoUrl) {
        try { await drawLogoOn(ctx, logoUrl, W/2, qrY + QS/2, 46) } catch(_) {}
      }

      resolve(c)
    }, 100)
  })
}

// วาดโลโก้วงกลมลงบน canvas
function drawLogoOn(ctx, url, cx, cy, size) {
  return new Promise((resolve, reject) => {
    const img = new Image()
    img.crossOrigin = 'anonymous'
    img.onload = () => {
      // วงขาวรองรับ
      ctx.beginPath(); ctx.arc(cx, cy, size/2 + 5, 0, Math.PI*2)
      ctx.fillStyle = '#fff'; ctx.fill()
      // clip วงกลมแล้ววาดรูป
      ctx.save()
      ctx.beginPath(); ctx.arc(cx, cy, size/2, 0, Math.PI*2); ctx.clip()
      ctx.drawImage(img, cx-size/2, cy-size/2, size, size)
      ctx.restore()
      resolve()
    }
    img.onerror = reject
    img.src = url
  })
}

// helper rounded rect (ครบ 4 มุม)
function rrect(ctx, x, y, w, h, r) {
  ctx.beginPath()
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.arcTo(x+w,y,x+w,y+r,r)
  ctx.lineTo(x+w,y+h-r); ctx.arcTo(x+w,y+h,x+w-r,y+h,r)
  ctx.lineTo(x+r,y+h); ctx.arcTo(x,y+h,x,y+h-r,r)
  ctx.lineTo(x,y+r); ctx.arcTo(x,y,x+r,y,r); ctx.closePath()
}
// helper rounded rect เฉพาะมุมบน (สำหรับ header)
function rrectTop(ctx, x, y, w, h, r) {
  ctx.beginPath()
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.arcTo(x+w,y,x+w,y+r,r)
  ctx.lineTo(x+w,y+h); ctx.lineTo(x,y+h)
  ctx.lineTo(x,y+r); ctx.arcTo(x,y,x+r,y,r); ctx.closePath()
}

function downloadQR() {
  buildQRCanvas().then(c => {
    if (!c) { alert('สร้าง QR ก่อน'); return }
    const a = document.createElement('a'); a.download = 'promptpay-qr.png'; a.href = c.toDataURL(); a.click()
  })
}

function saveQRTemplate() {
  const msg = document.getElementById('qrAutoMsg').value
  localStorage.setItem('bizflow_qr_template', msg)
  const btn = event.target; btn.textContent = '✓ บันทึกแล้ว'
  setTimeout(() => { btn.textContent = '💾 บันทึก' }, 1800)
}

async function sendQRToChat() {
  if (!activeChatId) { alert('เลือกแชทก่อน แล้วค่อยส่ง QR'); closeModal('qrModal'); return }
  if (!_qrPayload) { alert('สร้าง QR ก่อน'); return }
  const amt    = parseFloat(document.getElementById('qrAmount').value) || 0
  const rawMsg = (document.getElementById('qrAutoMsg').value || '').trim()
  const autoMsg = rawMsg ? rawMsg.replace(/\{amount\}/gi, amt > 0 ? amt.toLocaleString('th-TH',{minimumFractionDigits:2}) : '') : ''
  try {
    const c = await buildQRCanvas()
    if (!c) { alert('สร้าง QR ก่อน'); return }
    const base64 = c.toDataURL('image/png').split(',')[1]
    const r = await fetch('/ecommerce/chat/' + activeChatId + '/upload', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageBase64: base64, mimeType: 'image/png', filename: 'qr-payment.png' })
    })
    const j = await apiJson(r)
    if (!j.ok) { alert('ส่ง QR ไม่สำเร็จ: ' + j.error); return }
    if (autoMsg) {
      await fetch('/ecommerce/chat/' + activeChatId + '/reply', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: autoMsg })
      })
    }
    closeModal('qrModal')
    await loadChatMessages()
  } catch (e) { alert('ส่ง QR ไม่สำเร็จ: ' + e.message) }
}

function closePanel() {
  document.getElementById('panelOverlay').classList.remove('open')
  document.getElementById('orderPanel').classList.remove('open')
}

// Edit store modal
function openEditStoreBtn(btn) {
  const d = btn.dataset
  openEditStore(d.id, d.name, d.platform, d.channelId, d.accessToken, d.senderName, d.senderPhone, d.senderAddress)
}
function openEditStore(id, name, platform, channelId, accessToken, senderName, senderPhone, senderAddress) {
  document.getElementById('editStoreForm').action = '/ecommerce/stores/' + id
  document.getElementById('es_store_name').value = name
  document.getElementById('es_channel_id').value = channelId
  document.getElementById('es_access_token').value = accessToken
  document.getElementById('es_sender_name').value = senderName
  document.getElementById('es_sender_phone').value = senderPhone
  document.getElementById('es_sender_address').value = senderAddress
  openModal('editStoreModal')
}

// Add item row
let itemIdx = 1
function addItemRow() {
  const wrap = document.getElementById('orderItemsWrap')
  const div = document.createElement('div')
  div.className = 'order-item-row'
  div.style.cssText = 'display:grid;grid-template-columns:1fr 100px 110px auto;gap:8px;margin-bottom:8px;align-items:center;'
  div.innerHTML = `
    <input type="text" name="items[${itemIdx}][product_name]" class="form-control" placeholder="ชื่อสินค้า" style="font-size:13px;">
    <input type="number" name="items[${itemIdx}][qty]" class="form-control" placeholder="จำนวน" value="1" min="1" style="font-size:13px;">
    <input type="number" name="items[${itemIdx}][unit_price]" class="form-control" placeholder="ราคา" step="0.01" style="font-size:13px;">
    <button type="button" class="btn btn-danger btn-xs" onclick="this.closest('.order-item-row').remove()">ลบ</button>`
  wrap.appendChild(div)
  itemIdx++
}

// Copy text
function copyText(elId) {
  const text = document.getElementById(elId).textContent
  navigator.clipboard.writeText(text).then(() => alert('คัดลอกแล้ว: ' + text))
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
}

// Show/hide API fields
function showPlatformFields() {
  const val = document.getElementById('platformSelect').value
  document.getElementById('apiFields').style.display = val === 'manual' ? 'none' : 'block'
}

// Verify LINE token
async function verifyToken(storeId, btn) {
  const el = document.getElementById('verify-' + storeId)
  btn.disabled = true
  btn.textContent = 'กำลังตรวจสอบ...'
  el.textContent = ''
  try {
    const r = await fetch('/ecommerce/api/verify-line/' + storeId).then(r => r.json())
    if (r.ok) {
      el.innerHTML = `<span style="color:var(--success);">✓ เชื่อมต่อสำเร็จ — ${escHtml(r.botName)}</span>`
      btn.textContent = '✓ ผ่าน'
    } else {
      el.innerHTML = `<span style="color:var(--danger);">✗ ${escHtml(r.error)}</span>`
      btn.textContent = '🔍 ทดสอบ Token'
    }
  } catch (e) {
    el.innerHTML = `<span style="color:var(--danger);">✗ เชื่อมต่อ server ไม่ได้</span>`
    btn.textContent = '🔍 ทดสอบ Token'
  }
  btn.disabled = false
}

// Read CSV file and fill textarea
function readCSVFile(input) {
  const file = input.files[0]
  if (!file) return
  const reader = new FileReader()
  reader.onload = e => {
    document.querySelector('[name="csv_data"]').value = e.target.result
  }
  reader.readAsText(file, 'UTF-8')
}

// ─── Products tab ─────────────────────────────────────────────────────────────
function filterProducts(q) {
  const lower = q.toLowerCase()
  document.querySelectorAll('#productGrid .product-card').forEach(card => {
    const name = card.dataset.name || ''
    const sku  = card.dataset.sku  || ''
    card.style.display = (name.includes(lower) || sku.includes(lower)) ? '' : 'none'
  })
}

function filterProductsByStatus(val) {
  document.querySelectorAll('#productGrid .product-card').forEach(card => {
    if (!val) { card.style.display = ''; return }
    const status = card.dataset.status
    if (val === 'out_of_stock') {
      const stockEl = card.querySelector('.product-stock')
      card.style.display = (stockEl && stockEl.textContent.includes('❌')) ? '' : 'none'
    } else {
      card.style.display = status === val ? '' : 'none'
    }
  })
}

function openEditProduct(btn) {
  const d = btn.dataset
  document.getElementById('editProductForm').action = '/ecommerce/products/' + d.id + '/update'
  document.getElementById('ep_name').value          = d.name || ''
  document.getElementById('ep_sku').value           = d.sku || ''
  document.getElementById('ep_price').value         = d.price || ''
  document.getElementById('ep_compare_price').value = d.comparePrice || ''
  document.getElementById('ep_cost').value          = d.cost || ''
  document.getElementById('ep_stock').value         = d.stock || 0
  document.getElementById('ep_image_url').value     = d.imageUrl || ''
  document.getElementById('ep_category').value      = d.category || ''
  document.getElementById('ep_description').value   = d.description || ''
  document.getElementById('ep_status').value        = d.status || 'active'
  openModal('editProductModal')
}

// ─── Webhook diagnostic ────────────────────────────────────────────────────────
async function loadWebhookLog() {
  try {
    const logs = await fetch('/ecommerce/api/webhook-log').then(r => r.json())
    const wrap = document.getElementById('webhookLogWrap')
    const box  = document.getElementById('webhookStatusBox')
    if (!logs.length) {
      wrap.textContent = '(ยังไม่มี Webhook เข้ามาเลยตั้งแต่ server start)'
      box.style.background = 'var(--danger-dim)'
      box.style.color = 'var(--danger)'
      box.innerHTML = '❌ LINE ยังไม่ได้ส่ง Webhook มา — ตรวจสอบ Webhook URL ใน LINE Developers Console'
    } else {
      wrap.innerHTML = logs.map(l =>
        `<div style="padding:3px 0;border-bottom:1px solid var(--border-2);">[${l.time.slice(11,19)}] store:${l.storeId.slice(0,8)}… events:${l.events} — ${escHtml(l.body)}</div>`
      ).reverse().join('')
      box.style.background = 'var(--success-dim)'
      box.style.color = 'var(--success)'
      box.innerHTML = `✅ LINE ส่ง Webhook มาแล้ว ${logs.length} ครั้ง — ระบบทำงานปกติ`
    }
  } catch(e) {
    document.getElementById('webhookLogWrap').textContent = 'โหลดไม่ได้: ' + e.message
  }
}

// Handle URL tab param
const urlP = new URLSearchParams(location.search)
const _tabParam = urlP.get('tab')
if (_tabParam && _tabParam !== 'orders') {
  const _tabMap = { chat: 2, products: 3, settings: 4 }
  const _nth = _tabMap[_tabParam]
  const _btn = _nth ? document.querySelector(`.tab-btn:nth-child(${_nth})`) : null
  if (_btn) {
    document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none')
    const _pane = document.getElementById('tab-' + _tabParam)
    if (_pane) _pane.style.display = 'block'
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
    _btn.classList.add('active')
  }
}
