<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ใบปะหน้าพัสดุ - <%= order.customer_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Prompt', sans-serif;
  background: #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 24px 16px;
  color: #000;
}

/* ─── Toolbar ─── */
.no-print {
  margin-bottom: 16px;
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.btn-print {
  padding: 10px 28px;
  background: linear-gradient(135deg, #ea580c, #f97316);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  font-family: 'Prompt', sans-serif;
  box-shadow: 0 4px 14px rgba(249,115,22,0.35);
}
.btn-back {
  padding: 10px 18px;
  background: #fff;
  color: #444;
  border: 1.5px solid #ccc;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  text-decoration: none;
  font-family: 'Prompt', sans-serif;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* ─── Label card ─── */
.label {
  width: 100mm;
  background: #fff;
  border: 2px solid #000;
  font-family: 'Prompt', sans-serif;
  color: #000;
  box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}

/* ─── Section 1: Top barcode ─── */
.sec-top {
  padding: 7px 8px 5px;
  text-align: center;
  border-bottom: 1.5px solid #000;
}
.sec-top svg { width: 100%; height: 52px; display: block; }
.top-tracking {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 2.5px;
  margin-top: 3px;
  font-family: monospace, 'Prompt', sans-serif;
}
.top-meta {
  font-size: 8.5px;
  color: #555;
  margin-top: 2px;
  letter-spacing: 0.3px;
}
.no-tracking-placeholder {
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #aaa;
  border: 1.5px dashed #ccc;
  border-radius: 4px;
  margin-bottom: 4px;
}

/* ─── Section 2: COD / Paid banner ─── */
.sec-banner {
  padding: 5px 10px;
  text-align: center;
  border-bottom: 1.5px solid #000;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 0.5px;
}
.banner-cod  { background: #000; color: #fff; }
.banner-paid { background: #fff; color: #000; border-bottom-width: 1.5px; }

/* ─── Section 3: Address (left) + Zone/QR (right) ─── */
.sec-addr {
  display: flex;
  border-bottom: 1.5px solid #000;
  min-height: 45mm;
}
.addr-left {
  flex: 1;
  padding: 7px 9px;
  border-right: 1.5px solid #000;
}
.lbl-tag {
  font-size: 7.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #666;
  margin-bottom: 2px;
}
.addr-name-to {
  font-size: 15px;
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 2px;
}
.addr-name-from {
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 1px;
}
.addr-phone {
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 2px;
}
.addr-detail {
  font-size: 10px;
  line-height: 1.55;
  color: #222;
}
.addr-sep {
  border: none;
  border-top: 1px dashed #bbb;
  margin: 6px 0;
}

/* ─── Zone + QR column ─── */
.zone-col {
  width: 27mm;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 8px 5px;
}
.zone-box {
  width: 20mm;
  height: 20mm;
  background: #000;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.zone-lbl { font-size: 6.5px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.65; }
.zone-code { font-size: 24px; font-weight: 900; line-height: 1; }
#qr-div canvas, #qr-div img { width: 20mm !important; height: 20mm !important; display: block; }

/* ─── Section 4: Carrier + secondary barcode ─── */
.sec-carrier {
  display: flex;
  align-items: center;
  border-bottom: 1.5px solid #000;
  padding: 5px 9px;
  gap: 8px;
}
.carrier-name {
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
  min-width: 18mm;
  line-height: 1.3;
}
.carrier-right { flex: 1; text-align: center; }
.carrier-right svg { width: 100%; height: 28px; display: block; }
.carrier-label { font-size: 8px; color: #555; margin-top: 2px; letter-spacing: 0.5px; }

/* ─── Section 5: Items ─── */
.sec-items {
  padding: 6px 9px;
  border-bottom: 1.5px solid #000;
}
.items-hdr {
  font-size: 7.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #777;
  margin-bottom: 4px;
}
.item-row {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  padding: 1.5px 0;
  color: #1a1a1a;
}
.item-total {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
  font-weight: 800;
  border-top: 1px solid #ccc;
  margin-top: 4px;
  padding-top: 4px;
}
.item-note {
  font-size: 9px;
  color: #555;
  background: #f5f5f5;
  border-left: 2.5px solid #000;
  padding: 3px 6px;
  margin-top: 5px;
  line-height: 1.5;
}

/* ─── Section 6: Footer ─── */
.sec-footer {
  display: flex;
  justify-content: space-between;
  padding: 4px 9px;
  font-size: 7.5px;
  color: #888;
}

/* ─── Print ─── */
@media print {
  body { background: #fff; padding: 0; margin: 0; }
  .no-print { display: none !important; }
  .label {
    width: 100%;
    max-width: 100mm;
    box-shadow: none;
    border: 1.5px solid #000;
  }
  @page {
    size: 100mm auto;
    margin: 2mm;
  }
}
</style>
</head>
<body>

<div class="no-print">
  <a href="/ecommerce" class="btn-back">← กลับ</a>
  <button class="btn-print" onclick="window.print()">🖨️ พิมพ์ Label</button>
  <% if (!order.label_printed) { %>
  <button class="btn-back" onclick="markPrinted()" style="border-color:#22c55e;color:#22c55e;font-weight:700;">✓ ทำเครื่องหมายว่าปริ้นแล้ว</button>
  <% } else { %>
  <span style="padding:10px;font-size:13px;color:#22c55e;font-weight:700;">✓ ปริ้นแล้ว <%= order.label_printed_at ? new Date(order.label_printed_at).toLocaleString('th-TH') : '' %></span>
  <% } %>
</div>

<%
  const store = order.store || {}
  const senderName = store.sender_name || company.name
  const senderPhone = store.sender_phone || company.phone
  const senderAddress = store.sender_address || company.address
  const isPaid = order.payment_method !== 'cod'
  const fullAddress = [
    order.customer_address,
    order.customer_district,
    order.customer_province,
    order.customer_postal_code
  ].filter(Boolean).join(' ')
  const postalCode = (order.customer_postal_code || '').trim()
  const sortZone = postalCode
    ? postalCode.slice(0, 2)
    : (order.customer_province ? order.customer_province.charAt(0) + '??' : '??')
  const platformLabel = order.platform === 'line_shopping' ? 'LINE Shopping'
    : order.platform === 'myshop' ? 'MyShop'
    : order.platform === 'manual' ? 'ออเดอร์ตรง'
    : (order.platform || '')
  const qrData = order.tracking_no || order.platform_order_id || String(order.id)
  const secBarcodeData = order.tracking_no || order.platform_order_id || null
%>

<div class="label">

  <!-- ① Main barcode (tracking number) -->
  <div class="sec-top">
    <% if (order.tracking_no) { %>
    <svg id="bc-main"></svg>
    <div class="top-tracking"><%= order.tracking_no %></div>
    <% } else { %>
    <div class="no-tracking-placeholder">ยังไม่มีเลขพัสดุ</div>
    <% } %>
    <div class="top-meta">
      <%= order.shipping_provider || 'ไปรษณีย์ไทย' %><% if (platformLabel) { %> · <%= platformLabel %><% } %><% if (order.platform_order_id) { %> · #<%= order.platform_order_id %><% } %>
    </div>
  </div>

  <!-- ② COD / Paid banner -->
  <div class="sec-banner <%= isPaid ? 'banner-paid' : 'banner-cod' %>">
    <% if (!isPaid) { %>
    เก็บเงินปลายทาง (COD) &nbsp;฿<%= (parseFloat(order.total)||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %>
    <% } else { %>
    ชำระเงินแล้ว (โอนเงิน / บัตรเครดิต)
    <% } %>
  </div>

  <!-- ③ Address + Zone/QR -->
  <div class="sec-addr">
    <div class="addr-left">
      <!-- FROM -->
      <div class="lbl-tag">ผู้ส่ง (FROM)</div>
      <div class="addr-name-from"><%= senderName %></div>
      <% if (senderPhone) { %><div class="addr-phone">☎ <%= senderPhone %></div><% } %>
      <% if (senderAddress) { %><div class="addr-detail"><%= senderAddress %></div><% } %>

      <hr class="addr-sep">

      <!-- TO -->
      <div class="lbl-tag">ผู้รับ (TO)</div>
      <div class="addr-name-to"><%= order.customer_name || 'ลูกค้า' %></div>
      <% if (order.customer_phone) { %><div class="addr-phone">☎ <%= order.customer_phone %></div><% } %>
      <div class="addr-detail"><%= fullAddress || 'ไม่ระบุที่อยู่' %></div>
    </div>

    <!-- Zone box + QR code -->
    <div class="zone-col">
      <div class="zone-box">
        <span class="zone-lbl">Zone</span>
        <span class="zone-code"><%= sortZone %></span>
      </div>
      <div id="qr-div"></div>
    </div>
  </div>

  <!-- ④ Carrier + secondary barcode -->
  <div class="sec-carrier">
    <div class="carrier-name"><%= order.shipping_provider || 'ไปรษณีย์ไทย' %></div>
    <div class="carrier-right">
      <% if (secBarcodeData) { %>
      <svg id="bc-sec"></svg>
      <% } %>
      <div class="carrier-label">Order: <%= order.order_no || order.platform_order_id || order.id.slice(0,8).toUpperCase() %></div>
    </div>
  </div>

  <!-- ⑤ Items -->
  <div class="sec-items">
    <div class="items-hdr">รายการสินค้า</div>
    <% (order.items || []).forEach(item => { %>
    <div class="item-row">
      <span><%= item.product_name %><% if(item.variant){ %> (<%= item.variant %>)<% } %> × <%= item.qty %></span>
      <span>฿<%= (parseFloat(item.line_total)||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></span>
    </div>
    <% }) %>
    <% if (parseFloat(order.shipping_fee) > 0) { %>
    <div class="item-row" style="color:#666;">
      <span>ค่าส่ง</span>
      <span>฿<%= (parseFloat(order.shipping_fee)||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></span>
    </div>
    <% } %>
    <div class="item-total">
      <span>รวมทั้งสิ้น</span>
      <span>฿<%= (parseFloat(order.total)||0).toLocaleString('th-TH',{minimumFractionDigits:0}) %></span>
    </div>
    <% if (order.notes) { %>
    <div class="item-note">หมายเหตุ: <%= order.notes %></div>
    <% } %>
  </div>

  <!-- ⑥ Footer -->
  <div class="sec-footer">
    <span>พิมพ์: <%= new Date().toLocaleString('th-TH') %></span>
    <span>BizFlow</span>
  </div>

</div>

<script>
<%  if (order.tracking_no) { %>
JsBarcode('#bc-main', <%- JSON.stringify(order.tracking_no) %>, {
  format: 'CODE128',
  width: 1.6,
  height: 50,
  displayValue: false,
  margin: 0,
  lineColor: '#000'
})
<% } %>

<% if (secBarcodeData) { %>
JsBarcode('#bc-sec', <%- JSON.stringify(secBarcodeData) %>, {
  format: 'CODE128',
  width: 1.3,
  height: 26,
  displayValue: false,
  margin: 0,
  lineColor: '#000'
})
<% } %>

new QRCode(document.getElementById('qr-div'), {
  text: <%- JSON.stringify(qrData) %>,
  width: 76,
  height: 76,
  colorDark: '#000000',
  colorLight: '#ffffff',
  correctLevel: QRCode.CorrectLevel.M
})

async function markPrinted() {
  await fetch('/ecommerce/orders/<%= order.id %>/label-printed', { method: 'POST' })
  location.reload()
}
</script>
</body>
</html>
