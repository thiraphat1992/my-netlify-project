<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p>ภาพรวมธุรกิจประจำเดือน <%= new Date().toLocaleDateString('th-TH', {month:'long', year:'numeric'}) %></p>
  </div>
  <div class="page-header-actions">
    <a href="/income" class="btn btn-secondary btn-sm">+ เพิ่มรายรับ-รายจ่าย</a>
    <a href="/sales/new" class="btn btn-primary btn-sm">+ สร้างงานขาย</a>
  </div>
</div>

<div class="stats-grid stats-4">
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(16,185,129,0.1);">💰</div>
    <div class="stat-label">รายรับเดือนนี้</div>
    <div class="stat-value" style="color:#10b981;">฿<%= (stats.totalIncome || 0).toLocaleString('th-TH', {minimumFractionDigits:0}) %></div>
    <div class="stat-sub">รายรับสุทธิ</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(239,68,68,0.1);">💸</div>
    <div class="stat-label">รายจ่ายเดือนนี้</div>
    <div class="stat-value" style="color:#ef4444;">฿<%= (stats.totalExpense || 0).toLocaleString('th-TH', {minimumFractionDigits:0}) %></div>
    <div class="stat-sub">รายจ่ายสุทธิ</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(99,102,241,0.1);">📊</div>
    <div class="stat-label">กำไรสุทธิ</div>
    <div class="stat-value" style="color:<%= (stats.balance||0) >= 0 ? '#6366f1' : '#ef4444' %>;">฿<%= (stats.balance || 0).toLocaleString('th-TH', {minimumFractionDigits:0}) %></div>
    <div class="stat-sub">รายรับ - รายจ่าย</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(139,92,246,0.1);">👥</div>
    <div class="stat-label">พนักงานทั้งหมด</div>
    <div class="stat-value"><%= stats.totalEmployees || 0 %></div>
    <div class="stat-sub">คน (active)</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:3fr 2fr;gap:20px;">
  <!-- รายการล่าสุด -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">📋 รายรับ-รายจ่ายล่าสุด</span>
      <a href="/income" class="btn btn-secondary btn-xs">ดูทั้งหมด</a>
    </div>
    <% if (recentTransactions && recentTransactions.length > 0) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>วันที่</th>
            <th>รายละเอียด</th>
            <th>หมวดหมู่</th>
            <th style="text-align:right;">จำนวน</th>
          </tr>
        </thead>
        <tbody>
          <% recentTransactions.forEach(t => { %>
            <tr>
              <td style="color:var(--text-3);font-size:12.5px;"><%= new Date(t.transaction_date).toLocaleDateString('th-TH', {day:'numeric',month:'short'}) %></td>
              <td><%= t.description %></td>
              <td><span class="badge <%= t.type === 'income' ? 'badge-success' : 'badge-danger' %>"><%= t.category?.name || '-' %></span></td>
              <td style="text-align:right;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;color:<%= t.type==='income'?'#10b981':'#ef4444' %>;">
                <%= t.type==='income'?'+':'-' %>฿<%= parseFloat(t.amount).toLocaleString('th-TH',{minimumFractionDigits:2}) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <div class="empty-title">ยังไม่มีรายการ</div>
        <div class="empty-desc"><a href="/income" style="color:var(--primary);">+ เพิ่มรายการแรก</a></div>
      </div>
    <% } %>
  </div>

  <!-- เมนูด่วน + งานขายล่าสุด -->
  <div style="display:flex;flex-direction:column;gap:20px;">
    <div class="card">
      <div class="card-header"><span class="card-title">⚡ เมนูด่วน</span></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
        <a href="/sales/new" style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--primary-dim);border-radius:50px;text-decoration:none;color:var(--primary);font-size:13.5px;font-weight:600;border:1px solid var(--primary-border);transition:all 0.2s;">🧾 <span>สร้างบิลใหม่</span></a>
        <a href="/income" style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--surface-2);border-radius:50px;text-decoration:none;color:var(--text-2);font-size:13.5px;font-weight:500;border:1px solid var(--border);transition:all 0.2s;">➕ <span>เพิ่มรายรับ</span></a>
        <a href="/income" style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--surface-2);border-radius:50px;text-decoration:none;color:var(--text-2);font-size:13.5px;font-weight:500;border:1px solid var(--border);transition:all 0.2s;">➖ <span>เพิ่มรายจ่าย</span></a>
        <a href="/hr/employees/new" style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--surface-2);border-radius:50px;text-decoration:none;color:var(--text-2);font-size:13.5px;font-weight:500;border:1px solid var(--border);transition:all 0.2s;">👤 <span>เพิ่มพนักงาน</span></a>
      </div>
    </div>

    <% if (recentOrders && recentOrders.length > 0) { %>
    <div class="card">
      <div class="card-header">
        <span class="card-title">🧾 งานขายล่าสุด</span>
        <a href="/sales" class="btn btn-secondary btn-xs">ดูทั้งหมด</a>
      </div>
      <div style="padding:4px 0;">
        <% recentOrders.forEach(o => { %>
          <div style="padding:10px 18px;border-bottom:1px solid var(--border-2);display:flex;align-items:center;justify-content:space-between;">
            <div>
              <div style="font-size:13px;font-weight:600;color:var(--text)"><%= o.doc_no %></div>
              <div style="font-size:11.5px;color:var(--text-4)"><%= o.customer_name || '-' %></div>
            </div>
            <span class="badge <%= o.payment_status==='paid'?'badge-success':o.payment_status==='cancelled'?'badge-danger':'badge-warning' %>">
              <%= o.payment_status==='paid'?'ชำระแล้ว':o.payment_status==='cancelled'?'ยกเลิก':'รอชำระ' %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
