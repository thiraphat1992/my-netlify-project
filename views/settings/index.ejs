<%- include('../partials/header') %>

<style>
.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: start;
}
@media (max-width: 900px) { .settings-grid { grid-template-columns: 1fr; } }

.settings-section { margin-bottom: 6px; }
.section-title {
  font-size: 11px; font-weight: 700; color: var(--text-3);
  text-transform: uppercase; letter-spacing: .8px; margin-bottom: 14px;
  display: flex; align-items: center; gap: 8px;
}
.section-title::after { content:''; flex:1; height:1px; background:var(--border); }

.connection-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 14px; background: var(--surface-2); border-radius: 8px;
  margin-bottom: 8px; border: 1px solid var(--border);
}
.connection-item:last-child { margin-bottom: 0; }
.conn-left  { display: flex; align-items: center; gap: 10px; }
.conn-icon  { font-size: 20px; }
.conn-name  { font-weight: 600; font-size: 13.5px; }
.conn-meta  { font-size: 11px; color: var(--text-3); margin-top: 1px; }
.conn-badge { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
.badge-on  { background: rgba(34,197,94,.12); color: #22c55e; }
.badge-off { background: rgba(100,100,100,.15); color: var(--text-3); }
</style>

<div class="page-header">
  <div>
    <h1>⚙️ ตั้งค่าระบบ</h1>
    <p>ข้อมูลบริษัท, การเชื่อมต่อ API, และการตั้งค่าต่างๆ</p>
  </div>
</div>

<% if (error && error.length) { %>
<div class="alert alert-error" style="margin-bottom:16px;">⚠️ <%= error[0] %></div>
<% } %>
<% if (success && success.length) { %>
<div class="alert alert-success" style="margin-bottom:16px;">✓ <%= success[0] %></div>
<% } %>

<div class="settings-grid">

  <!-- ─── LEFT COLUMN ─── -->
  <div>

    <!-- Company Info -->
    <div class="card settings-section">
      <div class="card-header"><span class="card-title">🏢 ข้อมูลบริษัท</span></div>
      <div class="card-body">
        <form action="/settings/company" method="POST">
          <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">ชื่อบริษัท / ร้านค้า</label>
            <input type="text" name="company_name" class="form-control" value="<%= cfg.company_name || '' %>" placeholder="บริษัท ABC จำกัด">
          </div>
          <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">เลขประจำตัวผู้เสียภาษี</label>
            <input type="text" name="company_tax_id" class="form-control" value="<%= cfg.company_tax_id || '' %>" placeholder="0000000000000 (13 หลัก)">
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
            <div class="form-group">
              <label class="form-label">เบอร์โทรศัพท์</label>
              <input type="text" name="company_phone" class="form-control" value="<%= cfg.company_phone || '' %>" placeholder="0x-xxxx-xxxx">
            </div>
            <div class="form-group">
              <label class="form-label">อีเมล</label>
              <input type="email" name="company_email" class="form-control" value="<%= cfg.company_email || '' %>" placeholder="info@company.com">
            </div>
          </div>
          <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">ที่อยู่</label>
            <textarea name="company_address" class="form-control" rows="2" placeholder="เลขที่ ถนน แขวง/ตำบล เขต/อำเภอ จังหวัด รหัสไปรษณีย์"><%= cfg.company_address || '' %></textarea>
          </div>
          <div class="form-group" style="margin-bottom:18px;">
            <label class="form-label">URL แอปพลิเคชัน (สำหรับ Webhook)</label>
            <input type="url" name="app_url" class="form-control" value="<%= cfg.app_url || '' %>" placeholder="https://your-domain.com">
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">💾 บันทึกข้อมูลบริษัท</button>
        </form>
      </div>
    </div>

    <!-- Info boxes -->
    <div class="card settings-section">
      <div class="card-header"><span class="card-title">ℹ️ ข้อมูลระบบ</span></div>
      <div class="card-body" style="display:grid;gap:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:8px 0;border-bottom:1px solid var(--border-2);">
          <span style="color:var(--text-3);">เวอร์ชัน</span>
          <span style="font-weight:600;">BizFlow 1.0</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:8px 0;border-bottom:1px solid var(--border-2);">
          <span style="color:var(--text-3);">Node.js Environment</span>
          <span style="font-weight:600;"><%= nodeEnv %></span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:8px 0;">
          <span style="color:var(--text-3);">App URL</span>
          <span style="font-weight:600;font-size:11px;color:var(--primary);"><%= cfg.app_url || appUrl || 'ยังไม่ได้ตั้งค่า' %></span>
        </div>
      </div>
    </div>

  </div>

  <!-- ─── RIGHT COLUMN ─── -->
  <div>

    <!-- Shopee -->
    <div class="card settings-section">
      <div class="card-header" style="justify-content:space-between;">
        <span class="card-title">🛒 Shopee</span>
        <a href="/shopee" class="btn btn-secondary btn-sm">จัดการร้าน →</a>
      </div>
      <div class="card-body">
        <% if (shopeeStores.length === 0) { %>
        <div style="text-align:center;padding:16px;color:var(--text-3);font-size:13px;">
          ยังไม่ได้เชื่อมต่อ —
          <a href="/shopee" style="color:var(--primary);">เชื่อมต่อร้าน Shopee</a>
        </div>
        <% } else { %>
        <% shopeeStores.forEach(s => { %>
        <div class="connection-item">
          <div class="conn-left">
            <span class="conn-icon">🛒</span>
            <div>
              <div class="conn-name"><%= s.store_name %></div>
              <div class="conn-meta">ซิงค์ล่าสุด: <%= s.last_sync_at ? new Date(s.last_sync_at).toLocaleString('th-TH') : 'ยังไม่เคยซิงค์' %></div>
            </div>
          </div>
          <span class="conn-badge <%= s.is_active ? 'badge-on' : 'badge-off' %>"><%= s.is_active ? 'เปิดใช้' : 'ปิด' %></span>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Lazada -->
    <div class="card settings-section">
      <div class="card-header" style="justify-content:space-between;">
        <span class="card-title">🟡 Lazada</span>
        <a href="/lazada" class="btn btn-secondary btn-sm">จัดการร้าน →</a>
      </div>
      <div class="card-body">
        <% if (lazadaStores.length === 0) { %>
        <div style="text-align:center;padding:16px;color:var(--text-3);font-size:13px;">
          ยังไม่ได้เชื่อมต่อ —
          <a href="/lazada" style="color:var(--primary);">เชื่อมต่อร้าน Lazada</a>
        </div>
        <% } else { %>
        <% lazadaStores.forEach(s => { %>
        <div class="connection-item">
          <div class="conn-left">
            <span class="conn-icon">🟡</span>
            <div>
              <div class="conn-name"><%= s.store_name %></div>
              <div class="conn-meta">ซิงค์ล่าสุด: <%= s.last_sync_at ? new Date(s.last_sync_at).toLocaleString('th-TH') : 'ยังไม่เคยซิงค์' %></div>
            </div>
          </div>
          <span class="conn-badge <%= s.is_active ? 'badge-on' : 'badge-off' %>"><%= s.is_active ? 'เปิดใช้' : 'ปิด' %></span>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <!-- LINE / MyShop -->
    <div class="card settings-section">
      <div class="card-header" style="justify-content:space-between;">
        <span class="card-title">📦 LINE / MyShop</span>
        <a href="/ecommerce" class="btn btn-secondary btn-sm">จัดการ →</a>
      </div>
      <div class="card-body">
        <% if (ecStores.length === 0) { %>
        <div style="text-align:center;padding:16px;color:var(--text-3);font-size:13px;">
          ยังไม่มีร้านค้า —
          <a href="/ecommerce" style="color:var(--primary);">ตั้งค่าร้านค้า</a>
        </div>
        <% } else { %>
        <% ecStores.forEach(s => { %>
        <div class="connection-item">
          <div class="conn-left">
            <span class="conn-icon"><%= s.platform === 'line_shopping' ? '💚' : s.platform === 'myshop' ? '🏪' : '📦' %></span>
            <div>
              <div class="conn-name"><%= s.store_name %></div>
              <div class="conn-meta"><%= s.platform === 'line_shopping' ? 'LINE Shopping' : s.platform === 'myshop' ? 'MyShop' : 'Manual' %></div>
            </div>
          </div>
          <span class="conn-badge <%= s.is_active ? 'badge-on' : 'badge-off' %>"><%= s.is_active ? 'เปิดใช้' : 'ปิด' %></span>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <!-- LINE API Keys (read-only from env) -->
    <div class="card settings-section">
      <div class="card-header"><span class="card-title">🔑 LINE API (จาก .env)</span></div>
      <div class="card-body" style="display:grid;gap:10px;">
        <div style="font-size:12px;color:var(--text-3);margin-bottom:6px;">ค่าเหล่านี้แก้ไขได้จากไฟล์ <code style="background:var(--surface-2);padding:1px 5px;border-radius:3px;">.env</code> บน server</div>
        <% const lineVars = [ ['LINE_CHANNEL_ID', lineChannelId], ['LINE_ACCESS_TOKEN', lineAccessToken] ] %>
        <% lineVars.forEach(([k, v]) => { %>
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;padding:7px 10px;background:var(--surface-2);border-radius:6px;">
          <span style="color:var(--text-3);font-family:monospace;"><%= k %></span>
          <span style="<%= v ? 'color:#22c55e' : 'color:var(--text-3)' %>"><%= v ? '✓ ตั้งค่าแล้ว' : '— ยังไม่ได้ตั้งค่า' %></span>
        </div>
        <% }) %>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
